<!doctype html>
<html lang="ar">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#090b17">
<meta name="application-name" content="EMBERFALL: RIFT ARENA v2.18.0">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'sha256-wXvNh2orXajPcNiI6JWQGbpbBcZqo/xrr+clvrGYwCQ=' 'sha256-lp634MDFPlQ/uaC9gEb0bhs/ok92y15jJzZ9AqeJDTE='; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; media-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
<title>EMBERFALL: Rift Arena — v2.18.0 · Boss Phase Transition Fix</title>
<style>
:root{--bg:#090b17;--panel:rgba(14,18,36,.88);--line:rgba(169,190,255,.2);--cyan:#72f6ff;--gold:#ffd27c;--pink:#ff5c97;--white:#f3f6ff}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--white);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}
body{background:radial-gradient(ellipse at 50% 35%,#1b2143 0%,#0b1021 48%,#050710 100%)}
#gameWrap{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(100vw,1600px);height:min(100vh,1000px);display:grid;place-items:center;overflow:hidden}
canvas{display:block;width:100%;height:100%;max-width:1600px;max-height:1000px;object-fit:contain;image-rendering:auto;touch-action:none}
.hud{position:absolute;inset:0;pointer-events:none;padding:clamp(10px,2vw,23px);display:flex;flex-direction:column;justify-content:space-between}
.toprow{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.brand{font-weight:950;letter-spacing:.13em;font-size:clamp(13px,2vw,21px);line-height:1.1;text-shadow:0 0 22px rgba(114,246,255,.32)}.brand span{color:var(--cyan)}
.mini{font-size:10px;letter-spacing:.2em;color:#929dbf;margin-top:5px}
.stats{display:flex;gap:7px;justify-content:flex-end;flex-wrap:wrap}.stat{background:rgba(9,13,28,.7);border:1px solid var(--line);border-radius:12px;padding:7px 11px;min-width:69px;backdrop-filter:blur(9px)}.stat small{display:block;font-size:9px;color:#98a7cc;letter-spacing:.13em}.stat b{font-size:15px;font-variant-numeric:tabular-nums}
.bars{width:min(320px,40vw);margin-top:10px;display:grid;gap:6px}.barline{display:flex;align-items:center;gap:8px;font-size:10px;color:#b8c4e8;letter-spacing:.06em}.barline b,.stat b{direction:ltr;unicode-bidi:isolate}.bar{height:7px;border-radius:12px;background:#222a45;flex:1;overflow:hidden;border:1px solid rgba(255,255,255,.06)}.fill{height:100%;width:100%;transition:width .12s linear;border-radius:12px}.hpfill{background:linear-gradient(90deg,#ff4777,#ff8b9d);box-shadow:0 0 13px #ff477755}.xpfill{background:linear-gradient(90deg,#58dcff,#c2fbff);box-shadow:0 0 13px #72f6ff66}.resonancefill{background:linear-gradient(90deg,#b18aff,#72f6ff,#f6e4ff);box-shadow:0 0 13px #a58bff88}.special.resonance-ready{border-color:#b7faff;background:radial-gradient(circle at 30% 20%,#72f6ff99,#2d2b60ef 70%);box-shadow:0 0 24px #72f6ff77,inset 0 0 18px #b7faff33;animation:echoReadyPulse 1.1s ease-in-out infinite alternate}@keyframes echoReadyPulse{from{filter:brightness(1)}to{filter:brightness(1.35)}}@media(prefers-reduced-motion:reduce){.special.resonance-ready{animation:none}}
.bottomrow{display:flex;justify-content:space-between;align-items:flex-end;gap:10px}.hint{font-size:11px;color:#9aa8ce;line-height:1.7;text-shadow:0 2px 10px #000}.hint strong{color:#d9e6ff}.objective{align-self:center;margin-bottom:8px;background:rgba(7,10,23,.64);border:1px solid rgba(114,246,255,.16);padding:7px 14px;border-radius:99px;font-size:10px;letter-spacing:.12em;color:#b9c8ec;backdrop-filter:blur(8px)}
.iconbtn{pointer-events:auto;color:#eaf7ff;background:rgba(12,17,36,.78);border:1px solid var(--line);border-radius:13px;padding:10px 12px;font-size:12px;cursor:pointer;backdrop-filter:blur(8px)}.iconbtn:active,.action:active{transform:scale(.96)}
.overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:18px;background:radial-gradient(ellipse at center,rgba(9,12,27,.42),rgba(4,5,13,.83));backdrop-filter:blur(5px);z-index:5}
.panel{width:min(640px,100%);max-height:95%;overflow:auto;background:linear-gradient(150deg,rgba(24,30,59,.96),rgba(9,12,27,.96));border:1px solid rgba(139,173,255,.28);border-radius:24px;padding:clamp(20px,4vw,36px);box-shadow:0 25px 100px #0008,0 0 70px rgba(72,120,255,.08);text-align:center}
.eyebrow{font-size:10px;letter-spacing:.32em;color:var(--cyan);font-weight:800}.title{font-size:clamp(32px,7vw,59px);line-height:.98;letter-spacing:-.045em;font-weight:1000;margin:14px 0 12px;text-shadow:0 0 35px #76edff2c}.title em{font-style:normal;color:var(--cyan)}.subtitle{margin:0 auto;max-width:480px;color:#aebbe0;line-height:1.8;font-size:14px}
.divider{height:1px;background:linear-gradient(90deg,transparent,#93aaff55,transparent);margin:23px 0}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:20px 0}.feature{border:1px solid rgba(141,166,255,.15);border-radius:13px;padding:12px 7px;background:rgba(255,255,255,.025)}.feature b{display:block;font-size:12px;margin-bottom:4px}.feature span{font-size:10px;color:#91a0c8}
.primary{border:0;border-radius:14px;background:linear-gradient(105deg,#74f5ff,#9da7ff);color:#07101f;padding:14px 26px;font-weight:950;font-size:15px;letter-spacing:.05em;box-shadow:0 8px 35px #65edff26;cursor:pointer;min-width:180px}.primary:active{transform:translateY(1px) scale(.985)}.subbutton{background:transparent;border:1px solid #7e91cb55;color:#bfcae9;border-radius:12px;padding:11px 17px;cursor:pointer;font-size:12px}

.loadout-title{font-size:10px;letter-spacing:.22em;color:#9eafd9;font-weight:850;margin:18px 0 9px}.weapon-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:0 0 11px;text-align:left}.weapon-card{display:grid;grid-template-columns:38px minmax(0,1fr);gap:9px;align-items:center;text-align:left;border:1px solid rgba(141,166,255,.19);border-radius:13px;padding:10px;background:rgba(255,255,255,.025);color:#eef4ff;cursor:pointer;min-width:0;transition:border-color .15s,background .15s,transform .15s}.weapon-card:hover{border-color:#72f6ff88}.weapon-card.selected{border-color:var(--weapon,#72f6ff);background:linear-gradient(120deg,color-mix(in srgb,var(--weapon,#72f6ff) 13%,transparent),rgba(255,255,255,.025));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--weapon,#72f6ff) 32%,transparent),0 0 17px color-mix(in srgb,var(--weapon,#72f6ff) 10%,transparent)}.weapon-glyph{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:color-mix(in srgb,var(--weapon,#72f6ff) 15%,transparent);color:var(--weapon,#72f6ff);font-size:22px}.weapon-info{min-width:0}.weapon-info b{display:block;font-size:11px;letter-spacing:.035em;white-space:nowrap}.weapon-info small{display:block;color:#99a9d0;font-size:9px;line-height:1.4;margin-top:3px}.weapon-info em{display:block;color:var(--weapon,#72f6ff);font-size:8px;font-style:normal;letter-spacing:.09em;margin-top:4px}.weapon-summary{font-size:9px;letter-spacing:.1em;color:#aebde0;margin:0 0 10px;min-height:13px}.echo-intro{font-size:9px;line-height:1.6;letter-spacing:.06em;color:#8edce6;margin:-3px auto 12px;max-width:450px;padding:7px 10px;border:1px solid #72f6ff22;border-radius:9px;background:#72f6ff08}.trial-shell{margin:0 auto 16px;max-width:620px;text-align:left}.trial-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:8px}.trial-heading b{font-size:10px;letter-spacing:.2em;color:var(--cyan)}.trial-heading span{font-size:10px;color:#98a9d1}.trial-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:7px}.trial-card{min-width:0;min-height:112px;border:1px solid rgba(141,166,255,.2);border-radius:13px;padding:9px 8px;background:linear-gradient(145deg,#18203b,#0d1325);color:#eaf2ff;text-align:left;cursor:pointer;display:flex;flex-direction:column;align-items:flex-start;gap:4px;transition:transform .12s,border-color .12s,background .12s}.trial-card:active{transform:scale(.98)}.trial-card.selected{border-color:var(--cyan);background:linear-gradient(145deg,#20334a,#11192d);box-shadow:inset 0 0 0 1px #72f6ff33,0 0 18px #72f6ff15}.trial-mark{color:var(--cyan);font-size:18px;line-height:1}.trial-card b{font-size:10px;letter-spacing:.05em}.trial-card small{font-size:9px;line-height:1.45;color:#a8b6d8;flex:1}.trial-card em{font-size:8px;font-style:normal;letter-spacing:.09em;color:#ffd27c}.trial-summary{font-size:9px;letter-spacing:.08em;color:#aabce5;text-align:center;margin-top:9px;min-height:13px}.run-results{grid-template-columns:repeat(4,minmax(0,1fr))}.run-results .feature{min-width:0}.run-results .feature span{font-size:9px}.weaponhud{font-size:8px;letter-spacing:.13em;color:#b6d7ff;margin-top:6px}.trialhud{color:#ffd27c}
.upgrades{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:24px 0 8px}.upgrade{border:1px solid rgba(125,170,255,.25);background:linear-gradient(160deg,#202b4b,#11182d);border-radius:16px;padding:16px 12px;color:#eef4ff;text-align:center;cursor:pointer;min-height:150px}.upgrade:hover{border-color:var(--cyan);box-shadow:0 0 25px #72f6ff1c}.upgrade .glyph{font-size:27px;display:block;margin-bottom:12px}.upgrade b{font-size:13px;display:block}.upgrade p{font-size:11px;color:#a4b4d9;line-height:1.6;margin:8px 0 0}
.relic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:22px 0 8px}
.relic-card{position:relative;min-height:178px;border:1px solid rgba(114,246,255,.3);background:radial-gradient(circle at 50% 0%,rgba(114,246,255,.12),transparent 62%),linear-gradient(160deg,#202b4b,#11182d);border-radius:17px;padding:17px 12px;color:#eef4ff;text-align:center;cursor:pointer;touch-action:manipulation;min-width:0;transition:transform .14s,border-color .14s,box-shadow .14s}
.relic-card:hover,.relic-card:focus-visible{border-color:var(--gold);box-shadow:0 0 27px #ffd27c24;transform:translateY(-2px);outline:none}
.relic-card .glyph{display:block;font-size:31px;margin:0 0 12px;text-shadow:0 0 18px #72f6ff55}
.relic-card b{display:block;font-size:12px;letter-spacing:.035em}
.relic-card p{font-size:11px;color:#b1bfdf;line-height:1.55;margin:8px 0 0}
.relic-card small{display:block;margin-top:12px;color:#ffd27c;font-weight:850;font-size:9px;letter-spacing:.15em}
.relic-rule{font-size:10px;line-height:1.65;color:#99a9d2;margin-top:12px}
.comboHud{border-color:rgba(255,135,95,.48);color:#ffd27c;text-shadow:0 0 14px #ff875f44;font-weight:900;letter-spacing:.08em;animation:comboPulse .45s ease-out}@keyframes comboPulse{0%{transform:scale(1.08);filter:brightness(1.5)}100%{transform:scale(1);filter:brightness(1)}}
@media(max-width:620px){.relic-grid{grid-template-columns:1fr;gap:8px}.relic-card{min-height:0;display:grid;grid-template-columns:46px 1fr;grid-template-rows:auto auto;gap:0 10px;text-align:start;padding:12px}.relic-card .glyph{grid-row:1/3;align-self:center;margin:0;font-size:28px}.relic-card b{align-self:end}.relic-card p{margin-top:4px}.relic-card small{grid-column:2;margin-top:6px}}

.store-panel{width:min(790px,100%);text-align:left;padding:clamp(16px,3vw,28px)}.store-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:10px 0 5px}.store-heading .title{margin:4px 0;font-size:clamp(29px,5vw,43px)}.wallet-pill{border:1px solid #ffd27c55;border-radius:14px;padding:10px 14px;background:#ffd27c0b;color:#ffe2a6;font-size:13px;font-weight:900;white-space:nowrap}.store-intro{font-size:12px;line-height:1.7;color:#aebbe0;margin:5px 0 16px}.store-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.store-card{min-width:0;border:1px solid color-mix(in srgb,var(--store-glow,#72f6ff) 35%,transparent);border-radius:16px;padding:14px;background:linear-gradient(145deg,color-mix(in srgb,var(--store-glow,#72f6ff) 7%,#19213b),#0b1021);display:flex;flex-direction:column;gap:9px}.store-card-head{display:flex;align-items:center;gap:10px;min-width:0}.store-icon{display:grid;place-items:center;flex:none;width:40px;height:40px;border-radius:12px;background:color-mix(in srgb,var(--store-glow,#72f6ff) 13%,transparent);color:var(--store-glow,#72f6ff);font-size:22px}.store-name{min-width:0}.store-name b{display:block;font-size:12px;line-height:1.4}.store-name small{display:block;font-size:9px;letter-spacing:.1em;color:var(--store-glow,#72f6ff);margin-top:3px}.store-desc{color:#aab8da;font-size:11px;line-height:1.65;min-height:36px;margin:0}.store-meter{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:9px;color:#95a5cf;letter-spacing:.06em}.store-rank-dots{display:flex;gap:4px}.store-rank-dots i{display:block;width:13px;height:4px;border-radius:4px;background:#26314f}.store-rank-dots i.on{background:var(--store-glow,#72f6ff);box-shadow:0 0 8px color-mix(in srgb,var(--store-glow,#72f6ff) 55%,transparent)}.store-buy{width:100%;border:1px solid color-mix(in srgb,var(--store-glow,#72f6ff) 45%,transparent);border-radius:10px;background:color-mix(in srgb,var(--store-glow,#72f6ff) 13%,#111a31);color:#eef5ff;padding:10px 8px;font-size:10px;font-weight:900;letter-spacing:.06em;cursor:pointer}.store-buy:not(:disabled):hover{background:color-mix(in srgb,var(--store-glow,#72f6ff) 23%,#111a31)}.store-buy:disabled{opacity:.48;cursor:default}.store-notice{min-height:20px;margin-top:11px;font-size:11px;line-height:1.6;color:#ffe0a0;text-align:center}.store-foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-top:11px}.store-foot small{color:#7788b4;font-size:9px;line-height:1.6}.store-buttons{display:flex;gap:8px;flex-wrap:wrap}
@media(pointer:coarse),(max-width:760px){.store-panel{padding:15px;max-height:92%}.store-grid{grid-template-columns:1fr;gap:8px}.store-card{padding:11px;gap:7px}.store-desc{min-height:0}.store-icon{width:34px;height:34px;font-size:19px}.store-heading .title{font-size:29px}.wallet-pill{padding:8px 10px;font-size:11px}.store-intro{font-size:11px;margin-bottom:10px}.store-foot{align-items:flex-start}.store-foot small{max-width:100%}}



#settingsOverlay{z-index:8}.settings-panel{width:min(700px,100%);max-height:94%;text-align:left;padding:clamp(17px,3vw,30px)}
.settings-panel .title{font-size:clamp(29px,5vw,43px);margin:7px 0 9px}.settings-intro{font-size:12px;color:#aebbe0;line-height:1.7;margin:0 0 18px}
.save-backup-section{border:1px solid rgba(114,246,255,.16);border-radius:13px;padding:12px;background:rgba(9,15,31,.5)}.backup-help,.backup-notice{font-size:10px;line-height:1.6;color:#a6b5d8;margin:6px 0 10px}.backup-actions{display:flex;gap:8px;flex-wrap:wrap}.backup-actions button{flex:1;min-width:135px}.backup-notice{margin:9px 0 0;color:#8fe5e9;overflow-wrap:anywhere}
.settings-section{margin:15px 0}.settings-label{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#dce7ff;font-size:12px;font-weight:850;margin-bottom:8px}.settings-label small{font-size:9px;color:#8f9fc7;font-weight:600;letter-spacing:.08em}
.quality-options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.quality-btn{border:1px solid #8da6ff33;border-radius:12px;background:#10172d;color:#eaf1ff;padding:11px 8px;cursor:pointer;min-width:0;text-align:left}.quality-btn b{display:block;font-size:11px}.quality-btn small{display:block;font-size:9px;line-height:1.5;color:#93a5ce;margin-top:4px}.quality-btn.selected{border-color:#72f6ff99;background:linear-gradient(140deg,#72f6ff17,#a58bff12);box-shadow:inset 0 0 0 1px #72f6ff35}.settings-switch{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid #8094c329;background:#0d1428;border-radius:12px;padding:12px;margin:8px 0}.settings-switch strong{display:block;font-size:11px}.settings-switch small{display:block;color:#94a5cc;font-size:9px;line-height:1.5;margin-top:4px}.switch-btn{flex:none;min-width:74px;border:1px solid #72f6ff55;background:#72f6ff12;color:#bdfbff;border-radius:10px;padding:9px 10px;font-size:10px;font-weight:900;cursor:pointer}.switch-btn.off{border-color:#8190b444;background:#8f9ab010;color:#9aa8cc}.volume-row{display:grid;grid-template-columns:minmax(0,1fr) 54px;gap:12px;align-items:center}.volume-row input{width:100%;accent-color:#72f6ff}.volume-value{text-align:right;font-size:12px;font-weight:950;color:#c8fbff;font-variant-numeric:tabular-nums}.settings-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-top:17px}.settings-footer small{font-size:9px;line-height:1.6;color:#7e8eb5;max-width:360px}
@media(pointer:coarse),(max-width:760px){.settings-panel{padding:15px;max-height:92%}.settings-intro{font-size:11px;margin-bottom:12px}.settings-section{margin:11px 0}.quality-options{gap:6px}.quality-btn{padding:9px 7px}.quality-btn b{font-size:10px}.quality-btn small{font-size:8px}.settings-switch{padding:10px}.settings-panel .title{font-size:29px}}

.legacy-panel{width:min(920px,100%);max-height:94%;text-align:left;padding:clamp(15px,3vw,28px)}
.legacy-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:8px 0 12px}.legacy-top .title{font-size:clamp(29px,5vw,43px);margin:4px 0}.legacy-wallet{border:1px solid #ffd27c55;background:#ffd27c0b;color:#ffe2a6;padding:9px 12px;border-radius:12px;font-size:12px;font-weight:900;white-space:nowrap}
.legacy-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:13px 0 19px}.legacy-summary .feature{padding:10px 7px}.legacy-summary .feature b{font-size:16px}.legacy-section-title{font-size:11px;color:#9eafd9;letter-spacing:.18em;font-weight:950;margin:17px 0 9px}.legacy-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.daily-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.legacy-card{min-width:0;border:1px solid #8094c333;background:linear-gradient(145deg,#18213b,#0b1021);border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:8px}.legacy-card.done{border-color:#ffd27c66}.legacy-card-head{display:flex;align-items:center;gap:9px}.legacy-glyph{width:34px;height:34px;flex:none;border-radius:10px;display:grid;place-items:center;background:#72f6ff13;color:#72f6ff;font-size:18px}.legacy-card-title{font-size:11px;line-height:1.4;font-weight:950;color:#eff4ff}.legacy-card-tag{font-size:8px;letter-spacing:.13em;color:#91a4cf;margin-top:3px}.legacy-desc{font-size:10px;line-height:1.6;color:#a8b8dc;min-height:31px;margin:0}.legacy-meter{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:9px;color:#91a4cf;letter-spacing:.04em}.legacy-track{height:5px;border-radius:8px;background:#242e4c;overflow:hidden}.legacy-track span{display:block;height:100%;border-radius:8px;background:linear-gradient(90deg,#72f6ff,#a58bff)}.legacy-card.done .legacy-track span{background:linear-gradient(90deg,#ffd27c,#ffad67)}.legacy-action{width:100%;border:1px solid #72f6ff44;background:#72f6ff12;color:#eaf7ff;border-radius:10px;padding:9px 8px;font-weight:900;font-size:9px;letter-spacing:.08em;cursor:pointer}.legacy-action:disabled{opacity:.45;cursor:default}.legacy-action.claim{border-color:#ffd27c88;background:#ffd27c16;color:#ffe1a2}.sigil-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.sigil-choice{display:flex;align-items:center;gap:9px;min-width:0;text-align:left;color:#eaf1ff;background:#0b1021;border:1px solid color-mix(in srgb,var(--sigil,#72f6ff) 35%,transparent);border-radius:12px;padding:10px;cursor:pointer}.sigil-choice.selected{box-shadow:inset 0 0 0 1px var(--sigil,#72f6ff);background:color-mix(in srgb,var(--sigil,#72f6ff) 9%,#0b1021)}.sigil-choice:disabled{opacity:.46;cursor:not-allowed}.sigil-icon{display:grid;place-items:center;flex:none;width:30px;height:30px;border-radius:9px;background:color-mix(in srgb,var(--sigil,#72f6ff) 14%,transparent);color:var(--sigil,#72f6ff);font-size:17px}.sigil-choice b{display:block;font-size:10px}.sigil-choice small{display:block;font-size:8px;line-height:1.4;color:#98a9d0;margin-top:3px}.legacy-notice{min-height:17px;text-align:center;color:#ffe0a0;font-size:10px;line-height:1.6;margin:12px 0}.legacy-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px}.legacy-bottom small{font-size:9px;line-height:1.5;color:#7f8fb7}
@media(pointer:coarse),(max-width:760px){.legacy-panel{padding:14px;max-height:93%}.legacy-summary{grid-template-columns:repeat(2,minmax(0,1fr));margin:10px 0 14px}.legacy-grid,.daily-grid{grid-template-columns:1fr;gap:7px}.legacy-card{padding:10px;gap:6px}.legacy-desc{min-height:0}.sigil-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.sigil-choice{padding:8px;gap:7px}.sigil-choice b{font-size:9px}.legacy-section-title{margin:13px 0 7px}.legacy-top .title{font-size:28px}.legacy-wallet{font-size:10px;padding:8px 10px}}

#mobileControls{position:absolute;inset:auto 0 0 0;height:43%;pointer-events:none;display:none;z-index:3}.stickZone{position:absolute;left:14px;bottom:max(22px,env(safe-area-inset-bottom));width:132px;height:132px;pointer-events:auto;touch-action:none}.stickBase,.stickNub{position:absolute;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%)}.stickBase{width:100%;height:100%;border:1px solid #9bc5ff3d;background:radial-gradient(circle,#b2d5ff16,#5c8eff0b 70%);box-shadow:inset 0 0 25px #6f9bff12}.stickNub{width:54px;height:54px;border:1px solid #a9f6ff82;background:linear-gradient(145deg,#7cf5ff77,#7185ff55);box-shadow:0 0 22px #6ef3ff22}
.actions{position:absolute;right:16px;bottom:max(22px,env(safe-area-inset-bottom));height:150px;width:194px;pointer-events:none}.action{position:absolute;display:grid;place-items:center;border-radius:50%;pointer-events:auto;touch-action:none;color:#eaf8ff;font-weight:850;border:1px solid #a5dfff69;background:radial-gradient(circle at 30% 20%,#5978b777,#151d37ef 70%);box-shadow:0 0 24px #63baff12,inset 0 0 17px #83deff10;font-size:11px;line-height:1.1}.action span{display:block;font-size:21px;margin-bottom:2px}.attack{width:82px;height:82px;right:0;bottom:0;border-color:#72f6ffb0}.dash{width:57px;height:57px;left:4px;bottom:5px}.special{width:61px;height:61px;left:34px;top:0;border-color:#d58aff99}.action.void{width:61px;height:61px;right:0;top:0;border-color:#e8a2ffcc;background:radial-gradient(circle at 30% 20%,#a65cff88,#1e1639ef 72%);box-shadow:0 0 23px #b46aff20,inset 0 0 17px #d3a0ff13;font-size:8px}.action.void span{font-size:20px;margin-bottom:0}.core-stat{border-color:#d58aff55;box-shadow:inset 0 0 12px #b880ff10}.core-stat b{color:#d8b0ff}.cool{opacity:.48;filter:saturate(.5)}.cool small{font-size:9px}
@media(pointer:coarse),(max-width:760px){.trial-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.trial-card{min-height:94px}.trial-heading{align-items:flex-start;flex-direction:column;gap:4px}.run-results{grid-template-columns:repeat(2,minmax(0,1fr))}#mobileControls{display:block}.hint{display:none}.weapon-grid{gap:6px}.weapon-card{grid-template-columns:30px minmax(0,1fr);gap:7px;padding:8px}.weapon-glyph{width:30px;height:32px;font-size:18px}.weapon-info b{font-size:10px}.weapon-info small{font-size:8px}.weapon-info em{font-size:7px}.loadout-title{margin-top:14px}.bars{width:min(250px,48vw)}.stat{min-width:54px;padding:6px 8px}.stat b{font-size:13px}.stat small{font-size:8px}.objective{font-size:9px;padding:6px 10px}.brand{font-size:14px}.mini{font-size:8px}.upgrades{grid-template-columns:1fr;gap:8px}.upgrade{min-height:0;display:grid;grid-template-columns:40px 1fr;text-align:left;align-items:center;padding:12px}.upgrade .glyph{grid-row:span 2;margin:0;font-size:25px}.upgrade p{margin:4px 0 0}.panel{border-radius:19px}.features{gap:5px}.feature{padding:10px 4px}.feature b{font-size:11px}.feature span{font-size:9px}}
@media(orientation:portrait) and (max-width:760px){canvas{width:100%;height:100%;object-fit:cover}.hud{padding:12px}.toprow{gap:6px}.toprow>div:first-child{width:calc(50% - 3px);min-width:0}.toprow>.stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-content:start;width:calc(50% - 3px);max-width:calc(50% - 3px);gap:4px}.hud .mini{font-size:7px;letter-spacing:.08em}.bars{width:100%;max-width:100%;margin-top:7px}.stat{min-width:0;width:100%;flex:none;padding:5px 6px}.stat b{font-size:11px}.stat small{font-size:7px;letter-spacing:.05em}.iconbtn{width:100%;padding:8px 5px;min-width:0}.weaponhud{font-size:7px;letter-spacing:.1em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.objective{position:absolute;top:104px;left:50%;transform:translateX(-50%);white-space:nowrap}}

.realm-panel{width:min(880px,100%)}
.realm-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:20px 0;text-align:left}
.realm-card{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:10px;min-width:0;min-height:230px;padding:16px 14px;border-radius:16px;border:1px solid var(--realm-line,rgba(141,166,255,.2));background:linear-gradient(155deg,var(--realm-tint,rgba(255,255,255,.06)),rgba(8,12,26,.8));color:#f2f5ff;text-align:left;cursor:pointer;overflow:hidden;transition:transform .15s,border-color .15s,filter .15s}
.realm-card:before{content:"";position:absolute;width:160px;height:160px;border-radius:50%;right:-66px;top:-75px;background:var(--realm-glow,#72f6ff);opacity:.13;filter:blur(10px)}
.realm-card:hover:not(:disabled){transform:translateY(-2px);border-color:var(--realm-glow,#72f6ff)}
.realm-card.selected{border-color:var(--realm-glow,#72f6ff);box-shadow:inset 0 0 0 1px var(--realm-glow,#72f6ff),0 0 20px color-mix(in srgb,var(--realm-glow,#72f6ff) 12%,transparent)}
.realm-card:disabled{cursor:not-allowed;filter:saturate(.45);opacity:.6}
.realm-symbol{display:grid;place-items:center;width:50px;height:50px;border-radius:14px;background:color-mix(in srgb,var(--realm-glow,#72f6ff) 16%,transparent);color:var(--realm-glow,#72f6ff);font-size:27px;border:1px solid color-mix(in srgb,var(--realm-glow,#72f6ff) 33%,transparent)}
.realm-name{font-size:13px;font-weight:950;letter-spacing:.045em;line-height:1.35;position:relative}.realm-lore{font-size:11px;line-height:1.65;color:#aebde0;position:relative}.realm-mechanic{font-size:10px;line-height:1.55;color:#d6e2ff;border-left:2px solid var(--realm-glow,#72f6ff);padding-left:8px;position:relative}.realm-gate{margin-top:auto;font-size:9px;font-weight:850;letter-spacing:.1em;color:var(--realm-glow,#72f6ff);position:relative}.realm-status{font-size:9px;color:#8595bd;letter-spacing:.08em;position:relative}
.realm-footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px}.realm-selected-note{font-size:10px;color:#aab9dc;line-height:1.6;text-align:left;max-width:360px}
@media(pointer:coarse),(max-width:760px){.realm-grid{grid-template-columns:1fr;gap:8px;margin:13px 0}.realm-card{min-height:0;display:grid;grid-template-columns:42px minmax(0,1fr);align-items:start;column-gap:10px;padding:11px}.realm-symbol{grid-row:1 / span 4;width:40px;height:40px;font-size:22px;border-radius:11px}.realm-name,.realm-lore,.realm-mechanic,.realm-gate{grid-column:2}.realm-name{font-size:11px}.realm-lore{font-size:10px}.realm-mechanic{font-size:9px}.realm-gate{margin-top:0;white-space:normal;line-height:1.5}.realm-status{font-size:8px}.realm-panel{padding:15px}}

@media(max-height:620px){.panel{padding:16px 22px}.divider{margin:13px 0}.features{margin:12px 0}.title{margin:8px 0}.subtitle{font-size:12px}.upgrades{margin:13px 0}.upgrade{min-height:125px;padding:12px}}

.language-picker{display:flex;align-items:center;justify-content:center;gap:7px;flex-wrap:wrap;margin:0 auto 14px;padding:8px 10px;border:1px solid #283654;border-radius:12px;background:rgba(9,14,30,.72);width:fit-content;max-width:100%}.language-caption{font-size:9px;letter-spacing:.12em;color:#91a0c3;margin-right:5px}.language-picker button{min-width:40px;border:1px solid #334466;border-radius:8px;background:#111b32;color:#d9e5ff;padding:7px 10px;font-size:11px;font-weight:700;font-family:inherit;cursor:pointer}.language-picker button.selected,.language-picker button[aria-pressed="true"]{border-color:#72f6ff;color:#72f6ff;background:#142b3d}.settings-language-picker{margin:8px 0 0;width:max-content;max-width:100%;gap:6px;padding:6px 8px}.settings-language-picker button{min-width:48px}html[dir="rtl"] .language-caption{letter-spacing:0;margin-right:0;margin-left:5px}html[dir="rtl"] .panel{text-align:right}html[dir="rtl"] .settings-label,html[dir="rtl"] .settings-switch,html[dir="rtl"] .settings-footer,html[dir="rtl"] .realm-footer,html[dir="rtl"] .store-heading,html[dir="rtl"] .store-buttons,html[dir="rtl"] .legacy-top,html[dir="rtl"] .legacy-bottom{direction:rtl}html[dir="rtl"] .bottomrow .hint{text-align:right!important}

/* v1.0.8: streamlined entry screen; weapon selection no longer blocks starting */
#startOverlay .loadout-title,#startOverlay #weaponGrid,#startOverlay #weaponSummary,#startOverlay #echoIntro{display:none!important}
#startOverlay .language-picker{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;margin:0 auto 18px}
#startOverlay .language-caption{display:block;width:100%;font-size:12px;font-weight:900;letter-spacing:.08em;color:#c5d6ff;margin-bottom:2px}
#startOverlay #startBtn{margin-top:14px;min-height:54px;font-size:15px}
#startOverlay .panel{max-height:94%;overscroll-behavior:contain}


/* v1.1.1: resilient mobile interaction and scrollable overlays */
button,[role="button"],input,select,a[href]{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
button:focus-visible,[role="button"]:focus-visible,input:focus-visible,select:focus-visible,a[href]:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
#startOverlay{z-index:20;pointer-events:auto}
#startOverlay button{position:relative;pointer-events:auto}
@media(pointer:coarse){
  #startOverlay .language-picker button{min-width:44px;min-height:42px}
  .overlay button,.subbutton,.primary,.iconbtn{touch-action:manipulation}
  #mobileControls .actions .action{touch-action:none;user-select:none;-webkit-user-select:none}
}


/* v1.1.1 interaction hardening */
html,body{overscroll-behavior:none}
.overlay{overflow-y:auto;-webkit-overflow-scrolling:touch;align-items:flex-start}
.overlay>.panel{margin:auto;flex-shrink:0;max-height:none;overflow:visible}
#startOverlay{padding:clamp(10px,3vh,24px) 12px;overflow-y:auto;align-items:center}
#startOverlay>.panel{width:min(100%,720px);max-height:none;overflow:visible;padding:clamp(16px,4vw,30px)}
#startOverlay .language-picker button,#startOverlay .primary,#startOverlay .subbutton{min-height:46px;position:relative;z-index:2;pointer-events:auto}
button:disabled{touch-action:manipulation}
@media(max-height:700px){#startOverlay{align-items:flex-start}#startOverlay>.panel{margin:auto} .overlay{align-items:flex-start}}


.doctrine-shell{margin:14px auto 16px;max-width:620px;text-align:left;border:1px solid rgba(194,160,255,.22);border-radius:15px;padding:11px;background:linear-gradient(145deg,rgba(30,29,62,.7),rgba(10,15,30,.52))}
.doctrine-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:8px}
.doctrine-heading b{font-size:10px;letter-spacing:.18em;color:#c2a0ff}
.doctrine-heading span{font-size:9px;line-height:1.4;color:#9baad0}
.doctrine-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.doctrine-card{min-width:0;min-height:126px;padding:10px 9px;border-radius:12px;border:1px solid rgba(141,166,255,.22);background:linear-gradient(150deg,#1d2542,#0e1428);color:#eef4ff;text-align:left;display:flex;flex-direction:column;align-items:flex-start;gap:5px;cursor:pointer;touch-action:manipulation;transition:border-color .12s,transform .12s,background .12s}
.doctrine-card:active{transform:scale(.98)}
.doctrine-card.selected{border-color:var(--doctrine,#72f6ff);background:linear-gradient(145deg,color-mix(in srgb,var(--doctrine,#72f6ff) 17%,#18203b),#0e1428);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--doctrine,#72f6ff) 30%,transparent),0 0 16px color-mix(in srgb,var(--doctrine,#72f6ff) 12%,transparent)}
.doctrine-mark{width:29px;height:29px;border-radius:9px;display:grid;place-items:center;font-size:18px;color:var(--doctrine,#72f6ff);background:color-mix(in srgb,var(--doctrine,#72f6ff) 15%,transparent)}
.doctrine-card b{font-size:9px;letter-spacing:.05em;line-height:1.25}.doctrine-card small{font-size:9px;line-height:1.45;color:#a7b5d8;flex:1}.doctrine-card em{font-size:8px;line-height:1.3;font-style:normal;letter-spacing:.06em;color:var(--doctrine,#72f6ff)}
.doctrine-summary{font-size:9px;line-height:1.5;letter-spacing:.04em;color:#c5d3f3;text-align:center;margin-top:8px;min-height:14px}
@media(pointer:coarse),(max-width:760px){.doctrine-shell{padding:8px;margin:10px auto 13px}.doctrine-grid{grid-template-columns:1fr;gap:6px}.doctrine-card{min-height:0;display:grid;grid-template-columns:34px minmax(0,1fr);grid-template-rows:auto auto;column-gap:8px;row-gap:3px;padding:9px;text-align:left}.doctrine-mark{grid-row:1/4;align-self:center}.doctrine-card b,.doctrine-card small,.doctrine-card em{grid-column:2}.doctrine-card b{font-size:10px}.doctrine-card small{font-size:9px}.doctrine-card em{font-size:8px}}

.revenue-section{display:none;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0 5px;text-align:left}
.revenue-card{min-width:0;border:1px solid rgba(114,246,255,.22);border-radius:14px;padding:13px;background:linear-gradient(145deg,rgba(114,246,255,.055),rgba(165,139,255,.045));box-shadow:inset 0 0 24px rgba(114,246,255,.025)}
.revenue-card.premium{border-color:rgba(255,210,124,.28);background:linear-gradient(145deg,rgba(255,210,124,.07),rgba(165,139,255,.05))}
.revenue-card-head{display:flex;align-items:center;gap:9px;margin-bottom:7px}.revenue-glyph{flex:none;width:37px;height:37px;display:grid;place-items:center;border-radius:11px;background:#72f6ff12;color:var(--cyan);font-size:22px}.premium .revenue-glyph{background:#ffd27c15;color:var(--gold)}
.revenue-card h3{font-size:12px;letter-spacing:.06em;margin:0;color:#eef4ff}.revenue-card p{font-size:10px;line-height:1.65;color:#a8b7db;margin:7px 0 10px}.revenue-action{width:100%;min-height:40px;border:1px solid #72f6ff59;border-radius:10px;background:rgba(114,246,255,.08);color:#e7fbff;font-weight:850;font-size:10px;letter-spacing:.025em;padding:9px;cursor:pointer;overflow-wrap:anywhere}.premium .revenue-action{border-color:#ffd27c66;background:#ffd27c12;color:#ffedc6}.revenue-action:disabled{opacity:.55;cursor:not-allowed}.revenue-status{display:block;font-size:9px;line-height:1.5;color:#8da3cf;overflow-wrap:anywhere;margin-top:8px}.revenue-actions{display:grid;gap:7px}.revenue-restore{font-size:9px;color:#a8b7db;text-decoration:underline;text-underline-offset:3px;background:none;border:0;padding:4px;cursor:pointer}.revenue-disclaimer{grid-column:1/-1;font-size:9px;line-height:1.55;color:#7f91bb;padding:0 2px;margin:0}
@media(pointer:coarse),(max-width:760px){.revenue-section{grid-template-columns:1fr;gap:8px}.revenue-card{padding:11px}.revenue-card p{margin:5px 0 8px}}


/* Stage 32 UX: progressive disclosure for a less overwhelming first-run menu. */
.settings-fold{width:min(100%,560px);margin:10px auto;border:1px solid rgba(114,246,255,.2);border-radius:13px;background:rgba(11,17,35,.58);overflow:hidden;text-align:left}
.settings-fold>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 14px;min-height:46px;cursor:pointer;touch-action:manipulation;color:#eaf4ff;font-size:11px;letter-spacing:.07em;font-weight:900}
.settings-fold>summary::-webkit-details-marker{display:none}
.settings-fold>summary:after{content:'＋';color:#72f6ff;font-size:17px;line-height:1}
.settings-fold[open]>summary:after{content:'−'}
.settings-fold>summary span{font-size:9px;color:#899bc4;font-weight:700;text-align:right}
.settings-fold[open]>summary{border-bottom:1px solid rgba(114,246,255,.14);background:rgba(114,246,255,.035)}
.settings-fold .trial-shell,.settings-fold .loadout-title,.settings-fold .weapon-grid,.settings-fold .weapon-summary,.settings-fold .doctrine-shell{width:auto;max-width:none;margin-left:10px;margin-right:10px}
.settings-fold .trial-shell{margin-top:10px}
.settings-fold .doctrine-shell{margin-bottom:12px}
.quick-controls{width:min(100%,430px);margin:10px auto 13px;display:flex;flex-wrap:wrap;justify-content:center;gap:6px}
.quick-controls b{width:100%;font-size:9px;letter-spacing:.16em;color:#8fa6d7;text-align:center;margin-bottom:2px}
.quick-controls span{font-size:9px;font-weight:800;letter-spacing:.035em;color:#d9e7ff;padding:7px 9px;border:1px solid rgba(114,246,255,.16);border-radius:999px;background:#101a32}
@media(max-width:520px){.settings-fold>summary{padding:12px 10px}.settings-fold>summary span{max-width:48%;line-height:1.35}.quick-controls span{font-size:8px;padding:7px 8px}}
</style>

<style id="emberfall-touch-input-fix">
/* Touch-input recovery for Android browsers and local HTML viewers. */
#startOverlay, .overlay { pointer-events: auto !important; }
#startOverlay .panel, .overlay .panel { pointer-events: auto !important; position: relative; z-index: 1; }
#startOverlay button, .overlay button, button, [role="button"] { pointer-events: auto; touch-action: manipulation; }
#startOverlay { z-index: 1000 !important; }
#startOverlay .panel { max-height: calc(100% - 12px); overscroll-behavior: contain; }
#startOverlay button:disabled { pointer-events: none; }
</style>
</head>
<body>
<script>
(function(){
  'use strict';
  function makeButtonsResponsive(){
    document.querySelectorAll('#runtimeRecovery button, .overlay button, #startOverlay button, button[data-trial], button[data-doctrine], .weapon-card, .trial-card, .relic-card').forEach(function(el){
      if(el.dataset.efTouchBound==='1') return;
      el.dataset.efTouchBound='1';
      el.style.pointerEvents='auto';
      el.style.touchAction='manipulation';
      // Do not synthesize a second click here: modern Android browsers already
      // dispatch click after pointer/touch. The separate pointer fallback below
      // handles older WebViews only when a click was genuinely missed.
      el.addEventListener('touchend',function(ev){
        if(el.disabled && ev.cancelable) ev.preventDefault();
      },{passive:false});
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',makeButtonsResponsive,{once:true});
  else makeButtonsResponsive();
  document.addEventListener('click',function(ev){
    var btn=ev.target && ev.target.closest ? ev.target.closest('button,[role="button"]') : null;
    if(btn && btn.disabled) { ev.preventDefault(); ev.stopPropagation(); }
  },true);
})();
</script>
<div id="runtimeRecovery" role="alert" aria-live="assertive" style="display:flex;position:fixed;z-index:999999;inset:0;background:#080b17;color:#f3f6ff;padding:24px;overflow:auto;align-items:center;justify-content:center;font-family:system-ui,-apple-system,'Segoe UI',Tahoma,sans-serif">
 <div style="width:min(560px,100%);background:#111831;border:1px solid #52618a;border-radius:18px;padding:24px;box-shadow:0 20px 70px #000b">
  <div style="font-weight:900;letter-spacing:.08em;color:#72f6ff;font-size:20px">EMBERFALL · RECOVERY</div>
  <h2 id="runtimeRecoveryTitle" style="margin:14px 0 8px;font-size:22px">تعذّر تشغيل اللعبة بشكل طبيعي</h2>
  <p id="runtimeRecoveryMessage" style="line-height:1.7;color:#c8d2ed;margin:0 0 16px">جرّب وضع الأداء الآمن. إذا كان شريط العنوان يبدأ بـ content://downloads/، فأنت في عارض التنزيلات وليس داخل ملف اللعبة؛ افتح ملف HTML المستخرج من تطبيق «ملفاتي».</p>
  <button id="bootSafeMode" type="button" style="background:#72f6ff;color:#091020;border:0;border-radius:10px;padding:12px 16px;font-weight:900;font-size:15px;width:100%;margin:4px 0 10px">فتح وضع الأداء الآمن</button>
  <p style="font-size:12px;line-height:1.6;color:#9aa9ce;margin:8px 0 0">لا يحذف هذا الإجراء تقدمك؛ إنه يغيّر إعدادات الرسوم فقط ثم يعيد تحميل الصفحة.</p>
 </div>
</div>
