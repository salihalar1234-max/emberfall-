Object.assign(I18N.ar,{'Piercing thrusts strike through a line of foes; later targets take reduced damage.':'طعنات نافذة تخترق صف الأعداء، ويقل الضرر على الأهداف اللاحقة.',"CHAPTER":"الفصل","CLEARED":"مكتمل","CAMPAIGN CHAPTER":"فصل الحملة","CHAPTER CONTRACT CLEARED":"اكتمل عقد الفصل","BEST CAMPAIGN WAVE":"أفضل موجة في الحملة","CHAPTERS CLEARED":"الفصول المكتملة","CAMPAIGN COMPLETE":"اكتملت الحملة","CAMPAIGN":"الحملة","CHAPTERS":"فصول","CHAPTER CONTRACTS":"عقود الفصول","CAMPAIGN CLEAR":"إتمام الحملة","WAVES":"موجات","AWAKENS":"يستيقظ","RIFT MUTATION":"طفرة الشق","CHAIN":"سلسلة","CHAIN BONUS +2":"مكافأة السلسلة +2","RIFT CHAIN":"سلسلة الشق","RESONANCE":"الرنين","CINDER CATACOMBS":"سراديب الجمر","GLASSWASTE":"أرض الزجاج المحطّم","GLOAMWOOD OUTSKIRTS":"أطراف غابة الشفق","BRAMBLE HEART":"قلب الأشواك","ROOTBOUND SANCTUM":"ملاذ الجذور","FROSTVEIN PASS":"ممر عروق الصقيع","WHITEOUT VAULT":"قبو البياض الجليدي","RIFTWOUND ABYSS":"هاوية جرح الشق","ECLIPSE ENGINE":"محرك الكسوف","THE LAST DAWN":"الفجر الأخير","Defeat 18 Riftborn and survive the first Titan.":"اهزم 18 من أبناء الشق واصمد أمام العملاق الأول.","Defeat 22 Riftborn; keep moving through the emberfall.":"اهزم 22 من أبناء الشق وواصل الحركة وسط تساقط الجمر.","Defeat 26 Riftborn and break the second Titan.":"اهزم 26 من أبناء الشق وحطّم العملاق الثاني.","Defeat 28 Riftborn beneath the living canopy.":"اهزم 28 من أبناء الشق تحت المظلّة الحيّة.","Defeat 30 Riftborn and survive the Thorn Titan.":"اهزم 30 من أبناء الشق واصمد أمام عملاق الشوك.","Defeat 32 Riftborn; escape the bramble blooms.":"اهزم 32 من أبناء الشق واهرب من أزهار الأشواك.","Defeat 34 Riftborn in the endless storm.":"اهزم 34 من أبناء الشق وسط العاصفة اللامتناهية.","Defeat 36 Riftborn and face the Frost Titan.":"اهزم 36 من أبناء الشق وواجه عملاق الصقيع.","Defeat 38 Riftborn while avoiding frostfall.":"اهزم 38 من أبناء الشق وتجنّب تساقط الصقيع.","Defeat 40 Riftborn and survive the empowered Titan.":"اهزم 40 من أبناء الشق واصمد أمام العملاق المعزّز.","Defeat 42 Riftborn; the Rift is destabilizing.":"اهزم 42 من أبناء الشق؛ الشق يفقد استقراره.","Defeat 45 Riftborn and shatter the final Titan.":"اهزم 45 من أبناء الشق وحطّم العملاق الأخير.","BLOOD MOON":"قمر الدم","ENEMIES HIT HARDER":"الأعداء يسببون ضررًا أكبر","IRON HIDE":"الجلد الحديدي","ENEMIES HAVE MORE ARMOR":"الأعداء يملكون درعًا أقوى","HUNTING PACK":"قطيع الصيادين","FASTER PACKS · MORE PRESSURE":"مجموعات أسرع · ضغط أكبر","RIFTSTORM":"عاصفة الشق","RIFT PRESSURE INCREASED":"ازداد ضغط الشق","RIFT SOVEREIGN":"سيّد الشق"});
Object.assign(I18N.tr,{'Piercing thrusts strike through a line of foes; later targets take reduced damage.':'Delici saplamalar düşman sırasını deler; sonraki hedefler daha az hasar alır.',"CHAPTER":"BÖLÜM","CLEARED":"TAMAMLANDI","CAMPAIGN CHAPTER":"SEFER BÖLÜMÜ","CHAPTER CONTRACT CLEARED":"BÖLÜM GÖREVİ TAMAMLANDI","BEST CAMPAIGN WAVE":"EN İYİ SEFER DALGASI","CHAPTERS CLEARED":"TAMAMLANAN BÖLÜMLER","CAMPAIGN COMPLETE":"SEFER TAMAMLANDI","CAMPAIGN":"SEFER","CHAPTERS":"BÖLÜM","CHAPTER CONTRACTS":"BÖLÜM GÖREVLERİ","CAMPAIGN CLEAR":"SEFER TAMAMLANDI","WAVES":"DALGA","AWAKENS":"UYANIYOR","RIFT MUTATION":"YARIK MUTASYONU","CHAIN":"ZİNCİR","CHAIN BONUS +2":"ZİNCİR BONUSU +2","RIFT CHAIN":"YARIK ZİNCİRİ","RESONANCE":"REZONANS","CINDER CATACOMBS":"KOR YERALTI MEZARLIKLARI","GLASSWASTE":"CAM ÇÖLÜ","GLOAMWOOD OUTSKIRTS":"ALACAKARANLIK ORMANI ETEKLERİ","BRAMBLE HEART":"DİKEN KALBİ","ROOTBOUND SANCTUM":"KÖKE BAĞLI TAPINAK","FROSTVEIN PASS":"BUZDAMARI GEÇİDİ","WHITEOUT VAULT":"BEYAZ FIRTINA KASASI","RIFTWOUND ABYSS":"YARIK YARASI UÇURUMU","ECLIPSE ENGINE":"TUTULMA MOTORU","THE LAST DAWN":"SON ŞAFAK","Defeat 18 Riftborn and survive the first Titan.":"18 Yarıkdoğumluyu yen ve ilk Titan’dan sağ çık.","Defeat 22 Riftborn; keep moving through the emberfall.":"22 Yarıkdoğumluyu yen; köz yağmurunda hareket etmeye devam et.","Defeat 26 Riftborn and break the second Titan.":"26 Yarıkdoğumluyu yen ve ikinci Titanı devir.","Defeat 28 Riftborn beneath the living canopy.":"Canlı örtünün altında 28 Yarıkdoğumluyu yen.","Defeat 30 Riftborn and survive the Thorn Titan.":"30 Yarıkdoğumluyu yen ve Diken Titanından sağ çık.","Defeat 32 Riftborn; escape the bramble blooms.":"32 Yarıkdoğumluyu yen; diken çiçeklerinden kaç.","Defeat 34 Riftborn in the endless storm.":"Bitmeyen fırtınada 34 Yarıkdoğumluyu yen.","Defeat 36 Riftborn and face the Frost Titan.":"36 Yarıkdoğumluyu yen ve Buz Titanıyla yüzleş.","Defeat 38 Riftborn while avoiding frostfall.":"Buz yağışından kaçınarak 38 Yarıkdoğumluyu yen.","Defeat 40 Riftborn and survive the empowered Titan.":"40 Yarıkdoğumluyu yen ve güçlendirilmiş Titandan sağ çık.","Defeat 42 Riftborn; the Rift is destabilizing.":"42 Yarıkdoğumluyu yen; Yarık dengesizleşiyor.","Defeat 45 Riftborn and shatter the final Titan.":"45 Yarıkdoğumluyu yen ve son Titanı parçala.","BLOOD MOON":"KANLI AY","ENEMIES HIT HARDER":"Düşmanlar daha sert vurur","IRON HIDE":"DEMİR DERİ","ENEMIES HAVE MORE ARMOR":"Düşmanların zırhı daha güçlü","HUNTING PACK":"AV SÜRÜSÜ","FASTER PACKS · MORE PRESSURE":"Daha hızlı gruplar · daha fazla baskı","RIFTSTORM":"YARIK FIRTINASI","RIFT PRESSURE INCREASED":"Yarık baskısı arttı","RIFT SOVEREIGN":"YARIK HÜKÜMDARI"});
