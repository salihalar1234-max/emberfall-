const WORLDS=[
 {id:'ashen',title:'ASHEN VERGE',symbol:'♨',short:'THE BROKEN BORDER',startWave:1,lore:'The Eclipse first split the sky here. Black glass and fallen embers mark the place where the old light died.',mechanic:'REALM TRIAL · Survive the first five waves and defeat the Rift Titan.',objective:'OBJECTIVE · SURVIVE THE ASHEN VERGE',intro:'ASHEN VERGE · THE ECLIPSE BEGINS',bossName:'RIFT TITAN',bg:['#262443','#17162d','#070812'],grid:'rgba(255,151,103,.105)',border:'rgba(255,151,103,.2)',sigil:'#ff9565',particle:'#ff9b75',bossColor:'#ff447c',hazard:'#ff9565'},
 {id:'gloam',title:'GLOAMWOOD',symbol:'♧',short:'THE LIVING DUSK',startWave:6,lore:'A forest swallowed by twilight. Its roots remember every warrior lost beneath the canopy and lash out at anyone who stands still.',mechanic:'REALM TRIAL · Bramble blooms mark the ground before striking. Keep moving.',objective:'OBJECTIVE · BREAK THE BRAMBLE CURSE',intro:'GLOAMWOOD UNSEALED · WATCH THE ROOTS',bossName:'THORN TITAN',bg:['#18353a','#10242c','#060d15'],grid:'rgba(118,244,170,.105)',border:'rgba(118,244,170,.23)',sigil:'#82f5ac',particle:'#88f8b4',bossColor:'#7ce6a5',hazard:'#8bf49a'},
 {id:'frost',title:'FROSTVEIN CITADEL',symbol:'❄',short:'THE SILENT CROWN',startWave:11,lore:'An abandoned citadel locked in a storm without end. The ice records each step, then punishes anyone who cannot escape its falling shards.',mechanic:'REALM TRIAL · Frostfall zones deal heavy damage and slow you briefly.',objective:'OBJECTIVE · ENDURE THE FROSTFALL',intro:'FROSTVEIN CITADEL · THE COLD IS HUNTING YOU',bossName:'FROST TITAN',bg:['#1a3553','#101f39','#050a16'],grid:'rgba(126,207,255,.12)',border:'rgba(126,207,255,.25)',sigil:'#92deff',particle:'#a8e7ff',bossColor:'#6bbdff',hazard:'#92deff'}
