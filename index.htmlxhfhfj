let currentLanguage=(()=>{try{const v=localStorage.getItem(LANGUAGE_KEY);return ['en','tr','ar'].includes(v)?v:'en'}catch(e){return 'en'}})();
const originalTextNodes=new WeakMap();
function trForLanguage(key,lang=currentLanguage){const dict=I18N[lang]||{};if(typeof key!=='string')return key;if(Object.prototype.hasOwnProperty.call(dict,key))return dict[key];if(key.includes(' · ')){const parts=key.split(' · '),out=[];let i=0,found=false;while(i<parts.length){let matched=false;for(let j=parts.length;j>i;j--){const candidate=parts.slice(i,j).join(' · ');if(Object.prototype.hasOwnProperty.call(dict,candidate)){out.push(dict[candidate]);i=j;matched=true;found=true;break;}}if(!matched){out.push(parts[i]);i++;}}if(found)return out.join(' · ');}let m=key.match(/^CAMPAIGN CHAPTER (\d+)$/);if(m)return (dict['CAMPAIGN CHAPTER']||'CAMPAIGN CHAPTER')+' '+m[1];m=key.match(/^RIFT CHAIN ×(\d+)$/);if(m)return (dict['RIFT CHAIN']||'RIFT CHAIN')+' ×'+m[1];m=key.match(/^WAVE (\d+)$/);if(m)return (dict['WAVE']||'WAVE')+' '+m[1];return key;}function tr(key){return trForLanguage(key,currentLanguage);}
function translateTextNode(node,lang=currentLanguage){if(!node||node.nodeType!==Node.TEXT_NODE||!node.parentElement||node.parentElement.closest('script,style,noscript,template,textarea,code,pre'))return;let state=originalTextNodes.get(node);const current=node.nodeValue;if(!state){state={source:current,lastOutput:null};originalTextNodes.set(node,state)}else if(state.lastOutput!==null&&current!==state.lastOutput){state.source=current;}const original=state.source,key=original.trim();if(!key)return;const translated=trForLanguage(key,lang);const leading=original.match(/^\s*/)?.[0]||'',trailing=original.match(/\s*$/)?.[0]||'',next=leading+translated+trailing;state.lastOutput=next;if(node.nodeValue!==next)node.nodeValue=next;}
function applyLanguage(lang,save=true){if(!['en','tr','ar'].includes(lang))lang='en';currentLanguage=lang;document.documentElement.lang=lang;document.documentElement.dir=lang==='ar'?'rtl':'ltr';document.querySelectorAll('.language-picker [data-lang]').forEach(b=>{const active=b.dataset.lang===lang;b.classList.toggle('selected',active);b.setAttribute('aria-pressed',String(active))});const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);let node;while(node=walker.nextNode())translateTextNode(node,lang);document.querySelectorAll('[aria-label]').forEach(el=>{const current=el.getAttribute('aria-label');if(el.dataset.translatedAria&&current!==el.dataset.translatedAria)el.dataset.originalAria=current;if(!el.dataset.originalAria)el.dataset.originalAria=current;const key=el.dataset.originalAria;const next=I18N[lang]?.[key]||key;el.setAttribute('aria-label',next);el.dataset.translatedAria=next});document.querySelectorAll('[title]').forEach(el=>{const current=el.getAttribute('title');if(el.dataset.translatedTitle&&current!==el.dataset.translatedTitle)el.dataset.originalTitle=current;if(!el.dataset.originalTitle)el.dataset.originalTitle=current;const key=el.dataset.originalTitle;const translated=I18N[lang]?.[key];const next=translated!==undefined?translated:key;el.setAttribute('title',next);el.dataset.translatedTitle=next});document.title=tr('EMBERFALL: Rift Arena — v2.15.0 · Stage 32 · Brute Telegraph & Heavy Slam');const titleMarkup={
 settingsTitle:{en:'GAME <em>SETTINGS</em>',tr:'OYUN <em>AYARLARI</em>',ar:'<em>إعدادات</em> اللعبة'},
 worldTitle:{en:'CHOOSE YOUR <em>REALM</em>',tr:'DİYARINI <em>SEÇ</em>',ar:'اختر <em>عالمك</em>'},
 evolutionTitle:{en:'CHOOSE YOUR <em>EVOLUTION</em>',tr:'<em>GELİŞİMİNİ</em> SEÇ',ar:'اختر <em>تطورك</em>'},
 pausedTitle:{en:'PAU<em>SED</em>',tr:'<em>DURAKLATILDI</em>',ar:'<em>متوقف مؤقتًا</em>'},
 gameOverTitle:{en:'RUN <em>ENDED</em>',tr:'TUR <em>BİTTİ</em>',ar:'<em>انتهت الجولة</em>'},
 storeTitle:{en:'RIFT <em>BAZAAR</em>',tr:'YARIK <em>PAZARI</em>',ar:'متجر <em>الشق</em>'},
 relicTitle:{en:'Claim a Rift <em>Relic</em>',tr:'Bir Yarık <em>Kalıntısı</em> Seç',ar:'اختر <em>أثرًا</em> من الشق'}
 };for(const [id,variants] of Object.entries(titleMarkup)){const el=$(id);if(el)el.innerHTML=variants[lang]}
 if(save){try{localStorage.setItem(LANGUAGE_KEY,lang)}catch(e){}}
 if(typeof renderStore==='function')renderStore();if(typeof renderLegacy==='function')renderLegacy();if(typeof buildWorldMenu==='function')buildWorldMenu();if(typeof updateBestUI==='function')updateBestUI();if(typeof updateWeaponMenu==='function')updateWeaponMenu();if(typeof renderSettings==='function')renderSettings();if(typeof updateTrialUI==='function')updateTrialUI();if(typeof updateHud==='function'&&player)updateHud();if(typeof updateWorldButton==='function')updateWorldButton();if(typeof renderRelicDraft==='function'&&mode==='relic')renderRelicDraft();if(typeof campaignUpdate==='function')campaignUpdate(player&&player.wave||1);if(typeof campaignMenuRefresh==='function')campaignMenuRefresh();if(typeof updateComboHud==='function')updateComboHud();if(player&&$('objective'))$('objective').textContent=WORLDS[activeWorldIndex()].objective;}
document.querySelectorAll('.language-picker [data-lang]').forEach(b=>b.addEventListener('click',()=>applyLanguage(b.dataset.lang)));
const translationObserver=new MutationObserver(records=>{for(const record of records){if(record.type==='childList'){record.addedNodes.forEach(n=>{if(n.nodeType===Node.TEXT_NODE)translateTextNode(n);else if(n.nodeType===Node.ELEMENT_NODE){const w=document.createTreeWalker(n,NodeFilter.SHOW_TEXT);let t;while(t=w.nextNode())translateTextNode(t)}})}else if(record.type==='characterData'){translateTextNode(record.target)}}});
translationObserver.observe(document.body,{subtree:true,childList:true,characterData:true});

let W=960,H=600,scale=1,last=0,elapsed=0,waveElapsed=0,mode='menu',runId=0;
let hitStopTime=0;
const TAU=Math.PI*2,rand=(a,b)=>a+Math.random()*(b-a),clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y),angle=(a,b)=>Math.atan2(b.y-a.y,b.x-a.x);
// Persisted values are untrusted input: reject NaN/Infinity and bound numeric state.
const storedInt=(value,fallback=0,min=0,max=1000000000)=>{if((typeof value!=='number'&&typeof value!=='string')||(typeof value==='string'&&!value.trim()))return fallback;const n=Number(value);return Number.isSafeInteger(n)&&n>=min&&n<=max?n:fallback};
let player,enemies=[],particles=[],impactMarks=[],dashEchoes=[],slashes=[],orbs=[],rings=[],floaters=[],hazards=[],keys={},joystick={x:0,y:0,pointer:null},touchAttack=false,stats={},waveTimer=0,spawnTimer=0,worldEventTimer=9,boss=null,best=0,audio=null,audioOn=(()=>{try{return localStorage.getItem('emberfall_audio')!=='off'}catch(e){return true}})();
const SETTINGS_KEY='emberfall_settings_v08';
function readSettings(){const defaults={quality:'auto',volume:70,particles:true,shake:true};try{const raw=JSON.parse(localStorage.getItem(SETTINGS_KEY)||'{}');return {quality:['auto','low','balanced','high'].includes(raw.quality)?raw.quality:defaults.quality,volume:clamp(Number.isFinite(Number(raw.volume))?Number(raw.volume):defaults.volume,0,100),particles:raw.particles!==false,shake:raw.shake!==false}}catch(e){return {...defaults}}}
let settings=readSettings(),renderProfile={particleScale:.55,maxParticles:120,ambient:true,glow:.58},shakeTime=0,shakePower=0,settingsReturn='menu';
// Adaptive quality is deliberately conservative on phones and recovers only after sustained headroom.
const deviceHints={cores:Number(navigator.hardwareConcurrency)||0,memory:Number(navigator.deviceMemory)||0,coarse:!!(window.matchMedia&&window.matchMedia('(pointer: coarse)').matches)};
let adaptiveTier=(deviceHints.memory>0&&deviceHints.memory<=3)||(deviceHints.cores>0&&deviceHints.cores<=4)?'low':(deviceHints.coarse&&Math.min(screen.width||innerWidth,screen.height||innerHeight)<760?'low':'balanced');
let fpsWindow=[],fpsSampleTime=0,slowTime=0,fastTime=0,lastQualityChange=0,adaptiveNote='';
function effectiveQuality(){if(settings.quality==='low')return 'low';if(settings.quality==='high'&&adaptiveTier!=='low')return 'high';if(settings.quality==='auto')return adaptiveTier;return adaptiveTier==='low'?'low':'balanced'}
function updateRenderProfile(){const q=effectiveQuality();if(q==='low')renderProfile={particleScale:.22,maxParticles:42,ambient:false,glow:.25,dprCap:.9};else if(q==='high')renderProfile={particleScale:1,maxParticles:230,ambient:true,glow:.88,dprCap:1.5};else renderProfile={particleScale:.48,maxParticles:100,ambient:true,glow:.48,dprCap:1.15};if(!settings.particles){renderProfile={...renderProfile,particleScale:0,maxParticles:0,ambient:false,glow:Math.min(renderProfile.glow,.4)}}}
function sampleAdaptiveQuality(dt,ts){if(settings.quality==='low')return;fpsSampleTime+=dt;if(dt>0)fpsWindow.push(1/dt);if(fpsWindow.length>90)fpsWindow.shift();if(fpsSampleTime<2||fpsWindow.length<20)return;const sorted=[...fpsWindow].sort((a,b)=>a-b),fps=sorted[Math.floor(sorted.length*.25)];fpsSampleTime=0;if(fps<34){slowTime+=2;fastTime=0}else if(fps>52){fastTime+=2;slowTime=Math.max(0,slowTime-2)}else{slowTime=Math.max(0,slowTime-1);fastTime=0}if(ts-lastQualityChange<6000)return;let next=adaptiveTier;if(slowTime>=3)next='low';else if(fastTime>=8)next='balanced';if(next!==adaptiveTier){adaptiveTier=next;lastQualityChange=ts;slowTime=fastTime=0;updateRenderProfile();resize();if(Array.isArray(particles)&&particles.length>renderProfile.maxParticles)particles.length=renderProfile.maxParticles;adaptiveNote=next==='low'?'low':'balanced';const badge=$('qualitySummary');if(badge&&settings.quality==='auto')badge.textContent=tr(next==='low'?'AUTO · SAVER':'AUTO · BALANCED')}}
function persistSettings(){try{localStorage.setItem(SETTINGS_KEY,JSON.stringify(settings));return true}catch(e){return false}}
function renderSettings(){updateRenderProfile();if(Array.isArray(particles)&&particles.length>renderProfile.maxParticles)particles.length=renderProfile.maxParticles;const ab=$('settingsAudioToggle');if(ab){ab.textContent=tr(audioOn?'SOUND: ON':'SOUND: OFF');ab.classList.toggle('off',!audioOn);ab.setAttribute('aria-pressed',String(audioOn))}document.querySelectorAll('[data-quality]').forEach(b=>{const selected=b.dataset.quality===settings.quality;b.classList.toggle('selected',selected);b.setAttribute('aria-pressed',String(selected))});const q=$('qualitySummary');if(q){const label=settings.quality==='auto'?(adaptiveTier==='low'?'AUTO · SAVER':'AUTO · BALANCED'):({low:'SAVER · LIGHTWEIGHT',balanced:'BALANCED · RECOMMENDED',high:'CINEMATIC · FULL EFFECTS'})[settings.quality];q.textContent=tr(label||'BALANCED · RECOMMENDED')}if($('volumeSlider'))$('volumeSlider').value=String(settings.volume);if($('volumeValue'))$('volumeValue').textContent=String(settings.volume)+'%';for(const [id,on] of [['particlesToggle',settings.particles],['shakeToggle',settings.shake]]){const b=$(id);if(b){b.textContent=tr(on?'ON':'OFF');b.classList.toggle('off',!on);b.setAttribute('aria-pressed',String(on))}}}
function openSettings(from='menu'){settingsReturn=from;if(from==='menu'&&mode==='menu')$('startOverlay').style.display='none';$('settingsOverlay').style.display='flex';if(from==='pause')$('pauseOverlay').style.display='none';renderSettings()}
function closeSettings(){ $('settingsOverlay').style.display='none';if(settingsReturn==='pause'&&mode==='paused')$('pauseOverlay').style.display='flex';if(settingsReturn==='menu'&&mode==='menu')$('startOverlay').style.display='flex';if(settingsReturn==='pause'&&mode==='playing'){$('pauseOverlay').style.display='none'}}
const DOCTRINE_KEY='emberfall_combat_doctrine_v17';
const DOCTRINES=[
 {id:'duelist',name:'CINDER DUELIST',icon:'⚔',summary:'SELECTED PATH · CINDER DUELIST',color:'#ff9565',desc:'Precision and pressure. Faster strikes, stronger attacks as your Rift Chain grows.'},
 {id:'weaver',name:'VOID WEAVER',icon:'✦',summary:'SELECTED PATH · VOID WEAVER',color:'#c2a0ff',desc:'Shape the Rift. More special damage, shorter burst cooldown, extra healing on empowered burst.'},
 {id:'warden',name:'IRON WARDEN',icon:'⬡',summary:'SELECTED PATH · IRON WARDEN',color:'#72f6ff',desc:'Stand through the storm. More starting health, safer dashes, reduced incoming damage.'}
];
let selectedDoctrineId=(()=>{try{const id=localStorage.getItem(DOCTRINE_KEY);return DOCTRINES.some(d=>d.id===id)?id:'duelist'}catch(e){return 'duelist'}})();
function activeDoctrine(){return DOCTRINES.find(d=>d.id===selectedDoctrineId)||DOCTRINES[0]}
function updateDoctrineUI(){
 const d=activeDoctrine();
 document.querySelectorAll('[data-doctrine]').forEach(b=>{const on=b.dataset.doctrine===d.id;b.classList.toggle('selected',on);b.setAttribute('aria-pressed',String(on))});
 const summary=$('doctrineSummary');if(summary)summary.textContent=tr(d.summary);
 try{localStorage.setItem(DOCTRINE_KEY,d.id)}catch(e){}
}
function selectDoctrine(id){if(!DOCTRINES.some(d=>d.id===id))return;selectedDoctrineId=id;updateDoctrineUI();sound(420,.07,'triangle',.025)}

const CORE_KEY='emberfall_eclipse_cores_v25';
const SAVE_BACKUP_FORMAT='EMBERFALL_SAVE_BACKUP_V4';
function saveBackupKeys(){return [LANGUAGE_KEY,'emberfall_audio',SETTINGS_KEY,BEST_KEY,WEAPON_KEY,WORLD_UNLOCK_KEY,WORLD_SELECT_KEY,CAMPAIGN_KEY,TRIAL_SELECTION_KEY,WALLET_KEY,STORE_KEY,PROFILE_KEY,DOCTRINE_KEY,CORE_KEY,DAILY_GIFT_KEY]}
function setSaveBackupNotice(message){const el=$('saveBackupNotice');if(el)el.textContent=tr(message)}
function exportSaveBackup(){
 try{
  const data={};for(const key of saveBackupKeys())data[key]=localStorage.getItem(key);
  const payload={format:SAVE_BACKUP_FORMAT,createdAt:new Date().toISOString(),data};
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');
  a.href=url;a.download='emberfall-save-backup.json';a.style.display='none';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);
  setSaveBackupNotice('Backup exported. Keep the JSON file safe.');sound(520,.08,'triangle',.025);
 }catch(e){setSaveBackupNotice('Save storage is unavailable. No backup changes were applied.')}
}
function validateBackupPayload(payload){
 if(!payload||typeof payload!=='object'||Array.isArray(payload)||Object.keys(payload).some(k=>!['format','createdAt','data'].includes(k))||!['EMBERFALL_SAVE_BACKUP_V1','EMBERFALL_SAVE_BACKUP_V2','EMBERFALL_SAVE_BACKUP_V3',SAVE_BACKUP_FORMAT].includes(payload.format)||!payload.data||typeof payload.data!=='object'||Array.isArray(payload.data))return false;
 if(payload.createdAt!==undefined&&(typeof payload.createdAt!=='string'||payload.createdAt.length>40||!Number.isFinite(Date.parse(payload.createdAt))))return false;
 const keys=saveBackupKeys(),data=payload.data,requiredKeys=payload.format==='EMBERFALL_SAVE_BACKUP_V1'?keys.filter(k=>![DOCTRINE_KEY,CORE_KEY,DAILY_GIFT_KEY].includes(k)):payload.format==='EMBERFALL_SAVE_BACKUP_V2'?keys.filter(k=>![CORE_KEY,DAILY_GIFT_KEY].includes(k)):payload.format==='EMBERFALL_SAVE_BACKUP_V3'?keys.filter(k=>k!==DAILY_GIFT_KEY):keys;
 if(Object.keys(data).length!==requiredKeys.length||requiredKeys.some(k=>!Object.prototype.hasOwnProperty.call(data,k)))return false;
 let total=0;for(const k of requiredKeys){const v=data[k];if(v!==null&&typeof v!=='string')return false;if(typeof v==='string'){total+=v.length;if(v.length>60000)return false}}if(total>100000)return false;
 if(Object.prototype.hasOwnProperty.call(data,DOCTRINE_KEY)&&data[DOCTRINE_KEY]!==null&&!DOCTRINES.some(d=>d.id===data[DOCTRINE_KEY]))return false;
 const integerString=(key,min,max,nullable=true)=>{const v=data[key];if(v===null&&nullable)return true;if(typeof v!=='string'||!/^(0|[1-9]\d*)$/.test(v))return false;const n=Number(v);return Number.isSafeInteger(n)&&n>=min&&n<=max};
 const parse=(key)=>{if(data[key]===null)return null;try{return JSON.parse(data[key])}catch(e){return undefined}};
 if(data[LANGUAGE_KEY]!==null&&!['en','tr','ar'].includes(data[LANGUAGE_KEY]))return false;
 if(data.emberfall_audio!==null&&!['on','off'].includes(data.emberfall_audio))return false;
 if(!integerString(BEST_KEY,0,1000000)||!integerString(WORLD_UNLOCK_KEY,1,3)||!integerString(WORLD_SELECT_KEY,0,2)||!integerString(WALLET_KEY,0,999999999))return false;
 if(Object.prototype.hasOwnProperty.call(data,CORE_KEY)&&!integerString(CORE_KEY,0,1000000))return false;
 if(data[TRIAL_SELECTION_KEY]!==null&&!TRIALS.some(t=>t.id===data[TRIAL_SELECTION_KEY]))return false;
 const campaignBackup=parse(CAMPAIGN_KEY);if(campaignBackup===undefined)return false;
 if(campaignBackup!==null){
  const allowedCampaignKeys=['highestWave','completed','claimed','chapterIndex','chapterKills','chapterBoss'];
  if(!campaignBackup||typeof campaignBackup!=='object'||Array.isArray(campaignBackup)||Object.keys(campaignBackup).some(k=>!allowedCampaignKeys.includes(k)))return false;
  if(campaignBackup.highestWave!==undefined&&(!Number.isSafeInteger(campaignBackup.highestWave)||campaignBackup.highestWave<1||campaignBackup.highestWave>100000))return false;
  if(campaignBackup.completed!==undefined&&typeof campaignBackup.completed!=='boolean')return false;
  if(campaignBackup.chapterIndex!==undefined&&(!Number.isSafeInteger(campaignBackup.chapterIndex)||campaignBackup.chapterIndex<0||campaignBackup.chapterIndex>=CAMPAIGN_CHAPTERS.length))return false;
  if(campaignBackup.chapterKills!==undefined&&(!Number.isSafeInteger(campaignBackup.chapterKills)||campaignBackup.chapterKills<0||campaignBackup.chapterKills>1000))return false;
  if(campaignBackup.chapterBoss!==undefined&&typeof campaignBackup.chapterBoss!=='boolean')return false;
  if(campaignBackup.claimed!==undefined&&(!Array.isArray(campaignBackup.claimed)||campaignBackup.claimed.length>CAMPAIGN_CHAPTERS.length||campaignBackup.claimed.some(n=>!Number.isInteger(n)||n<0||n>=CAMPAIGN_CHAPTERS.length)||new Set(campaignBackup.claimed).size!==campaignBackup.claimed.length))return false;
 }
 if(data[WEAPON_KEY]!==null&&!['aetherblade','twinfangs','duskcleaver','riftlance'].includes(data[WEAPON_KEY]))return false;
 if(Object.prototype.hasOwnProperty.call(data,DAILY_GIFT_KEY)){const gift=parse(DAILY_GIFT_KEY);if(gift===undefined)return false;if(gift!==null){const validDate=v=>typeof v==='string'&&(v===''||( /^\d{4}-\d{2}-\d{2}$/.test(v)&&Number.isFinite(Date.parse(v+'T00:00:00Z'))&&new Date(v+'T00:00:00Z').toISOString().slice(0,10)===v));if(!gift||typeof gift!=='object'||Array.isArray(gift)||Object.keys(gift).some(k=>!['date','previousDate','streak','claimed','doubled'].includes(k))||!validDate(gift.date)||!validDate(gift.previousDate)||!Number.isSafeInteger(gift.streak)||gift.streak<0||gift.streak>6||typeof gift.claimed!=='boolean'||typeof gift.doubled!=='boolean'||(gift.doubled&&!gift.claimed))return false}}
 const settingsData=parse(SETTINGS_KEY);if(settingsData===undefined)return false;if(settingsData!==null&&(!settingsData||typeof settingsData!=='object'||Array.isArray(settingsData)||Object.keys(settingsData).some(k=>!['quality','volume','particles','shake'].includes(k))||!['auto','low','balanced','high'].includes(settingsData.quality)||!Number.isFinite(Number(settingsData.volume))||Number(settingsData.volume)<0||Number(settingsData.volume)>100||(settingsData.particles!==undefined&&typeof settingsData.particles!=='boolean')||(settingsData.shake!==undefined&&typeof settingsData.shake!=='boolean')))return false;
 const ranks=parse(STORE_KEY);if(ranks===undefined)return false;if(ranks!==null){const max={vitality:5,blade:5,dash:4,rift:4,magnet:3};if(!ranks||typeof ranks!=='object'||Array.isArray(ranks)||Object.keys(ranks).some(k=>!Object.prototype.hasOwnProperty.call(max,k))||Object.entries(ranks).some(([k,v])=>!Number.isSafeInteger(v)||v<0||v>max[k]))return false}
 const profileData=parse(PROFILE_KEY);if(profileData===undefined)return false;if(profileData!==null){
  if(!profileData||typeof profileData!=='object'||Array.isArray(profileData))return false;
  const allowedProfileKeys=['totalKills','bossKills','runs','bestWave','specialsUsed','worldsUnlocked','weaponsUsed','claimedAchievements','selectedSigil','daily'];
  if(Object.keys(profileData).some(k=>!allowedProfileKeys.includes(k)))return false;
  const numeric={totalKills:999999999,bossKills:999999999,runs:999999999,bestWave:1000000,specialsUsed:999999999,worldsUnlocked:3};
  for(const [k,max] of Object.entries(numeric)){if(profileData[k]!==undefined&&(!Number.isSafeInteger(profileData[k])||profileData[k]<(k==='worldsUnlocked'?1:0)||profileData[k]>max))return false}
  const weapons=['aetherblade','twinfangs','duskcleaver','riftlance'],achievements=['first_spark','soul_harvester','titan_breaker','titan_trio','storm_survivor','realmwalker','frostbound','arsenal'],sigils=['spark','ember','titan','verdant','frost','prism','eclipse'];
  if(profileData.weaponsUsed!==undefined&&(!Array.isArray(profileData.weaponsUsed)||profileData.weaponsUsed.some(v=>!weapons.includes(v))))return false;
  if(profileData.claimedAchievements!==undefined&&(!Array.isArray(profileData.claimedAchievements)||profileData.claimedAchievements.some(v=>!achievements.includes(v))))return false;
  if(profileData.selectedSigil!==undefined&&!sigils.includes(profileData.selectedSigil))return false;
  if(profileData.daily!==undefined){const d=profileData.daily;if(!d||typeof d!=='object'||Array.isArray(d)||Object.keys(d).some(k=>!['date','kills','specials','bosses','claimed'].includes(k))||typeof d.date!=='string'||!/\d{4}-\d{2}-\d{2}$/.test(d.date)||!Number.isFinite(Date.parse(d.date+'T00:00:00Z'))||new Date(d.date+'T00:00:00Z').toISOString().slice(0,10)!==d.date)return false;for(const k of ['kills','specials','bosses'])if(d[k]!==undefined&&(!Number.isSafeInteger(d[k])||d[k]<0||d[k]>999999))return false;if(d.claimed!==undefined&&(!d.claimed||typeof d.claimed!=='object'||Array.isArray(d.claimed)||Object.keys(d.claimed).some(k=>!['kills','specials','bosses'].includes(k))||['kills','specials','bosses'].some(k=>d.claimed[k]!==undefined&&typeof d.claimed[k]!=='boolean')))return false}
 }
 return true;
}
function mergeBackupProgress(data){
 const readCurrent=key=>{try{const raw=localStorage.getItem(key);return raw===null?null:JSON.parse(raw)}catch(e){return null}};
 const maxStoredInt=key=>{const incoming=data[key],current=localStorage.getItem(key);if(incoming===null)return;if(!/^\d+$/.test(incoming))return;const a=Number(incoming),b=/^\d+$/.test(current||'')?Number(current):0;data[key]=String(Math.max(a,b))};
 maxStoredInt(BEST_KEY);maxStoredInt(WORLD_UNLOCK_KEY);maxStoredInt(WALLET_KEY);if(Object.prototype.hasOwnProperty.call(data,CORE_KEY))maxStoredInt(CORE_KEY);
 const currentProfile=readCurrent(PROFILE_KEY);let incomingProfile=null;try{incomingProfile=data[PROFILE_KEY]===null?null:JSON.parse(data[PROFILE_KEY])}catch(e){}
 if(currentProfile&&incomingProfile&&typeof currentProfile==='object'&&typeof incomingProfile==='object'){
  for(const k of ['totalKills','bossKills','runs','bestWave','specialsUsed','worldsUnlocked'])incomingProfile[k]=Math.max(Number(incomingProfile[k])||0,Number(currentProfile[k])||0);
  for(const k of ['weaponsUsed','claimedAchievements'])incomingProfile[k]=[...new Set([...(Array.isArray(incomingProfile[k])?incomingProfile[k]:[]),...(Array.isArray(currentProfile[k])?currentProfile[k]:[])])];
  const incomingDaily=incomingProfile.daily,currentDaily=currentProfile.daily;
  if(currentDaily&&typeof currentDaily==='object'&&incomingDaily&&typeof incomingDaily==='object'){
   if(typeof currentDaily.date==='string'&&typeof incomingDaily.date==='string'){
    if(currentDaily.date>incomingDaily.date)incomingProfile.daily=currentDaily;
    else if(incomingDaily.date>currentDaily.date)incomingProfile.daily=incomingDaily;
    else incomingProfile.daily={...incomingDaily,kills:Math.max(Number(incomingDaily.kills)||0,Number(currentDaily.kills)||0),specials:Math.max(Number(incomingDaily.specials)||0,Number(currentDaily.specials)||0),bosses:Math.max(Number(incomingDaily.bosses)||0,Number(currentDaily.bosses)||0),claimed:Object.fromEntries(['kills','specials','bosses'].map(id=>[id,Boolean(incomingDaily.claimed&&incomingDaily.claimed[id]||currentDaily.claimed&&currentDaily.claimed[id])]))};
   }
  }else if(currentDaily&&!incomingDaily)incomingProfile.daily=currentDaily;
  data[PROFILE_KEY]=JSON.stringify(incomingProfile);
 }else if(currentProfile&&typeof currentProfile==='object'&&!Array.isArray(currentProfile)&&!incomingProfile){
  // A legacy/partial backup may omit the profile payload or contain null.
  // Preserve the current profile instead of replacing valid progress with an empty save.
  data[PROFILE_KEY]=JSON.stringify(currentProfile);
 }
 const currentCampaign=readCurrent(CAMPAIGN_KEY);let incomingCampaign=null;try{incomingCampaign=data[CAMPAIGN_KEY]===null?null:JSON.parse(data[CAMPAIGN_KEY])}catch(e){}
 if(currentCampaign&&incomingCampaign&&typeof currentCampaign==='object'&&typeof incomingCampaign==='object'){
  incomingCampaign.highestWave=Math.max(Number(incomingCampaign.highestWave)||0,Number(currentCampaign.highestWave)||0);
  incomingCampaign.completed=Boolean(incomingCampaign.completed||currentCampaign.completed);
  incomingCampaign.claimed=[...new Set([...(Array.isArray(incomingCampaign.claimed)?incomingCampaign.claimed:[]),...(Array.isArray(currentCampaign.claimed)?currentCampaign.claimed:[])])];
  data[CAMPAIGN_KEY]=JSON.stringify(incomingCampaign);
 }
 const currentStore=readCurrent(STORE_KEY);let incomingStore=null;try{incomingStore=data[STORE_KEY]===null?null:JSON.parse(data[STORE_KEY])}catch(e){}
 if(currentStore&&incomingStore&&typeof currentStore==='object'&&typeof incomingStore==='object'){
  for(const k of ['vitality','blade','dash','rift','magnet'])incomingStore[k]=Math.max(Number(incomingStore[k])||0,Number(currentStore[k])||0);
  data[STORE_KEY]=JSON.stringify(incomingStore);
 }
 const currentGift=readCurrent(DAILY_GIFT_KEY);let incomingGift=null;try{incomingGift=data[DAILY_GIFT_KEY]===null?null:JSON.parse(data[DAILY_GIFT_KEY])}catch(e){}
 if(currentGift&&incomingGift&&typeof currentGift.date==='string'&&typeof incomingGift.date==='string'&&currentGift.date>=incomingGift.date)data[DAILY_GIFT_KEY]=JSON.stringify(currentGift);
}
async function importSaveBackup(file){
 if(!file||file.size>120000){setSaveBackupNotice('Choose a valid EMBERFALL backup JSON file.');return}
 try{
  const payload=JSON.parse(await file.text());if(!validateBackupPayload(payload)){setSaveBackupNotice('Backup rejected: invalid format or unsupported data. Your current save was not changed.');return}
  mergeBackupProgress(payload.data);if(!validateBackupPayload(payload)){setSaveBackupNotice('Backup rejected after progress reconciliation. Your current save was not changed.');return}
  const previous={};for(const key of saveBackupKeys())previous[key]=localStorage.getItem(key);
  try{for(const key of saveBackupKeys()){if(!Object.prototype.hasOwnProperty.call(payload.data,key))continue;const val=payload.data[key];if(val===null)localStorage.removeItem(key);else localStorage.setItem(key,val)}}catch(e){let rollbackOk=true;for(const key of saveBackupKeys()){try{const val=previous[key];if(val===null)localStorage.removeItem(key);else localStorage.setItem(key,val)}catch(_){rollbackOk=false}}setSaveBackupNotice(rollbackOk?'Save storage is unavailable. Previous save was restored.':'Storage failed during restore and rollback was incomplete. Do not close the page; export any accessible save and check storage.');return}
  setSaveBackupNotice('Backup restored. The game will reload now.');setTimeout(()=>location.reload(),500);
 }catch(e){setSaveBackupNotice('Could not read this file. Your current save was not changed.')}
}
$('exportSaveBtn').addEventListener('click',exportSaveBackup);
$('importSaveBtn').addEventListener('click',()=>{$('saveImportFile').click()});
$('saveImportFile').addEventListener('change',e=>{const file=e.target.files&&e.target.files[0];if(file)importSaveBackup(file);e.target.value=''});

function triggerShake(amount){if(!settings.shake)return;shakeTime=Math.max(shakeTime,.14);shakePower=Math.max(shakePower,amount)}
