 {id:'ascendant',title:'ECLIPSE ASCENDANT',reward:3.25,enemyHp:2.18,enemySpeed:1.38,enemyDamage:1.72,spawnRate:1.48,xp:1.7,startHp:.62,eliteChance:2.85},
