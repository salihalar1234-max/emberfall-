 ctx.translate(p.x,p.y);const moveBlend=clamp(Math.hypot(p.vx||0,p.vy||0)/Math.max(1,p.speed||100),0,1);let bob=Math.sin((p.stride||0)*.42)*1.7*moveBlend;const aura=SIGILS.find(s=>s.id===profile.selectedSigil)||SIGILS[0];ctx.save();ctx.globalAlpha=.28+.13*Math.sin(elapsed*5);ctx.strokeStyle=aura.color;ctx.shadowColor=aura.color;ctx.shadowBlur=(12)*renderProfile.glow;ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,18+Math.sin(elapsed*4)*1.5,0,TAU);ctx.stroke();for(let i=0;i<3;i++){const aa=elapsed*1.5+i*TAU/3;ctx.fillStyle=aura.color;ctx.beginPath();ctx.arc(Math.cos(aa)*21,Math.sin(aa)*13,2.1,0,TAU);ctx.fill()}ctx.restore();
 ctx.fillStyle='#03061172';ctx.beginPath();ctx.ellipse(0,14,18+moveBlend*2,7,0,0,TAU);ctx.fill();ctx.save();ctx.translate(clamp(-(p.vx||0)*.012,-2.4,2.4),clamp(-(p.vy||0)*.012,-2.4,2.4));ctx.rotate(p.face);const gait=Math.sin((p.stride||0)*.38)*4.5*moveBlend;ctx.lineCap='round';ctx.strokeStyle='#25304d';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(-3,5);ctx.lineTo(-5+gait,13);ctx.moveTo(4,5);ctx.lineTo(5-gait,13);ctx.stroke();ctx.strokeStyle='#99a6ca';ctx.lineWidth=1.4;ctx.beginPath();ctx.moveTo(-5+gait,13);ctx.lineTo(-1+gait,13);ctx.moveTo(5-gait,13);ctx.lineTo(9-gait,13);ctx.stroke();
 ctx.shadowColor=col;ctx.shadowBlur=(17)*renderProfile.glow;ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(-7,-7);ctx.lineTo(-17,-16+bob);ctx.lineTo(-11,0);ctx.lineTo(-17,15-bob);ctx.lineTo(-4,9);ctx.closePath();ctx.fill();ctx.shadowBlur=(0)*renderProfile.glow;
 ctx.fillStyle='#1e2944';ctx.beginPath();ctx.ellipse(-1,2,11,12,0,0,TAU);ctx.fill();ctx.fillStyle='#b8c8e6';ctx.beginPath();ctx.ellipse(0,0,10.5,10,0,0,TAU);ctx.fill();ctx.fillStyle='#7386b6';ctx.beginPath();ctx.ellipse(2,1,7.3,8,0,0,TAU);ctx.fill();ctx.fillStyle='#10182d';ctx.beginPath();ctx.arc(4,-2,5,0,TAU);ctx.fill();ctx.fillStyle=col;ctx.fillRect(4,-5,5,2);ctx.strokeStyle='#e4efff';ctx.lineWidth=1.1;ctx.beginPath();ctx.moveTo(-3,-6);ctx.lineTo(2,-9);ctx.lineTo(7,-6);ctx.stroke();ctx.strokeStyle='#43577e';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-3,3);ctx.lineTo(2,6);ctx.lineTo(6,2);ctx.stroke();
 // Each weapon has its own readable silhouette and attack animation.
 ctx.lineCap='round';ctx.lineJoin='round';const attackProgress=1-(p.attackAnim||0)/.26;const swingAngle=(p.attackAnim||0)>0?(attackProgress<.32?-.82*(attackProgress/.32):-.82+1.42*((attackProgress-.32)/.68)):(p.weaponRecoil||0)*.16;ctx.save();ctx.translate(7,4);ctx.rotate(swingAngle);ctx.translate(-7,-4);
