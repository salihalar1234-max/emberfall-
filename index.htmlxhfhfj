   const previousRealm=worldIndexForWave(player.wave);waveTimer=0;waveElapsed=0;player.wave++;saveBestWave();campaignData.highestWave=Math.max(campaignData.highestWave,player.wave);saveCampaign();campaignUpdate(player.wave,true);const nextRealm=worldIndexForWave(player.wave);if(player.wave>60){campaignData.completed=true;saveCampaign();mode='victory';$('hud').style.display='none';$('campaignHud').style.display='none';$('gameOverOverlay').style.display='flex';$('gameOverTitle').textContent=tr('CAMPAIGN COMPLETE');$('finalWave').textContent=String(player.wave-1);$('finalKills').textContent=String(stats.kills);$('finalLevel').textContent=String(player.level);$('finalElites').textContent=String(stats.eliteKills);$('trialFinalLabel').textContent=tr('CAMPAIGN')+' · 12 '+tr('CHAPTERS');$('rewardFinalLabel').textContent=tr('CHAPTER CONTRACTS')+' · '+campaignData.claimed.length+'/12';$('finalRelics').textContent=tr('CAMPAIGN CLEAR')+' · '+String(campaignData.highestWave-1)+' '+tr('WAVES');return;}
   if(nextRealm!==previousRealm){worldEventTimer=5;announce(WORLDS[nextRealm].intro)}
