 for(let i=0;i<p.orbitals;i++){let a=p.orbitT+i*TAU/p.orbitals,x=p.x+Math.cos(a)*38,y=p.y+Math.sin(a)*38;glow(x,y,4,'#ffd27c',14);ctx.fillStyle='#fff0bf';ctx.beginPath();ctx.arc(x,y,2,0,TAU);ctx.fill()}
 if(p.dashing>0){ctx.globalAlpha=.35;ctx.strokeStyle=col;ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(p.x-p.dashX*12,p.y-p.dashY*12);ctx.lineTo(p.x-p.dashX*58,p.y-p.dashY*58);ctx.stroke();ctx.globalAlpha=1}
}
function drawEnemy(e){
 ctx.save();ctx.translate(e.x,e.y);const impactPose=clamp((e.hitStun||0)*1.8,0,.13);ctx.scale(1+impactPose,1-impactPose*.72);let pulse=Math.sin(elapsed*5+e.phase)*1.8;
 const colors={stalker:'#e65c73',brute:'#ff875f',spitter:'#9c83ff',skirmisher:'#ffd27c',wraith:'#7df5ff'};
 let col=e.boss?(e.bossColor||'#ff447c'):(colors[e.type]||'#e65c73');
 ctx.fillStyle='#050817bb';ctx.beginPath();ctx.ellipse(0,e.r+5,e.r*1.2,7,0,0,TAU);ctx.fill();
 ctx.shadowColor=col;ctx.shadowBlur=(e.boss?28:e.type==='wraith'?23:15)*renderProfile.glow;ctx.fillStyle=e.flash>0?'#fff7fb':col;ctx.beginPath();
 if(e.boss){const spikes=e.bossKind==='behemoth'?8:e.bossKind==='archon'?6:e.bossKind==='matriarch'?14:e.bossKind==='sovereign'?16:12;for(let i=0;i<spikes;i++){let a=i*TAU/spikes,r=e.r+(i%2?0:(e.bossKind==='behemoth'?11:7))+pulse;let x=Math.cos(a)*r,y=Math.sin(a)*r;i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.closePath()}
 else if(e.type==='brute'){ctx.moveTo(-e.r,-e.r*.65);ctx.lineTo(-e.r*.65,-e.r);ctx.lineTo(e.r*.7,-e.r);ctx.lineTo(e.r,e.r*.35);ctx.lineTo(e.r*.4,e.r);ctx.lineTo(-e.r*.8,e.r*.8);ctx.closePath()}
 else if(e.type==='skirmisher'){ctx.moveTo(e.r*1.3,0);ctx.lineTo(-e.r*.9,-e.r*.82);ctx.lineTo(-e.r*.45,0);ctx.lineTo(-e.r*.9,e.r*.82);ctx.closePath()}
 else if(e.type==='wraith'){ctx.moveTo(0,-e.r*1.25);ctx.quadraticCurveTo(e.r*1.45,-e.r*.2,e.r*.7,e.r*.9);ctx.lineTo(0,e.r*.48);ctx.lineTo(-e.r*.7,e.r*.9);ctx.quadraticCurveTo(-e.r*1.45,-e.r*.2,0,-e.r*1.25);ctx.closePath()}
 else{ctx.ellipse(0,0,e.r+pulse*.3,e.r*1.16+pulse,0,0,TAU)}ctx.fill();ctx.strokeStyle=e.flash>0?'#ffffff':(e.boss?(e.bossColor||'#ffcfdf')+'b0':'#fff0dc55');ctx.lineWidth=e.boss?1.7:1.1;ctx.globalAlpha=.74;ctx.stroke();ctx.globalAlpha=1;ctx.shadowBlur=(0)*renderProfile.glow;
 ctx.fillStyle='#160d22';ctx.beginPath();ctx.arc(4,-3,Math.max(3,e.r*.27),0,TAU);ctx.fill();ctx.fillStyle=e.boss?(e.bossColor||'#ffe2f0'):'#fff0dc';ctx.fillRect(2,-4,5,2);
 if(e.boss){ctx.strokeStyle=e.bossColor||'#ffb4d0';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(-17,-24);ctx.lineTo(-25,-40);ctx.lineTo(-5,-30);ctx.moveTo(15,-23);ctx.lineTo(28,-37);ctx.lineTo(24,-17);ctx.stroke();if(e.bossKind==='matriarch'){ctx.lineWidth=2;for(let i=0;i<6;i++){const a=i*TAU/6+elapsed*.18;ctx.beginPath();ctx.moveTo(Math.cos(a)*(e.r-1),Math.sin(a)*(e.r-1));ctx.quadraticCurveTo(Math.cos(a)* (e.r+18),Math.sin(a)*(e.r+18),Math.cos(a)*(e.r+30),Math.sin(a)*(e.r+30));ctx.stroke()}}else if(e.bossKind==='behemoth'){ctx.lineWidth=3;for(let i=0;i<4;i++){const a=i*Math.PI/2+Math.PI/4;ctx.beginPath();ctx.moveTo(Math.cos(a)*(e.r-2),Math.sin(a)*(e.r-2));ctx.lineTo(Math.cos(a)*(e.r+13),Math.sin(a)*(e.r+13));ctx.stroke()}}else if(e.bossKind==='archon'){ctx.lineWidth=2;ctx.save();ctx.rotate(elapsed*.48);ctx.strokeRect(-e.r-9,-e.r-9,(e.r+9)*2,(e.r+9)*2);ctx.restore()}else if(e.bossKind==='sovereign'){ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(0,0,e.r+13,e.r+8,-elapsed*.4,0,TAU);ctx.stroke()}else if(e.bossKind==='devourer'){ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(-11,8);ctx.lineTo(-5,15);ctx.lineTo(0,9);ctx.lineTo(5,15);ctx.lineTo(11,8);ctx.stroke()}if((e.fractureTime||0)>0){ctx.strokeStyle='#72f6ff';ctx.globalAlpha=.65+.25*Math.sin(elapsed*14);ctx.lineWidth=2.5;ctx.beginPath();ctx.arc(0,0,e.r+12+Math.sin(elapsed*9)*2,0,TAU);ctx.stroke()}if((e.staggerTime||0)>0){ctx.fillStyle='#b8fbff';ctx.globalAlpha=.9;ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.fillText('✦',0,-e.r-18)}}
 if((['skirmisher','brute'].includes(e.type)&&e.windup>0)||(e.boss&&e.windup>0)){ctx.strokeStyle=e.boss?(e.bossColor||'#ffb1cc'):e.type==='brute'?'#ffd27c':'#ffe2a1';ctx.globalAlpha=.55+.35*Math.sin(elapsed*18);ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,e.r+8+Math.sin(elapsed*14)*2,0,TAU);ctx.stroke()}
 if(e.type==='wraith'&&e.invuln>0){ctx.strokeStyle='#b9fbff';ctx.globalAlpha=.7;ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,e.r+5,0,TAU);ctx.stroke()}
 ctx.restore();
 if(e.elite){const ec=e.elite==='feral'?'#ff7698':e.elite==='armored'?'#ffd27c':'#b69aff';ctx.save();ctx.strokeStyle=ec;ctx.fillStyle=ec;ctx.shadowColor=ec;ctx.shadowBlur=12*renderProfile.glow;ctx.lineWidth=2;ctx.globalAlpha=.75+.2*Math.sin(elapsed*7+e.phase);ctx.beginPath();ctx.arc(e.x,e.y,e.r+5+Math.sin(elapsed*5)*1.5,0,TAU);ctx.stroke();if(e.elite==='feral'){for(let i=0;i<4;i++){const a=i*Math.PI/2+elapsed*.5;ctx.beginPath();ctx.moveTo(e.x+Math.cos(a)*(e.r+2),e.y+Math.sin(a)*(e.r+2));ctx.lineTo(e.x+Math.cos(a)*(e.r+9),e.y+Math.sin(a)*(e.r+9));ctx.stroke()}}else if(e.elite==='armored'){for(let i=0;i<4;i++){const a=i*Math.PI/2+Math.PI/4;ctx.beginPath();ctx.arc(e.x+Math.cos(a)*(e.r+2),e.y+Math.sin(a)*(e.r+2),2.5,0,TAU);ctx.fill()}}else{for(let i=0;i<3;i++){const a=elapsed*1.2+i*TAU/3;ctx.beginPath();ctx.arc(e.x+Math.cos(a)*(e.r+7),e.y+Math.sin(a)*(e.r+7),2,0,TAU);ctx.fill()}}ctx.globalAlpha=1;ctx.textAlign='center';ctx.font='bold 8px system-ui';ctx.fillText(tr(({feral:'ELITE · FERAL',armored:'ELITE · ARMORED',volatile:'ELITE · VOLATILE'})[e.elite]),e.x,e.y-e.r-20);ctx.restore()}
 if(!e.boss&&e.hp<e.maxHp){let bw=e.r*2.4;ctx.fillStyle='#171a2c';ctx.fillRect(e.x-bw/2,e.y-e.r-10,bw,3);ctx.fillStyle=e.elite?(e.elite==='feral'?'#ff7698':e.elite==='armored'?'#ffd27c':'#b69aff'):col;ctx.fillRect(e.x-bw/2,e.y-e.r-10,bw*clamp(e.hp/e.maxHp,0,1),3)}
}
function drawRing(r){
 if(r.maxLife==null)r.maxLife=Math.max(.01,r.life);
 ctx.save();ctx.globalAlpha=clamp(r.life/r.maxLife,0,1)*(r.warning?.68:.8);
 ctx.strokeStyle=r.color;ctx.lineWidth=r.warning?2:3;ctx.shadowColor=r.color;ctx.shadowBlur=(r.warning?10:18)*renderProfile.glow;
 if(r.lineTo){ctx.setLineDash(r.warning?[9,7]:[5,5]);ctx.beginPath();ctx.moveTo(r.x,r.y);ctx.lineTo(r.lineTo.x,r.lineTo.y);ctx.stroke()}
 else{ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,TAU);ctx.stroke()}
 ctx.restore();
}
function drawOrb(o){ctx.save();ctx.shadowColor=o.color;ctx.shadowBlur=(18)*renderProfile.glow;ctx.fillStyle=o.color;ctx.beginPath();ctx.arc(o.x,o.y,o.r+Math.sin(elapsed*8+o.x)*1,0,TAU);ctx.fill();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(o.x-o.r*.25,o.y-o.r*.25,o.r*.35,0,TAU);ctx.fill();ctx.restore()}
function drawBolt(b){ctx.save();const speed=Math.hypot(b.vx||0,b.vy||0)||1,trail=Math.min(24,speed*.075);ctx.globalAlpha=.34;ctx.strokeStyle=b.color;ctx.lineWidth=Math.max(1.4,b.r*.72);ctx.lineCap='round';ctx.beginPath();ctx.moveTo(b.x-(b.vx||0)/speed*trail,b.y-(b.vy||0)/speed*trail);ctx.lineTo(b.x,b.y);ctx.stroke();ctx.globalAlpha=1;glow(b.x,b.y,b.r,b.color,11);ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(b.x-b.r*.2,b.y-b.r*.2,b.r*.28,0,TAU);ctx.fill();ctx.restore()}
function drawParticle(p){ctx.save();const fade=clamp(p.life/p.max,0,1);ctx.globalAlpha=fade;ctx.fillStyle=p.color;ctx.strokeStyle=p.color;ctx.shadowColor=p.color;ctx.shadowBlur=(p.ambient?4:9)*renderProfile.glow;if(p.streak){const speed=Math.hypot(p.vx||0,p.vy||0),len=Math.min(p.ambient?8:15,speed*(p.ambient?.07:.035));ctx.lineWidth=Math.max(.7,p.r*.7);ctx.lineCap='round';ctx.beginPath();ctx.moveTo(p.x-(p.vx||0)/(speed||1)*len,p.y-(p.vy||0)/(speed||1)*len);ctx.lineTo(p.x,p.y);ctx.stroke()}else{ctx.beginPath();ctx.arc(p.x,p.y,p.r*clamp(fade,.1,1),0,TAU);ctx.fill()}ctx.restore()}
function drawSlash(s){
 ctx.save();ctx.globalAlpha=clamp(s.life/s.max,0,1);ctx.strokeStyle=s.color||'#bafcff';ctx.lineCap='round';ctx.shadowColor=s.color||'#72f6ff';ctx.shadowBlur=(18)*renderProfile.glow;
 if(s.weapon==='riftlance'){
  const ex=s.x+Math.cos(s.a)*s.reach,ey=s.y+Math.sin(s.a)*s.reach;
  ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(s.x+Math.cos(s.a)*12,s.y+Math.sin(s.a)*12);ctx.lineTo(ex,ey);ctx.stroke();
  ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(s.x+Math.cos(s.a)*15,s.y+Math.sin(s.a)*15);ctx.lineTo(ex,ey);ctx.stroke();
 }else if(s.weapon==='twinfangs'){
  for(const side of [-1,1]){ctx.beginPath();ctx.arc(s.x,s.y,s.reach+side*5,s.a-s.arc/2+side*.13,s.a+s.arc/2+side*.13);ctx.lineWidth=3.5;ctx.stroke()}
 }else if(s.weapon==='duskcleaver'){
  ctx.lineWidth=8;ctx.beginPath();ctx.arc(s.x,s.y,s.reach,s.a-s.arc/2,s.a+s.arc/2);ctx.stroke();ctx.strokeStyle='#ffe5d8';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(s.x,s.y,s.reach-7,s.a-s.arc/2,s.a+s.arc/2);ctx.stroke();
 }else{
  // Aetherblade: align the energy crescent with the facing direction and originate it just beyond the weapon hand.
  const fx=Math.cos(s.a),fy=Math.sin(s.a),px=-fy,py=fx;
  const ox=s.x+fx*13,oy=s.y+fy*13;
  const pulse=1+(1-clamp(s.life/s.max,0,1))*.13;
  const rr=s.reach*pulse;
  ctx.save();ctx.translate(ox,oy);ctx.rotate(s.a);
  const grad=ctx.createLinearGradient(0,-rr*.72,0,rr*.72);
  grad.addColorStop(0,'#72f6ff00');grad.addColorStop(.18,'#72f6ffb8');grad.addColorStop(.5,'#e8ffff');grad.addColorStop(.82,'#72f6ffb8');grad.addColorStop(1,'#72f6ff00');
  ctx.globalAlpha*=.9;ctx.strokeStyle=grad;ctx.lineCap='round';ctx.shadowColor='#72f6ff';ctx.shadowBlur=28*renderProfile.glow;
  ctx.lineWidth=13;ctx.beginPath();ctx.moveTo(8,-rr*.46);ctx.quadraticCurveTo(rr*.58,-rr*.18,rr,0);ctx.quadraticCurveTo(rr*.58,rr*.18,8,rr*.46);ctx.stroke();
  ctx.strokeStyle='#ffffff';ctx.shadowBlur=12*renderProfile.glow;ctx.lineWidth=2.2;ctx.beginPath();ctx.moveTo(12,-rr*.31);ctx.quadraticCurveTo(rr*.65,-rr*.1,rr*.88,0);ctx.quadraticCurveTo(rr*.65,rr*.1,12,rr*.31);ctx.stroke();
  // Directional tip and trailing sparks make the wave read as a launched strike, not an offset arrow.
  ctx.fillStyle='#eaffff';ctx.shadowBlur=24*renderProfile.glow;ctx.beginPath();ctx.moveTo(rr+5,0);ctx.lineTo(rr-7,-7);ctx.lineTo(rr-3,0);ctx.lineTo(rr-7,7);ctx.closePath();ctx.fill();
  ctx.restore();
  // Subtle side filaments reinforce direction while staying inside the same attack lane.
  ctx.globalAlpha*=.72;ctx.strokeStyle='#72f6ff';ctx.lineWidth=1.6;ctx.shadowBlur=12*renderProfile.glow;
  ctx.beginPath();ctx.moveTo(ox+fx*rr*.25+px*rr*.22,oy+fy*rr*.25+py*rr*.22);ctx.lineTo(ox+fx*rr*.82+px*rr*.07,oy+fy*rr*.82+py*rr*.07);ctx.stroke();
  ctx.beginPath();ctx.moveTo(ox+fx*rr*.25-px*rr*.22,oy+fy*rr*.25-py*rr*.22);ctx.lineTo(ox+fx*rr*.82-px*rr*.07,oy+fy*rr*.82-py*rr*.07);ctx.stroke();
 }
 ctx.restore();
}
function drawFloating(f){ctx.save();ctx.globalAlpha=clamp(f.life/f.max,0,1);ctx.textAlign='center';ctx.font='bold 13px system-ui';ctx.shadowColor='#000';ctx.shadowBlur=(5)*renderProfile.glow;ctx.fillStyle=f.color;ctx.fillText(f.text,f.x,f.y);ctx.restore()}
function drawBossBar(){if(!boss)return;let bw=Math.min(360,W*.52),x=(W-bw)/2,y=44;ctx.fillStyle='#090c1bbf';ctx.fillRect(x,y,bw,8);let g=ctx.createLinearGradient(x,y,x+bw,y);g.addColorStop(0,boss.bossColor||'#ff477a');g.addColorStop(1,activeWorld().sigil);ctx.fillStyle=g;ctx.fillRect(x,y,bw*clamp(boss.hp/boss.maxHp,0,1),8);ctx.strokeStyle=(boss.bossColor||'#ff9cbe')+'88';ctx.strokeRect(x,y,bw,8);ctx.fillStyle='#ffcfdf';ctx.font='bold 10px system-ui';ctx.textAlign='center';const state=(boss.fractureTime>0?tr('FRACTURED'):boss.staggerTime>0?tr('STAGGERED'):boss.exposedTime>0?tr('WEAKPOINT OPEN'):boss.phaseTwo?tr('ENRAGED'):'');ctx.fillText((state?state+' · ':'')+tr(boss.bossName||'RIFT TITAN'),W/2,y-7);ctx.font='900 9px system-ui';ctx.fillStyle=boss.exposedTime>0?'#ffd27c':'#b9c8ec';ctx.fillText('PHASE '+String(boss.phaseStage||1)+' / 3'+(boss.exposedTime>0?' · EXPOSED '+boss.exposedTime.toFixed(1)+'s':''),W/2,y+22)}
function drawTitleScene(){let t=performance.now()/1000;ctx.save();ctx.globalAlpha=.7;for(let i=0;i<4;i++){ctx.beginPath();ctx.ellipse(W*.5,H*.52,Math.min(W,H)*(.12+i*.07),Math.min(W,H)*(.035+i*.026),t*.12*(i%2?1:-1),0,TAU);ctx.strokeStyle=i%2?((WORLDS[selectedWorldIndex]||WORLDS[0]).sigil+'33'):'#ad91ff2d';ctx.lineWidth=2;ctx.stroke()}glow(W*.5,H*.49,Math.min(W,H)*.065,(WORLDS[selectedWorldIndex]||WORLDS[0]).sigil,70);ctx.restore()}
// Keep the outer ring life opaque fade consistent.
const oldRingsPush=rings.push.bind(rings);rings.push=function(...items){for(const r of items)if(r.maxLife==null)r.maxLife=r.life;return oldRingsPush(...items)};
function loop(ts){if(!last)last=ts;const frameDt=Math.min(.05,(ts-last)/1000||0);last=ts;try{sampleAdaptiveQuality(frameDt,ts);if(hitStopTime>0){hitStopTime=Math.max(0,hitStopTime-frameDt);draw();requestAnimationFrame(loop);return}update(frameDt);draw()}catch(err){console.error('EMBERFALL frame recovered:',err);settings.quality='low';adaptiveTier='low';updateRenderProfile();try{resize();draw()}catch(drawErr){console.error('EMBERFALL render recovery failed:',drawErr)}}requestAnimationFrame(loop)}requestAnimationFrame(loop);
$('settingsMenuBtn').addEventListener('click',()=>openSettings('menu'));$('settingsPauseBtn').addEventListener('click',()=>openSettings('pause'));$('closeSettingsBtn').addEventListener('click',closeSettings);document.querySelectorAll('[data-quality]').forEach(b=>b.addEventListener('click',()=>{settings.quality=b.dataset.quality;if(!persistSettings())setSaveBackupNotice('Storage is unavailable.');renderSettings();sound(470,.06,'triangle',.02)}));$('volumeSlider').addEventListener('input',e=>{settings.volume=clamp(Number(e.target.value)||0,0,100);if(!persistSettings())setSaveBackupNotice('Storage is unavailable.');renderSettings()});$('settingsAudioToggle').addEventListener('click',toggleAudio);$('particlesToggle').addEventListener('click',()=>{settings.particles=!settings.particles;if(!persistSettings())setSaveBackupNotice('Storage is unavailable.');renderSettings();if(!settings.particles)particles=[]});$('shakeToggle').addEventListener('click',()=>{settings.shake=!settings.shake;if(!settings.shake)shakeTime=shakePower=0;if(!persistSettings())setSaveBackupNotice('Storage is unavailable.');renderSettings()});$('startBtn').addEventListener('click',()=>{const btn=$('startBtn');if(!WEAPONS[selectedWeapon])selectedWeapon='aetherblade';btn.disabled=true;try{freshRun();btn.disabled=false}catch(firstErr){console.error('EMBERFALL start failed; retrying safe profile:',firstErr);try{settings.quality='low';adaptiveTier='low';updateRenderProfile();resize();persistSettings();particles=[];freshRun();btn.disabled=false;announce(currentLanguage==='ar'?'تم التشغيل بوضع الأداء الآمن':currentLanguage==='tr'?'Güvenli performans modunda başlatıldı':'Started in safe performance mode')}catch(err){console.error('EMBERFALL safe start failed:',err);btn.disabled=false;btn.textContent=currentLanguage==='ar'?'تعذّر البدء — خفّض الجودة وأعد المحاولة':currentLanguage==='tr'?'Başlatılamadı — kaliteyi düşürüp tekrar dene':'Could not start — lower quality and retry';let box=$('startError');if(!box){box=document.createElement('p');box.id='startError';box.setAttribute('role','alert');box.style.cssText='color:#ff8ea8;font-size:12px;margin:8px 0';btn.insertAdjacentElement('afterend',box)}box.textContent=currentLanguage==='ar'?'تعذّر بدء الجولة. تم تفعيل وضع الأداء الآمن؛ أغلق النوافذ المفتوحة ثم أعد المحاولة.':currentLanguage==='tr'?'Oyun başlatılamadı. Güvenli performans modu etkin; açık pencereleri kapatıp tekrar deneyin.':'The run could not start. Safe performance mode is active; close open panels and retry.';}}});$('againBtn').addEventListener('click',freshRun);$('menuBtn').addEventListener('click',()=>{clearHeldControls();mode='menu';$('hud').style.display='none';['gameOverOverlay','pauseOverlay','levelOverlay','relicOverlay','worldOverlay','storeOverlay','legacyOverlay','settingsOverlay'].forEach(id=>$(id).style.display='none');$('startOverlay').style.display='flex';player=null;enemies=[];hazards=[];enemyBolts=[];boss=null});$('legacyMenuBtn').addEventListener('click',openLegacy);$('legacyPauseBtn').addEventListener('click',openLegacy);$('legacyOverBtn').addEventListener('click',openLegacy);$('closeLegacyBtn').addEventListener('click',closeLegacy);$('worldSelectBtn').addEventListener('click',showWorldMenu);$('closeWorldBtn').addEventListener('click',hideWorldMenu);$('pauseBtn').addEventListener('click',togglePause);$('resumeBtn').addEventListener('click',togglePause);$('restartFromPause').addEventListener('click',freshRun);$('audioMenuBtn').addEventListener('click',toggleAudio);$('pauseAudioBtn').addEventListener('click',toggleAudio);$('storeMenuBtn').addEventListener('click',openStore);$('storePauseBtn').addEventListener('click',openStore);$('storeOverBtn').addEventListener('click',openStore);$('closeStoreBtn').addEventListener('click',closeStore);$('storeResetHintBtn').addEventListener('click',()=>{storeNotice='Defeat enemies for 5–8 shards each. Titans award 45 shards. Every kill is saved to your local wallet.';renderStore()});
window.addEventListener('keydown',e=>{let k=e.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' ','shift'].includes(k))e.preventDefault();if($('settingsOverlay').style.display==='flex'){if(k==='escape')closeSettings();return}if($('legacyOverlay').style.display==='flex'){if(k==='escape')closeLegacy();return}if($('storeOverlay').style.display==='flex'){if(k==='escape')closeStore();return}keys[k]=true;if(k==='u'&&!e.repeat){voidRupture();keys[k]=false;return}if(k==='escape'||k==='p'){if(mode==='playing'||mode==='paused')togglePause()}if(k==='m'){toggleAudio();announce(audioOn?'AUDIO ENABLED':'AUDIO MUTED')}});window.addEventListener('keyup',e=>{keys[e.key.toLowerCase()]=false});
function clearHeldControls(){keys={};attackPointers.clear();touchAttack=false;joystick.x=joystick.y=0;joystick.pointer=null;const stick=$('stickNub');if(stick){stick.style.left='50%';stick.style.top='50%'}}
function pauseForFocusLoss(){clearHeldControls();if(mode==='playing'){mode='paused';$('pauseOverlay').style.display='flex';last=performance.now()}}
window.addEventListener('blur',pauseForFocusLoss);
document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseForFocusLoss()});
const attackPointers=new Set();function syncTouchAttack(){touchAttack=attackPointers.size>0}canvas.addEventListener('pointerdown',e=>{if(mode!=='playing')return;attackPointers.add(e.pointerId);syncTouchAttack();try{canvas.setPointerCapture(e.pointerId)}catch(_){}let rect=canvas.getBoundingClientRect(),x=(e.clientX-rect.left)/rect.width*W,y=(e.clientY-rect.top)/rect.height*H;if(player)player.face=Math.atan2(y-player.y,x-player.x)});window.addEventListener('pointerup',e=>{attackPointers.delete(e.pointerId);syncTouchAttack()});window.addEventListener('pointercancel',e=>{attackPointers.delete(e.pointerId);syncTouchAttack();if(attackPointers.size===0)clearHeldControls()});window.addEventListener('blur',()=>{attackPointers.clear();syncTouchAttack();clearHeldControls()});canvas.addEventListener('lostpointercapture',e=>{attackPointers.delete(e.pointerId);syncTouchAttack()});canvas.addEventListener('pointermove',e=>{if(mode!=='playing'||!attackPointers.has(e.pointerId))return;let rect=canvas.getBoundingClientRect(),x=(e.clientX-rect.left)/rect.width*W,y=(e.clientY-rect.top)/rect.height*H;if(player)player.face=Math.atan2(y-player.y,x-player.x)});
const zone=$('stickZone'),nub=$('stickNub');function stickMove(e){const r=zone.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2,dx=e.clientX-cx,dy=e.clientY-cy,max=r.width*.34,len=Math.hypot(dx,dy),m=Math.min(1,len/max);joystick.x=dx/(len||1)*m;joystick.y=dy/(len||1)*m;nub.style.left=`calc(50% + ${joystick.x*max}px)`;nub.style.top=`calc(50% + ${joystick.y*max}px)`}zone.addEventListener('pointerdown',e=>{e.preventDefault();joystick.pointer=e.pointerId;zone.setPointerCapture(e.pointerId);stickMove(e)});zone.addEventListener('pointermove',e=>{if(joystick.pointer===e.pointerId)stickMove(e)});function resetStick(){joystick.pointer=null;joystick.x=joystick.y=0;nub.style.left='50%';nub.style.top='50%'}zone.addEventListener('pointerup',resetStick);zone.addEventListener('pointercancel',resetStick);
function bindHold(id,down,up){let b=$(id);b.addEventListener('pointerdown',e=>{e.preventDefault();if(id==='attackBtn'){attackPointers.add(e.pointerId);syncTouchAttack()}else down();try{b.setPointerCapture(e.pointerId)}catch(_){}});b.addEventListener('pointerup',e=>{e.preventDefault();if(id==='attackBtn'){attackPointers.delete(e.pointerId);syncTouchAttack()}else if(up)up()});b.addEventListener('pointercancel',e=>{if(id==='attackBtn'){attackPointers.delete(e.pointerId);syncTouchAttack()}else if(up)up()});b.addEventListener('contextmenu',e=>e.preventDefault())}bindHold('attackBtn',()=>{},()=>{});bindHold('dashBtn',()=>dash());bindHold('specialBtn',()=>special());bindHold('voidRuptureBtn',()=>voidRupture());
document.querySelectorAll('[data-trial]').forEach(card=>card.addEventListener('click',()=>{selectedTrialIndex=clamp(Number(card.dataset.trial)||0,0,TRIALS.length-1);updateTrialUI();sound(440,.08,'triangle',.025)}));
updateTrialUI();
document.querySelectorAll('[data-doctrine]').forEach(card=>card.addEventListener('click',()=>selectDoctrine(card.dataset.doctrine)));updateDoctrineUI();

// Weapon selection is persisted locally and applies to the next run.
document.querySelectorAll('.weapon-card').forEach(card=>card.addEventListener('click',()=>selectWeapon(card.dataset.weapon)));
updateWeaponMenu();buildWorldMenu();updateWalletUI();renderStore();renderLegacy();updateLegacyBadge();renderSettings();applyLanguage(currentLanguage,false);
// Prevent double-trigger from desktop action buttons and set friendly focus behavior.
for(const id of ['attackBtn','dashBtn','specialBtn','voidRuptureBtn'])$(id).addEventListener('click',e=>e.preventDefault());

// v1.1.0: fallback for mobile webviews that do not synthesize click after a touch.
// It only replays a missed click on ordinary controls; hold-to-act game buttons are excluded.
(function installTouchClickFallback(){
  const selector='button:not(:disabled),[role="button"],input:not(:disabled),select:not(:disabled),a[href]';
  const clickAt=new WeakMap();
  const isHoldAction=el=>!!(el&&el.matches&&el.matches('#attackBtn,#dashBtn,#specialBtn,#voidRuptureBtn'));
  document.addEventListener('click',e=>{
    const el=e.target&&e.target.closest?e.target.closest(selector):null;
    if(el)clickAt.set(el,performance.now());
  },true);
  document.addEventListener('pointerup',e=>{
    if(e.pointerType!=='touch'&&e.pointerType!=='pen')return;
    const el=e.target&&e.target.closest?e.target.closest(selector):null;
    if(!el||el.disabled||isHoldAction(el))return;
    const upAt=performance.now();
    setTimeout(()=>{
      if(!el.isConnected||el.disabled||!el.getClientRects().length)return;
      // If the browser already emitted a click for this same tap, do nothing.
      if((clickAt.get(el)||0)<upAt)el.click();
    },260);
  },true);
})();

