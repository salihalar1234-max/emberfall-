Object.assign(I18N.tr,{'Piercing thrusts strike through a line of foes; later targets take reduced damage.':'Delici saplamalar düşman sırasını deler; sonraki hedefler daha az hasar alır.',
'POWER 3 · SPEED 3 · REACH 3':'GÜÇ 3 · HIZ 3 · MENZİL 3','POWER 2 · SPEED 5 · REACH 2':'GÜÇ 2 · HIZ 5 · MENZİL 2','POWER 5 · SPEED 1 · REACH 4':'GÜÇ 5 · HIZ 1 · MENZİL 4','POWER 3 · SPEED 3 · REACH 5':'GÜÇ 3 · HIZ 3 · MENZİL 5','Aetherblade':'Eter Kılıcı','Twin Fangs':'İkiz Dişler','Dusk Cleaver':'Alacakaranlık Yarıcısı','Rift Lance':'Yarık Mızrağı','SELECTED · AETHERBLADE — balanced blade combat':'SEÇİLİ · ETER KILICI — dengeli kılıç dövüşü','REALM I · BEGIN THE STORY':'DİYAR I · HİKÂYEYE BAŞLA','PERSONAL RECORD: WAVE 01':'KİŞİSEL REKOR: DALGA 01','VERSION 2.17.0 · STAGE 34 · SKIRMISHER CHARGE COLLISION':'SÜRÜM 2.17.0 · 33. Aşama: Kusursuz Atılma Karşılığı','▱ Saver':'▱ Tasarruf','◈ Balanced':'◈ Dengeli','✦ Cinematic':'✦ Sinematik','ON':'AÇIK','OFF':'KAPALI','THE RIFT REWARDS THE STRONG':'YARIK GÜÇLÜLERİ ÖDÜLLENDİRİR','CHOOSE YOUR EVOLUTION':'GELİŞİMİNİ SEÇ','THE WORLD WAITS WHILE YOU CHOOSE':'SEN SEÇERKEN DÜNYA BEKLİYOR','RIFT ARENA · THREE REALMS':'YARIK ARENASI · ÜÇ DİYAR','REALM · ASHEN VERGE':'DİYAR · KÜL SINIRI','STYLE · AETHERBLADE':'TARZ · ETER KILICI','DAILY CONTRACTS · TODAY':'GÜNLÜK GÖREVLER · BUGÜN','UNSEALED · START AT WAVE':'AÇILDI · ŞU DALGADAN BAŞLA','DEFEAT THE RIFT TITAN · WAVE 05':'YARIK TİTANINI YEN · 05. DALGA','DEFEAT THE THORN TITAN · WAVE 10':'DİKEN TİTANINI YEN · 10. DALGA'
