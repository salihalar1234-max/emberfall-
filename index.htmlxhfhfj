  <div><div class="brand">EMBER<span>FALL</span></div><div class="mini">RIFT ARENA · THREE REALMS</div><div class="bars"><div class="barline"><span>VITAL</span><div class="bar"><div class="fill hpfill" id="hpFill"></div></div><b id="hpText">100 / 100</b></div><div class="barline"><span>ESSENCE</span><div class="bar"><div class="fill xpfill" id="xpFill" style="width:0%"></div></div><b id="xpText">0 / 30</b></div><div class="barline"><span>RESONANCE</span><div class="bar"><div class="fill resonancefill" id="resonanceFill" style="width:0%"></div></div><b id="resonanceText">0 / 3</b></div></div><div class="weaponhud" id="weaponHud">STYLE · AETHERBLADE</div><div class="weaponhud" id="realmHud">REALM · ASHEN VERGE</div><div class="weaponhud trialhud" id="trialHud">TRIAL · STANDARD · ×1.0</div><div class="weaponhud" id="relicHud">RIFT RELICS · 0 / 7</div><div class="weaponhud" id="bossCoreHud">ECLIPSE CORES · 0 · BREAK A TITAN CAST TO EARN</div><div class="weaponhud comboHud" id="comboHud" style="display:none">RIFT CHAIN · ×1</div><div class="weaponhud" id="doctrineHud">PATH · CINDER DUELIST</div></div>
  <div class="stats"><div class="stat"><small>WAVE</small><b id="waveText">01</b></div><div class="stat"><small>LEVEL</small><b id="levelText">01</b></div><div class="stat"><small>SHARDS</small><b id="shardsText">000</b></div><div class="stat core-stat"><small id="coreLabel">ECLIPSE CORES</small><b id="coresText">0</b></div><button class="iconbtn" id="pauseBtn" aria-label="Pause">Ⅱ</button></div>
 </div>
 <div id="campaignHud" style="display:none;position:absolute;left:50%;top:calc(env(safe-area-inset-top,0px) + 78px);transform:translateX(-50%);z-index:8;width:min(92%,430px);padding:8px 12px;border:1px solid rgba(114,246,255,.28);border-radius:12px;background:rgba(7,10,24,.82);backdrop-filter:blur(8px);pointer-events:none;text-align:center"><b id="campaignChapter" style="display:block;color:#72f6ff;font-size:11px;letter-spacing:.12em">CHAPTER I · ASHEN VERGE</b><small id="campaignGoal" style="display:block;color:#c1cce8;font-size:10px;margin-top:3px">Campaign objective</small><div style="height:3px;background:#1b2440;border-radius:9px;margin-top:7px;overflow:hidden"><div id="campaignProgress" style="height:100%;width:0;background:linear-gradient(90deg,#72f6ff,#a58bff)"></div></div></div>
