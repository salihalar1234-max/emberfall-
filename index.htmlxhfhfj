let enemyBolts=[];function updateArray(a,dt,fn){for(let i=a.length-1;i>=0;i--){fn(a[i]);if(a[i].life<=0)a.splice(i,1)}}
function drawCombatReadability(){
 // Combat-readability layer: telegraphs and health cues are visual-only; they never alter combat rules.
 if(mode!=='playing')return;
 ctx.save();
 // Boss wind-up: show the committed aim point and attack lane so players can react fairly.
 if(boss&&boss.windup>0&&Number.isFinite(boss.aimX)&&Number.isFinite(boss.aimY)){
  const left=clamp(boss.windup/(boss.phaseStage>=3?.52:boss.phaseTwo?.61:.86),0,1);
  const col=boss.bossColor||'#ff5c97';
  ctx.save();ctx.setLineDash([7,6]);ctx.lineWidth=1.5;ctx.strokeStyle=col;ctx.globalAlpha=.22+.34*(1-left);
  ctx.beginPath();ctx.moveTo(boss.x,boss.y);ctx.lineTo(boss.aimX,boss.aimY);ctx.stroke();ctx.setLineDash([]);
  const pulse=1.0+0.14*Math.sin(elapsed*18);
  ctx.translate(boss.aimX,boss.aimY);ctx.scale(pulse,pulse);ctx.globalAlpha=.36+.32*(1-left);ctx.strokeStyle=col;ctx.lineWidth=2;
  ctx.beginPath();ctx.arc(0,0,19+5*(1-left),0,TAU);ctx.stroke();ctx.beginPath();ctx.moveTo(-27,0);ctx.lineTo(-11,0);ctx.moveTo(11,0);ctx.lineTo(27,0);ctx.moveTo(0,-27);ctx.lineTo(0,-11);ctx.moveTo(0,11);ctx.lineTo(0,27);ctx.stroke();
  ctx.restore();
 }
 // Show compact health bars for elites, bosses, and enemies recently struck; avoid clutter on untouched mobs.
 for(const e of enemies){
  if(!e||!Number.isFinite(e.hp)||!Number.isFinite(e.maxHp)||e.maxHp<=0)continue;
  const recentlyHit=(e.flash||0)>.015;
  if(!e.boss&&!e.elite&&!recentlyHit)continue;
  const width=e.boss?Math.max(48,e.r*2.25):Math.max(28,e.r*1.75),height=e.boss?5:3.5;
  const x=e.x-width/2,y=e.y-e.r-(e.boss?18:10),ratio=clamp(e.hp/e.maxHp,0,1);
  ctx.globalAlpha=e.boss? .92 : (e.elite?.86:.68);
  ctx.fillStyle='rgba(3,6,18,.86)';ctx.fillRect(x-1,y-1,width+2,height+2);
  ctx.fillStyle=e.boss?(e.bossColor||'#ff5c97'):e.elite==='armored'?'#ffd27c':e.elite==='volatile'?'#b69aff':'#ff7698';
  ctx.fillRect(x,y,width*ratio,height);
  if(e.boss){ctx.globalAlpha=.75;ctx.strokeStyle=e.bossColor||'#ff5c97';ctx.lineWidth=1;ctx.strokeRect(x-.5,y-.5,width+1,height+1)}
 }
 // Brief low-health edge cue. Kept subtle and disabled with reduced-motion preference.
 if(player&&player.maxHp>0&&player.hp/player.maxHp<.28&&!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  const urgency=clamp((.28-player.hp/player.maxHp)/.28,0,1),pulse=.5+.5*Math.sin(elapsed*5);
  ctx.globalAlpha=.045+urgency*(.045+.025*pulse);ctx.strokeStyle='#ff365f';ctx.lineWidth=18;
  ctx.strokeRect(8,8,Math.max(1,W-16),Math.max(1,H-16));
 }
 ctx.restore();
}
function draw(){ctx.save();let sx=0,sy=0;if(settings.shake&&shakeTime>0&&mode==='playing'){const f=shakeTime/.14;sx=rand(-shakePower,shakePower)*f;sy=rand(-shakePower,shakePower)*f}ctx.translate(sx,sy);ctx.clearRect(-10,-10,W+20,H+20);const theme=activeWorld();let bg=ctx.createRadialGradient(W*.5,H*.45,20,W*.5,H*.5,Math.max(W,H)*.72);bg.addColorStop(0,theme.bg[0]);bg.addColorStop(.48,theme.bg[1]);bg.addColorStop(1,theme.bg[2]);ctx.fillStyle=bg;ctx.fillRect(-10,-10,W+20,H+20);drawAtmosphere(theme);drawArena();for(const mark of impactMarks)drawImpactMark(mark);for(let h of hazards)drawHazard(h);for(let r of rings)drawRing(r);for(let o of orbs)drawOrb(o);for(let b of enemyBolts)drawBolt(b);for(let e of enemies)drawEnemy(e);for(const echo of dashEchoes)drawDashEcho(echo);if(player)drawPlayer();for(let p of particles)drawParticle(p);for(let s of slashes)drawSlash(s);for(let f of floaters)drawFloating(f);drawCombatReadability();if(boss&&mode!=='menu'){drawBossBar()}if(mode==='menu')drawTitleScene();ctx.restore()}
function drawAtmosphere(theme){
 // Cinematic ambience is deterministic and draw-only, so it cannot affect combat or saves.
 ctx.save();
 const count=settings.quality==='low'?10:settings.quality==='balanced'?18:30;
 const span=Math.max(1,W+80),height=Math.max(1,H+40);
 for(let i=0;i<count;i++){
  const seed=i*127.1+19.7;
  const drift=(elapsed*(5+(i%5)*1.7)+(seed*13))%span;
  const x=drift-40;
  const y=((seed*37+elapsed*(2+(i%4)*.8))%height)-20;
  const pulse=.35+.45*(.5+.5*Math.sin(elapsed*1.7+i*2.1));
  const r=.6+(i%3)*.35;
  ctx.globalAlpha=pulse*(settings.particles?.75:.25);
  ctx.fillStyle=i%4===0?theme.sigil:(i%3===0?'#ffb66e':theme.particle);
  ctx.shadowColor=ctx.fillStyle;ctx.shadowBlur=(settings.quality==='high'?8:3)*renderProfile.glow;
  ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();
 }
 ctx.globalAlpha=1;ctx.shadowBlur=0;
 // Soft edge falloff adds depth without hiding the arena or HUD.
 const radius=Math.max(W,H)*.18;
 const vignette=ctx.createRadialGradient(W*.5,H*.48,radius,W*.5,H*.5,Math.max(W,H)*.76);
 vignette.addColorStop(0,'rgba(0,0,0,0)');vignette.addColorStop(.72,'rgba(2,4,14,.08)');vignette.addColorStop(1,'rgba(2,4,14,.38)');
 ctx.fillStyle=vignette;ctx.fillRect(0,0,W,H);
 ctx.restore();
}
function drawArena(){const theme=activeWorld(),wi=activeWorldIndex();ctx.save();let spacing=48,offset=(elapsed*4)%spacing;ctx.strokeStyle=theme.grid;ctx.lineWidth=1;for(let x=(W/2)%spacing-offset;x<W;x+=spacing){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke()}for(let y=(H/2)%spacing-offset;y<H;y+=spacing){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}ctx.strokeStyle=theme.border;ctx.lineWidth=2;ctx.strokeRect(17,17,W-34,H-34);ctx.save();ctx.globalAlpha=.10;ctx.strokeStyle=theme.border;ctx.lineWidth=1;for(let i=0;i<18;i++){const px=34+((i*149+73)%(Math.max(1,W-68))),py=35+((i*97+41)%(Math.max(1,H-70))),len=7+(i%5)*2,dir=(i%4)*Math.PI/2+.23*(i%3);ctx.beginPath();ctx.moveTo(px,py);ctx.lineTo(px+Math.cos(dir)*len,py+Math.sin(dir)*len);ctx.lineTo(px+Math.cos(dir)*len+Math.cos(dir+1.1)*4,py+Math.sin(dir)*len+Math.sin(dir+1.1)*4);ctx.stroke();if(i%3===0){ctx.fillStyle=theme.particle;ctx.fillRect(px+5,py+3,2,2)}}ctx.restore();for(let i=0;i<4;i++){let x=i%2===0?25:W-25,y=i<2?25:H-25;ctx.shadowBlur=(17)*renderProfile.glow;ctx.shadowColor=theme.sigil;ctx.strokeStyle=theme.sigil+'aa';ctx.beginPath();ctx.arc(x,y,9+Math.sin(elapsed*2+i)*2,0,TAU);ctx.stroke()}ctx.restore();
 if(wi===1){ctx.save();ctx.globalAlpha=.35;ctx.strokeStyle='#5acb8a';ctx.lineWidth=2;for(let i=0;i<9;i++){const side=i%2===0?1:-1,x=side>0?20+(i*29)%(W*.13):W-20-(i*31)%(W*.13),y=(i*97+38)%(H-70)+35;ctx.beginPath();ctx.moveTo(x,y+35);ctx.bezierCurveTo(x+side*18,y+10,x-side*13,y-7,x+side*4,y-28);ctx.stroke();ctx.beginPath();ctx.ellipse(x+side*10,y+6,7,13,side*.65,0,TAU);ctx.stroke()}ctx.restore()}
 else if(wi===2){ctx.save();ctx.globalAlpha=.38;ctx.strokeStyle='#78cbff';ctx.fillStyle='#76c8ff17';ctx.lineWidth=2;for(let i=0;i<8;i++){const side=i%2===0?1:-1,x=side>0?29+(i*37)%(W*.12):W-29-(i*41)%(W*.12),y=(i*113+48)%(H-90)+45,h=22+(i%3)*12;ctx.beginPath();ctx.moveTo(x-h*.34,y+h*.6);ctx.lineTo(x,y-h);ctx.lineTo(x+h*.29,y+h*.6);ctx.closePath();ctx.fill();ctx.stroke();ctx.beginPath();ctx.moveTo(x,y-h);ctx.lineTo(x+2,y+h*.5);ctx.stroke()}ctx.restore()}
 // Realm Sanctum: a distinctive, low-cost sigil anchors each arena without affecting combat.
 const cx=W*.5,cy=H*.5,rad=Math.min(W,H)*.145,pulse=1+Math.sin(elapsed*1.35)*.025;
 ctx.save();ctx.translate(cx,cy);ctx.rotate(elapsed*(wi===1?-.035:.018));ctx.globalAlpha= boss ? .24 : .14;ctx.strokeStyle=theme.sigil;ctx.fillStyle=theme.sigil;ctx.lineWidth=1.4;
 ctx.shadowColor=theme.sigil;ctx.shadowBlur=8*renderProfile.glow;
 for(let ring=0;ring<3;ring++){ctx.beginPath();ctx.arc(0,0,rad*(.56+ring*.22)*pulse,0,TAU);ctx.stroke()}
 if(wi===0){for(let i=0;i<8;i++){const a=i*TAU/8;ctx.beginPath();ctx.moveTo(Math.cos(a)*rad*.48,Math.sin(a)*rad*.48);ctx.lineTo(Math.cos(a+.13)*rad*.98,Math.sin(a+.13)*rad*.98);ctx.stroke()}ctx.beginPath();ctx.moveTo(0,-rad*.38);ctx.lineTo(rad*.34,rad*.28);ctx.lineTo(-rad*.34,rad*.28);ctx.closePath();ctx.stroke()}
 else if(wi===1){for(let i=0;i<6;i++){const a=i*TAU/6+elapsed*.08;ctx.beginPath();ctx.ellipse(Math.cos(a)*rad*.42,Math.sin(a)*rad*.42,rad*.16,rad*.34,a,0,TAU);ctx.stroke()}ctx.beginPath();ctx.arc(0,0,rad*.25,0,TAU);ctx.stroke()}
 else{for(let i=0;i<8;i++){const a=i*TAU/8;ctx.beginPath();ctx.moveTo(Math.cos(a)*rad*.24,Math.sin(a)*rad*.24);ctx.lineTo(Math.cos(a)*rad*.95,Math.sin(a)*rad*.95);ctx.stroke()}ctx.beginPath();ctx.moveTo(0,-rad*.46);ctx.lineTo(rad*.4,0);ctx.lineTo(0,rad*.46);ctx.lineTo(-rad*.4,0);ctx.closePath();ctx.stroke()}
 ctx.restore();
 for(let i=0;i<9;i++){let x=(i*137+W*.12)%W,y=(i*83+H*.12)%H;ctx.globalAlpha=.14+Math.sin(elapsed*.4+i)*.06;ctx.fillStyle=theme.particle;ctx.fillRect(x,y,2,2)}ctx.globalAlpha=1}

function glow(x,y,r,color,blur=20){ctx.save();ctx.shadowColor=color;ctx.shadowBlur=(blur)*renderProfile.glow;ctx.fillStyle=color;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();ctx.restore()}
