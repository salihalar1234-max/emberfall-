// v2.6.0: grounded combat improvements; 12-chapter campaign progression. Chapters use existing realms, while objectives and progression persist locally.
const CAMPAIGN_KEY='emberfall_campaign_v24';
const CAMPAIGN_CHAPTERS=[
 {name:'ASHEN VERGE',goal:'Defeat 18 Riftborn and survive the first Titan.',target:18,realm:0},
 {name:'CINDER CATACOMBS',goal:'Defeat 22 Riftborn; keep moving through the emberfall.',target:22,realm:0},
 {name:'GLASSWASTE',goal:'Defeat 26 Riftborn and break the second Titan.',target:26,realm:0},
 {name:'GLOAMWOOD OUTSKIRTS',goal:'Defeat 28 Riftborn beneath the living canopy.',target:28,realm:1},
 {name:'BRAMBLE HEART',goal:'Defeat 30 Riftborn and survive the Thorn Titan.',target:30,realm:1},
 {name:'ROOTBOUND SANCTUM',goal:'Defeat 32 Riftborn; escape the bramble blooms.',target:32,realm:1},
 {name:'FROSTVEIN PASS',goal:'Defeat 34 Riftborn in the endless storm.',target:34,realm:2},
 {name:'THE SILENT CROWN',goal:'Defeat 36 Riftborn and face the Frost Titan.',target:36,realm:2},
 {name:'WHITEOUT VAULT',goal:'Defeat 38 Riftborn while avoiding frostfall.',target:38,realm:2},
 {name:'RIFTWOUND ABYSS',goal:'Defeat 40 Riftborn and survive the empowered Titan.',target:40,realm:0},
 {name:'ECLIPSE ENGINE',goal:'Defeat 42 Riftborn; the Rift is destabilizing.',target:42,realm:1},
 {name:'THE LAST DAWN',goal:'Defeat 45 Riftborn and shatter the final Titan.',target:45,realm:2}
];
let campaignData={highestWave:1,completed:false,claimed:[],chapterKills:0,chapterBoss:false,chapterIndex:0};
function loadCampaign(){try{const d=JSON.parse(localStorage.getItem(CAMPAIGN_KEY)||'{}');campaignData.highestWave=clamp(Number.isSafeInteger(d.highestWave)?d.highestWave:1,1,100000);campaignData.completed=d.completed===true;campaignData.claimed=Array.isArray(d.claimed)?[...new Set(d.claimed.filter(n=>Number.isInteger(n)&&n>=0&&n<CAMPAIGN_CHAPTERS.length))]:[];campaignData.chapterIndex=clamp(Number.isInteger(d.chapterIndex)?d.chapterIndex:0,0,CAMPAIGN_CHAPTERS.length-1);campaignData.chapterKills=clamp(Number.isSafeInteger(d.chapterKills)?d.chapterKills:0,0,1000);campaignData.chapterBoss=d.chapterBoss===true;if(campaignData.claimed.includes(campaignData.chapterIndex)){campaignData.chapterKills=0;campaignData.chapterBoss=false;}}catch(e){campaignData.chapterKills=0;campaignData.chapterBoss=false;} }
function saveCampaign(){try{localStorage.setItem(CAMPAIGN_KEY,JSON.stringify({highestWave:campaignData.highestWave,completed:campaignData.completed,claimed:campaignData.claimed,chapterIndex:campaignData.chapterIndex,chapterKills:campaignData.chapterKills,chapterBoss:campaignData.chapterBoss}))}catch(e){}}
function campaignChapterIndex(wave){return clamp(Math.floor((Math.max(1,wave)-1)/5),0,CAMPAIGN_CHAPTERS.length-1)}
function campaignUpdate(wave,announceChange=false){const idx=campaignChapterIndex(wave),ch=CAMPAIGN_CHAPTERS[idx];if(campaignData.chapterIndex!==idx){campaignData.chapterKills=0;campaignData.chapterBoss=false;}campaignData.chapterIndex=idx;const title=$('campaignChapter'),goal=$('campaignGoal'),bar=$('campaignProgress');if(title)title.textContent=tr('CHAPTER')+' '+['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'][idx]+' · '+tr(ch.name);if(goal)goal.textContent=tr(ch.goal)+(campaignData.claimed.includes(idx)?' · '+tr('CLEARED'):'');if(bar)bar.style.width=(Math.min(5,((wave-1)%5)+1)/5*100)+'%';if(announceChange&&wave>1&&wave%5===1)announce(tr('CAMPAIGN CHAPTER')+' '+(idx+1)+' · '+tr(ch.name));}
function campaignKill(enemy){const idx=campaignChapterIndex(player?player.wave:1),ch=CAMPAIGN_CHAPTERS[idx];if(campaignData.chapterIndex!==idx){campaignData.chapterIndex=idx;campaignData.chapterKills=0;campaignData.chapterBoss=false;}if(!enemy.boss)campaignData.chapterKills++;else campaignData.chapterBoss=true;if(!campaignData.claimed.includes(idx)&&campaignData.chapterKills>=ch.target&&campaignData.chapterBoss){const reward=180+idx*35,nextWallet=Math.min(999999999,walletShards+reward),nextClaimed=[...campaignData.claimed,idx],nextCampaign={highestWave:campaignData.highestWave,completed:campaignData.completed,claimed:nextClaimed,chapterIndex:idx,chapterKills:campaignData.chapterKills,chapterBoss:campaignData.chapterBoss};if(writeStorageTransaction({[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores),[CAMPAIGN_KEY]:JSON.stringify(nextCampaign)})){walletShards=nextWallet;campaignData.claimed=nextClaimed;updateWalletUI();announce(tr('CHAPTER CONTRACT CLEARED')+' · +'+reward+' '+tr('SHARDS'));}else{campaignData.chapterKills=Math.max(0,ch.target-1);campaignData.chapterBoss=false;announce('SAVE FAILED · CHAPTER REWARD NOT CLAIMED');}}saveCampaign();campaignUpdate(player?player.wave:1);}
loadCampaign();
function campaignMenuRefresh(){const el=$('campaignMenuProgress');if(el)el.textContent=tr('BEST CAMPAIGN WAVE')+': '+String(campaignData.highestWave).padStart(2,'0')+' · '+tr('CHAPTERS CLEARED')+': '+campaignData.claimed.length+'/12'+(campaignData.completed?' · '+tr('CAMPAIGN COMPLETE'):'');}
campaignMenuRefresh();
