  ctx.strokeStyle=col;ctx.lineWidth=2.7;ctx.beginPath();ctx.moveTo(9,-6);ctx.lineTo(30,-17);ctx.moveTo(9,7);ctx.lineTo(30,17);ctx.stroke();
  ctx.fillStyle='#fff1bf';ctx.beginPath();ctx.moveTo(30,-17);ctx.lineTo(25,-15);ctx.lineTo(27,-11);ctx.moveTo(30,17);ctx.lineTo(25,15);ctx.lineTo(27,11);ctx.fill();
