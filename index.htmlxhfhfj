const TRIAL_SELECTION_KEY='emberfall_trial_v14';
let selectedTrialIndex=(()=>{try{const id=localStorage.getItem(TRIAL_SELECTION_KEY),index=TRIALS.findIndex(t=>t.id===id);return index>=0?index:0}catch(e){return 0}})();
function activeTrial(){return TRIALS[clamp(selectedTrialIndex,0,TRIALS.length-1)]}
function trialRules(){return activeTrial()}
function updateTrialUI(){
 const trial=activeTrial();try{localStorage.setItem(TRIAL_SELECTION_KEY,trial.id)}catch(e){}document.querySelectorAll('[data-trial]').forEach(b=>{const selected=Number(b.dataset.trial)===selectedTrialIndex;b.classList.toggle('selected',selected);b.setAttribute('aria-pressed',String(selected))});
 const summary=$('trialSummary');if(summary)summary.textContent=tr('SELECTED TRIAL')+' · '+tr(trial.title)+' · '+tr('SHARD MULTIPLIER')+' ×'+trial.reward.toFixed(2).replace(/0$/,'');
}

const WALLET_KEY='emberfall_wallet_shards_v06',STORE_KEY='emberfall_store_ranks_v06';
let walletShards=0,eclipseCores=0,storeRanks={vitality:0,blade:0,dash:0,rift:0,magnet:0},storeNotice='Your purchases are saved locally in this browser.';
const STORE_ITEMS=[
 {id:'vitality',icon:'✚',name:'Vitality Matrix',desc:'+15 maximum HP per rank. Start each run at full vitality.',color:'#ff7e9c',max:5,base:45,step:20},
 {id:'blade',icon:'⚔',name:'Rune of Ruin',desc:'+8% base weapon damage per rank. Stacks with run upgrades.',color:'#72f6ff',max:5,base:60,step:28},
 {id:'dash',icon:'➤',name:'Phase Cell',desc:'Dash recovers 8% faster per rank, up to four ranks.',color:'#a58bff',max:4,base:55,step:25},
 {id:'rift',icon:'✦',name:'Rift Capacitor',desc:'+10% Rift Burst damage per rank.',color:'#d58aff',max:4,base:70,step:30},
 {id:'magnet',icon:'◉',name:'Soul Magnet',desc:'Essence orbs begin pulling toward you from farther away.',color:'#ffd27c',max:3,base:40,step:20}
];
function loadEconomy(){
 try{
  walletShards=storedInt(localStorage.getItem(WALLET_KEY),0,0,999999999);
  eclipseCores=storedInt(localStorage.getItem(CORE_KEY),0,0,1000000);
  const rawValue=JSON.parse(localStorage.getItem(STORE_KEY)||'{}');
  const raw=rawValue&&typeof rawValue==='object'&&!Array.isArray(rawValue)?rawValue:{};
  for(const item of STORE_ITEMS)storeRanks[item.id]=storedInt(raw[item.id],0,0,item.max);
 }catch(e){walletShards=0;eclipseCores=0;storeRanks={vitality:0,blade:0,dash:0,rift:0,magnet:0}}
}
function writeStorageTransaction(entries){const before={};try{for(const key of Object.keys(entries))before[key]=localStorage.getItem(key);for(const [key,value] of Object.entries(entries)){if(value===null)localStorage.removeItem(key);else localStorage.setItem(key,String(value))}return true}catch(e){for(const [key,value] of Object.entries(before)){try{if(value===null)localStorage.removeItem(key);else localStorage.setItem(key,value)}catch(_){}}return false}}
function saveEconomy(){const ok=writeStorageTransaction({[WALLET_KEY]:String(walletShards),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores)});if(!ok)storeNotice='Browser storage is unavailable; changes may not persist after closing the page.';return ok}
function storeCost(item){return item.base+item.step*storeRanks[item.id]}
function updateWalletUI(){if($('walletMenu'))$('walletMenu').textContent=String(walletShards);if($('storeBalance'))$('storeBalance').textContent=String(walletShards);if($('shardsText'))$('shardsText').textContent=String(walletShards);if($('coresText'))$('coresText').textContent=String(eclipseCores);if($('coreMenu'))$('coreMenu').textContent=String(eclipseCores);if($('bossCoreHud'))$('bossCoreHud').textContent=tr('ECLIPSE CORES')+' · '+eclipseCores+' · '+tr('BREAK A TITAN CAST TO EARN');if(player)player.shards=walletShards}
function escapeHTML(value){return String(value).replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[ch]));}

const SUPPORTER_PRODUCT_ID='emberfall_supporter_pack';
const REWARDED_AD_LIMIT=3;
const DAILY_GIFT_KEY='emberfall_daily_gift_v01';
let dailyDoublePending=false,rewardedAdPending=false;
function localDayKey(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function dailyRewardAmount(streak){const index=Math.floor(Number(streak)||0);return [50,60,70,80,100,120,150][Math.max(0,Math.min(6,index))]}
function loadDailyRewardState(){try{const d=JSON.parse(localStorage.getItem(DAILY_GIFT_KEY)||'{}');if(!d||typeof d!=='object'||Array.isArray(d))return {date:'',previousDate:'',streak:0,claimed:false,doubled:false};const validDate=v=>typeof v==='string'&&(v===''||( /^\d{4}-\d{2}-\d{2}$/.test(v)&&Number.isFinite(Date.parse(v+'T00:00:00Z'))&&new Date(v+'T00:00:00Z').toISOString().slice(0,10)===v));const rawStreak=Number(d.streak);return {date:validDate(d.date)?d.date:'',previousDate:validDate(d.previousDate)?d.previousDate:'',streak:Number.isFinite(rawStreak)?Math.max(0,Math.min(6,Math.floor(rawStreak))):0,claimed:d.claimed===true,doubled:d.doubled===true&&d.claimed===true}}catch(e){return {date:'',previousDate:'',streak:0,claimed:false,doubled:false}}}
function saveDailyRewardState(d){try{localStorage.setItem(DAILY_GIFT_KEY,JSON.stringify(d));return true}catch(e){return false}}
function claimDailyShardGift(){const today=localDayKey(),d=loadDailyRewardState();if(d.date===today&&d.claimed)return;const prev=new Date();prev.setDate(prev.getDate()-1);const y=prev.getFullYear()+'-'+String(prev.getMonth()+1).padStart(2,'0')+'-'+String(prev.getDate()).padStart(2,'0');const streak=d.date===y?Math.min(6,d.streak+1):0;const amount=dailyRewardAmount(streak),next={date:today,previousDate:d.date,streak,claimed:true,doubled:false},nextWallet=Math.min(999999999,walletShards+amount);if(!writeStorageTransaction({[DAILY_GIFT_KEY]:JSON.stringify(next),[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores)})){storeNotice=tr('Storage is unavailable.');renderRevenuePanel();return}walletShards=nextWallet;updateWalletUI();storeNotice=tr('DAILY GIFT CLAIMED')+' · +'+amount+' '+tr('SHARDS');renderStore();sound(760,.13,'triangle',.035)}
let monetizationState={productAvailable:false,supporterOwned:false,supporterPrice:'',purchaseStatus:'product_not_configured',adsReady:false,adStatus:'reward_ad_not_ready',rewardCount:0,rewardLimit:REWARDED_AD_LIMIT,privacyOptionsRequired:false};
function monetizationStatusKey(code){const keys={ready:'REWARD AD READY',product_ready:'PRODUCT AVAILABLE',ad_ready:'REWARD AD READY',loading:'REWARD AD LOADING',limit:'REWARD ADS DAILY LIMIT REACHED',unavailable:'REWARD AD NOT READY',granted:'REWARD AD GRANTED',not_completed:'REWARD AD NOT COMPLETED',owned:'PURCHASE OWNED',product_not_configured:'PRODUCT NOT CONFIGURED',product_unavailable:'PRODUCT UNAVAILABLE',connecting:'BILLING CONNECTING',cancelled:'PURCHASE CANCELLED',purchased:'PURCHASE COMPLETE · COSMETIC UNLOCKED',pending:'PURCHASE PENDING',verifying:'VERIFYING PURCHASE',verification_unavailable:'PURCHASE VERIFICATION UNAVAILABLE',restored:'RESTORE CHECKED',error:'PRODUCT UNAVAILABLE'};return tr(keys[code]||'PRODUCT UNAVAILABLE')}
function renderRevenuePanel(){
 const root=$('revenuePanel');if(!root)return;
 if(!window.AndroidBridge){root.style.display='none';root.innerHTML='';return}
 root.style.display='grid';
 const count=Math.max(0,Math.min(REWARDED_AD_LIMIT,Number(monetizationState.rewardCount)||0));
 let bridgeOwnsProduct=false;try{bridgeOwnsProduct=!!(window.AndroidBridge&&typeof window.AndroidBridge.hasProduct==='function'&&window.AndroidBridge.hasProduct(SUPPORTER_PRODUCT_ID))}catch(_){}
 const owned=!!monetizationState.supporterOwned||bridgeOwnsProduct;
 const productAvailable=!!monetizationState.productAvailable;
 const adReady=!!monetizationState.adsReady;
 const adDisabled=count>=REWARDED_AD_LIMIT||!adReady||monetizationState.adStatus==='loading';
 const productDisabled=owned||!productAvailable;
 const price=monetizationState.supporterPrice?` · ${escapeHTML(monetizationState.supporterPrice)}`:'';
 const adStatus=count>=REWARDED_AD_LIMIT?monetizationStatusKey('limit'):monetizationStatusKey(monetizationState.adStatus|| (adReady?'ad_ready':'unavailable'));
 const purchaseStatusKey=monetizationState.purchaseStatus==='ready'?'product_ready':(monetizationState.purchaseStatus||'product_not_configured');
 const productStatus=monetizationStatusKey(owned?'owned':purchaseStatusKey);
 const daily=loadDailyRewardState();
 const dailyClaimed=daily.date===localDayKey() && daily.claimed===true;
 const dailyDoubled=daily.date===localDayKey() && daily.doubled===true;
 const dailyAmount=dailyRewardAmount(daily.streak||0);
 root.innerHTML=`
  <section class="revenue-card premium" aria-label="${escapeHTML(tr('DAILY SHARD GIFT'))}">
   <div class="revenue-card-head"><span class="revenue-glyph">✦</span><div><h3>${escapeHTML(tr('DAILY SHARD GIFT'))}</h3><span class="revenue-status">${escapeHTML(tr('STREAK'))}: ${Math.max(0,Number(daily.streak)||0)} · ${dailyClaimed?escapeHTML(tr('CLAIMED TODAY')):escapeHTML(tr('READY TO CLAIM'))}</span></div></div>
   <p>${escapeHTML(tr('Claim a free daily shard gift. Watch one optional ad to double today’s gift.'))}</p>
   <div class="revenue-actions"><button type="button" class="revenue-action" id="claimDailyGiftBtn" ${dailyClaimed?'disabled':''}>${escapeHTML(dailyClaimed?tr('DAILY GIFT CLAIMED'):tr('CLAIM FREE')+' · +'+dailyAmount+' '+tr('SHARDS'))}</button><button type="button" class="revenue-restore" id="doubleDailyGiftBtn" ${!dailyClaimed||dailyDoubled||count>=REWARDED_AD_LIMIT||!adReady?'disabled':''}>${escapeHTML(dailyDoubled?tr('DAILY GIFT DOUBLED'):tr('WATCH AD · DOUBLE GIFT'))}</button></div>
   <small class="revenue-status">${escapeHTML(tr('Daily gift remains available without ads.'))}</small>
  </section>
  <section class="revenue-card" aria-label="${escapeHTML(tr('OPTIONAL REWARD'))}">
   <div class="revenue-card-head"><span class="revenue-glyph">◈</span><div><h3>${escapeHTML(tr('OPTIONAL REWARD'))}</h3><span class="revenue-status">${escapeHTML(tr('TODAY'))}: ${count}/${REWARDED_AD_LIMIT}</span></div></div>
   <p>${escapeHTML(tr('Earn 50 shards after a completed optional video. Limited to 3 rewards each day.'))}</p>
   <button type="button" class="revenue-action" id="rewardedAdBtn" ${adDisabled?'disabled':''}>${escapeHTML(tr('WATCH AN AD · +50 SHARDS'))}</button>
   <small class="revenue-status" id="rewardAdStatus">${escapeHTML(adStatus)}</small>
  </section>
  <section class="revenue-card premium" aria-label="${escapeHTML(tr('SUPPORTER PACK'))}">
   <div class="revenue-card-head"><span class="revenue-glyph">♛</span><div><h3>${escapeHTML(tr('SUPPORTER PACK'))}</h3><span class="revenue-status">${escapeHTML(tr('PREMIUM COSMETIC'))}</span></div></div>
   <p>${escapeHTML(tr('Own an exclusive Eclipse Crown cosmetic. One-time purchase; it never increases combat power.'))}</p>
   <div class="revenue-actions"><button type="button" class="revenue-action" id="supporterPackBtn" ${productDisabled?'disabled':''}>${escapeHTML(owned?tr('PURCHASE OWNED'):productAvailable?tr('BUY SUPPORTER PACK')+price:tr('PRODUCT UNAVAILABLE'))}</button><button type="button" class="revenue-restore" id="restorePurchasesBtn">${escapeHTML(tr('RESTORE PURCHASES'))}</button></div>
   <small class="revenue-status" id="supporterPackStatus">${escapeHTML(productStatus)}</small>
  </section>
  ${monetizationState.privacyOptionsRequired?`<button class="revenue-restore" type="button" id="privacyOptionsBtn">${escapeHTML(tr('PRIVACY OPTIONS'))}</button>`:''}
  <p class="revenue-disclaimer">${escapeHTML(tr('REVENUE FEATURES ARE OPTIONAL'))} ${escapeHTML(tr('OFFLINE GAMEPLAY REMAINS AVAILABLE'))}</p>`;
 const dailyClaimBtn=$('claimDailyGiftBtn');if(dailyClaimBtn)dailyClaimBtn.addEventListener('click',claimDailyShardGift);
 const dailyDoubleBtn=$('doubleDailyGiftBtn');if(dailyDoubleBtn)dailyDoubleBtn.addEventListener('click',()=>{const d=loadDailyRewardState();if(d.date!==localDayKey()||!d.claimed||d.doubled||monetizationState.rewardCount>=REWARDED_AD_LIMIT||!window.AndroidBridge||typeof window.AndroidBridge.showRewardedAd!=='function')return;dailyDoublePending=true;rewardedAdPending=true;monetizationState.adStatus='loading';renderRevenuePanel();try{window.AndroidBridge.showRewardedAd('shards')}catch(e){dailyDoublePending=false;rewardedAdPending=false;monetizationState.adStatus='unavailable';renderRevenuePanel()}});
 const adBtn=$('rewardedAdBtn');if(adBtn)adBtn.addEventListener('click',()=>{if(!window.AndroidBridge||typeof window.AndroidBridge.showRewardedAd!=='function')return;dailyDoublePending=false;rewardedAdPending=true;monetizationState.adStatus='loading';renderRevenuePanel();try{window.AndroidBridge.showRewardedAd('shards')}catch(e){rewardedAdPending=false;monetizationState.adStatus='unavailable';renderRevenuePanel()}});
 const buyBtn=$('supporterPackBtn');if(buyBtn)buyBtn.addEventListener('click',()=>{try{window.AndroidBridge.buyProduct(SUPPORTER_PRODUCT_ID)}catch(e){monetizationState.purchaseStatus='product_unavailable';renderRevenuePanel()}});
 const restoreBtn=$('restorePurchasesBtn');if(restoreBtn)restoreBtn.addEventListener('click',()=>{try{window.AndroidBridge.restorePurchases()}catch(e){monetizationState.purchaseStatus='product_unavailable';renderRevenuePanel()}});
 const privacyBtn=$('privacyOptionsBtn');if(privacyBtn)privacyBtn.addEventListener('click',()=>{try{window.AndroidBridge.showPrivacyOptions()}catch(e){}});
}
window.onEmberfallMonetizationState=function(state){
 if(!state||typeof state!=='object')return;
 monetizationState.productAvailable=state.productAvailable===true;
 monetizationState.supporterOwned=state.supporterOwned===true;
 monetizationState.supporterPrice=typeof state.supporterPrice==='string'?state.supporterPrice:'';
 monetizationState.purchaseStatus=typeof state.purchaseStatus==='string'?state.purchaseStatus:'product_not_configured';
 monetizationState.adsReady=state.adsReady===true;
 monetizationState.adStatus=typeof state.adStatus==='string'?state.adStatus:'unavailable';
 monetizationState.rewardCount=Math.max(0,Math.min(REWARDED_AD_LIMIT,Number(state.rewardCount)||0));
 monetizationState.privacyOptionsRequired=state.privacyOptionsRequired===true;
 renderRevenuePanel();
 if(typeof renderLegacy==='function')renderLegacy();
};
window.onEmberfallRewardedAd=function(result){
 // A reward callback is accepted only while a native rewarded-ad request is pending.
 // Real purchase/ad verification must still happen in the Android layer.
 if(!result||typeof result!=='object'||!window.AndroidBridge||!rewardedAdPending)return;
 rewardedAdPending=false;
 monetizationState.rewardCount=Math.max(0,Math.min(REWARDED_AD_LIMIT,Number(result.rewardCount)||monetizationState.rewardCount));
 monetizationState.adStatus=typeof result.status==='string'?result.status:'unavailable';
 if(result.granted===true&&result.placement==='shards'){
  let earned=50,doubledDaily=false,updates={};
  if(dailyDoublePending){const d=loadDailyRewardState();if(d.date===localDayKey()&&d.claimed&&!d.doubled){earned=dailyRewardAmount(d.streak);d.doubled=true;updates[DAILY_GIFT_KEY]=JSON.stringify(d);doubledDaily=true}else{dailyDoublePending=false;storeNotice=tr('REWARD AD NOT COMPLETED');renderStore();return}dailyDoublePending=false}
  const nextWallet=Math.min(999999999,walletShards+earned);updates[WALLET_KEY]=String(nextWallet);updates[STORE_KEY]=JSON.stringify(storeRanks);updates[CORE_KEY]=String(eclipseCores);if(!writeStorageTransaction(updates)){storeNotice=tr('Storage is unavailable.');renderStore();return}walletShards=nextWallet;updateWalletUI();
  if(typeof stats==='object'&&stats&&Number.isFinite(stats.shardsEarned))stats.shardsEarned+=earned;
  storeNotice=tr(doubledDaily?'DAILY GIFT DOUBLED':'REWARD AD GRANTED');
  sound(760,.13,'triangle',.035);
 }else if(dailyDoublePending){dailyDoublePending=false}
 renderStore();
};

function renderStore(){
 const root=$('storeGrid');if(!root)return;root.innerHTML='';
 for(const item of STORE_ITEMS){const rank=storeRanks[item.id],price=storeCost(item),maxed=rank>=item.max,affordable=walletShards>=price;
  const card=document.createElement('section');card.className='store-card';card.style.setProperty('--store-glow',item.color);
  const dots=Array.from({length:item.max},(_,i)=>`<i class="${i<rank?'on':''}"></i>`).join('');
  const buttonText=maxed?tr('MAX RANK'):affordable?`${tr('BUY UPGRADE')} · ${price} ◈`:`${tr('NEED')} ${price-walletShards} ${tr('MORE')} ◈`;
  card.innerHTML=`<div class="store-card-head"><span class="store-icon">${item.icon}</span><div class="store-name"><b>${escapeHTML(tr(item.name))}</b><small>${tr('RANK')} ${rank} / ${item.max}</small></div></div><p class="store-desc">${escapeHTML(tr(item.desc))}</p><div class="store-meter"><span>${tr('PERMANENT RANK')}</span><span class="store-rank-dots">${dots}</span></div><button type="button" class="store-buy" data-store-buy="${item.id}" ${maxed||!affordable?'disabled':''}>${buttonText}</button>`;
  const btn=card.querySelector('[data-store-buy]');btn.addEventListener('click',()=>purchaseStoreItem(item.id));root.appendChild(card);
 }
 updateWalletUI();renderRevenuePanel();if($('storeNotice'))$('storeNotice').textContent=tr(storeNotice);
}
function openStore(){storeNotice='Choose a permanent upgrade. It will take effect next run.';if(mode==='menu')$('startOverlay').style.display='none';renderStore();$('storeOverlay').style.display='flex'}
function closeStore(){$('storeOverlay').style.display='none';if(mode==='menu')$('startOverlay').style.display='flex'}
let storePurchasePending=false;
function purchaseStoreItem(id){if(storePurchasePending)return;storePurchasePending=true;try{const item=STORE_ITEMS.find(x=>x.id===id);if(!item)return;const rank=storeRanks[id]||0;if(rank>=item.max){storeNotice='This upgrade has reached its maximum rank.';renderStore();return}const cost=storeCost(item);if(walletShards<cost){storeNotice='Not enough shards. Defeat more Riftborn to earn '+(cost-walletShards)+' additional shards.';renderStore();return}const nextWallet=walletShards-cost,nextRanks={...storeRanks,[id]:rank+1};if(!writeStorageTransaction({[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(nextRanks),[CORE_KEY]:String(eclipseCores)})){storeNotice='Storage is unavailable. The purchase was not applied.';renderStore();return}walletShards=nextWallet;storeRanks=nextRanks;storeNotice=tr('PURCHASE COMPLETE')+' · '+tr(item.name)+' '+tr('is now rank')+' '+storeRanks[id]+'. '+tr('Active next run.');renderStore();updateHudIfNeeded();sound(690,.12,'triangle',.035)}finally{storePurchasePending=false}}
function updateHudIfNeeded(){if(player&&$('shardsText'))$('shardsText').textContent=String(walletShards)}
function awardShards(enemy){const base=enemy.boss?45:enemy.type==='brute'?8:enemy.type==='spitter'?6:enemy.type==='skirmisher'||enemy.type==='wraith'?7:5;const reward=Math.max(1,Math.round(base*trialRules().reward*(enemy.elite?1.8:1)*(player&&player.shardMultiplier||1)));const nextWallet=Math.min(999999999,walletShards+reward);if(!writeStorageTransaction({[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores)})){storeNotice='Browser storage is unavailable; shard reward was not applied.';announce('SAVE FAILED · SHARD REWARD NOT APPLIED');return 0}walletShards=nextWallet;if(stats&&Number.isFinite(stats.shardsEarned))stats.shardsEarned+=reward;updateWalletUI();if(player)floating(enemy.x,enemy.y-enemy.r-17,'+'+reward+' ◈','#ffd27c');return reward}
function awardEclipseCoreFromTitan(enemy){if(!enemy||!enemy.boss||(enemy.echoBreaks||0)<1)return false;const nextCores=Math.min(1000000,eclipseCores+1);if(!writeStorageTransaction({[WALLET_KEY]:String(walletShards),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(nextCores)})){storeNotice='Browser storage is unavailable; Eclipse Core was not awarded.';announce('SAVE FAILED · CORE NOT AWARDED');return false}eclipseCores=nextCores;updateWalletUI();floating(enemy.x,enemy.y-enemy.r-42,'+1 ECLIPSE CORE','#d8a1ff');announce('ECLIPSE CORE FORGED · +1');return true}
loadEconomy();

const PROFILE_KEY='emberfall_profile_v07';
const SIGILS=[
 {id:'spark',name:'Rift Spark',icon:'✦',color:'#72f6ff',unlock:'Always available',open:()=>true},
 {id:'ember',name:'Ember Trail',icon:'♨',color:'#ff9565',unlock:'Defeat 50 Riftborn',open:()=>profile.totalKills>=50},
 {id:'titan',name:'Titanbreaker',icon:'✧',color:'#ffd27c',unlock:'Defeat your first Titan',open:()=>profile.bossKills>=1},
 {id:'verdant',name:'Gloam Warden',icon:'♧',color:'#82f5ac',unlock:'Unseal Gloamwood',open:()=>unlockedWorlds>=2},
 {id:'frost',name:'Frost Crown',icon:'❄',color:'#92deff',unlock:'Unseal Frostvein Citadel',open:()=>unlockedWorlds>=3},
 {id:'prism',name:'Prism Walker',icon:'◇',color:'#c2a0ff',unlock:'Start a run with all 4 weapons',open:()=>profile.weaponsUsed.length>=4},
 {id:'eclipse',name:'Eclipse Crown',icon:'♛',color:'#ffd27c',unlock:'Requires Supporter Pack',open:()=>{try{return !!(window.AndroidBridge&&typeof window.AndroidBridge.hasProduct==='function'&&window.AndroidBridge.hasProduct('emberfall_supporter_pack'))}catch(_){return false}}}
];
const ACHIEVEMENTS=[
 {id:'first_spark',icon:'✦',name:'FIRST SPARK',desc:'Defeat your first Riftborn.',stat:'totalKills',target:1,reward:20,tag:'INITIATION'},
 {id:'soul_harvester',icon:'⚔',name:'SOUL HARVESTER',desc:'Defeat 100 enemies across all runs.',stat:'totalKills',target:100,reward:80,tag:'HUNTER'},
 {id:'titan_breaker',icon:'✧',name:'TITAN BREAKER',desc:'Defeat your first realm Titan.',stat:'bossKills',target:1,reward:45,tag:'BOSS SLAYER'},
 {id:'titan_trio',icon:'♜',name:'TITAN TRIO',desc:'Defeat three Titans in total.',stat:'bossKills',target:3,reward:100,tag:'VETERAN'},
 {id:'storm_survivor',icon:'ϟ',name:'STORM SURVIVOR',desc:'Reach wave 10 in your campaign record.',stat:'bestWave',target:10,reward:70,tag:'SURVIVAL'},
 {id:'realmwalker',icon:'♧',name:'REALMWALKER',desc:'Unseal the second realm.',stat:'worldsUnlocked',target:2,reward:60,tag:'EXPLORER'},
 {id:'frostbound',icon:'❄',name:'FROSTBOUND',desc:'Unseal all three realms.',stat:'worldsUnlocked',target:3,reward:110,tag:'CAMPAIGN'},
 {id:'arsenal',icon:'◇',name:'THE ARSENAL',desc:'Start a run with each of the four weapons.',stat:'weaponsUsed',target:4,reward:70,tag:'MASTERY'}
];
const DAILY_CONTRACTS=[
 {id:'kills',icon:'⚔',name:'RIFTSWEEPER',desc:'Defeat 25 enemies today.',target:25,reward:35,unit:'DEFEATS'},
 {id:'specials',icon:'✦',name:'RIFT CONDUIT',desc:'Cast Rift Burst 5 times today.',target:5,reward:30,unit:'CASTS'},
 {id:'bosses',icon:'♜',name:'TITAN BOUNTY',desc:'Defeat a Titan today.',target:1,reward:75,unit:'TITANS'}
];
let profile={totalKills:0,bossKills:0,runs:0,bestWave:0,specialsUsed:0,weaponsUsed:[],worldsUnlocked:1,claimedAchievements:[],selectedSigil:'spark',daily:null};
function localDayKey(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function newDailyRecord(){return {date:localDayKey(),kills:0,specials:0,bosses:0,claimed:{kills:false,specials:false,bosses:false}}}
function ensureDailyRecord(){if(profile.daily&&profile.daily.date===localDayKey())return true;const nextProfile={...profile,daily:newDailyRecord()};if(!writeStorageTransaction({[PROFILE_KEY]:JSON.stringify(nextProfile)}))return false;profile=nextProfile;return true}
function loadProfile(){
 try{
  const value=JSON.parse(localStorage.getItem(PROFILE_KEY)||'{}');
  const raw=value&&typeof value==='object'&&!Array.isArray(value)?value:{};
  profile={...profile,...raw};
  profile.totalKills=storedInt(profile.totalKills,0,0,999999999);
  profile.bossKills=storedInt(profile.bossKills,0,0,999999999);
  profile.runs=storedInt(profile.runs,0,0,999999999);
  profile.bestWave=storedInt(profile.bestWave,0,0,1000000);
  profile.specialsUsed=storedInt(profile.specialsUsed,0,0,999999999);
  profile.worldsUnlocked=storedInt(profile.worldsUnlocked,1,1,3);
  profile.weaponsUsed=Array.isArray(profile.weaponsUsed)?[...new Set(profile.weaponsUsed.filter(x=>Object.prototype.hasOwnProperty.call(WEAPONS,x)))]:[];
  profile.claimedAchievements=Array.isArray(profile.claimedAchievements)?[...new Set(profile.claimedAchievements.filter(x=>ACHIEVEMENTS.some(a=>a.id===x)))]:[];
  if(!SIGILS.some(s=>s.id===profile.selectedSigil))profile.selectedSigil='spark';
  if(!profile.daily||typeof profile.daily!=='object'||Array.isArray(profile.daily))profile.daily=newDailyRecord();
  profile.daily.kills=storedInt(profile.daily.kills,0,0,999999);
  profile.daily.specials=storedInt(profile.daily.specials,0,0,999999);
  profile.daily.bosses=storedInt(profile.daily.bosses,0,0,999999);
  profile.daily.claimed=profile.daily.claimed&&typeof profile.daily.claimed==='object'&&!Array.isArray(profile.daily.claimed)?profile.daily.claimed:{};
  for(const c of DAILY_CONTRACTS)profile.daily.claimed[c.id]=profile.daily.claimed[c.id]===true;
 }catch(e){profile={totalKills:0,bossKills:0,runs:0,bestWave:0,specialsUsed:0,weaponsUsed:[],worldsUnlocked:1,claimedAchievements:[],selectedSigil:'spark',daily:newDailyRecord()}}
 ensureDailyRecord();
}
function saveProfile(){try{localStorage.setItem(PROFILE_KEY,JSON.stringify(profile));return true}catch(e){return false}}
function profileMetric(stat){if(stat==='worldsUnlocked')return Math.max(profile.worldsUnlocked||1,typeof unlockedWorlds==='number'?unlockedWorlds:1);if(stat==='weaponsUsed')return profile.weaponsUsed.length;if(stat==='bestWave')return Math.max(profile.bestWave||0,best||0);return Math.max(0,Number(profile[stat])||0)}
function achievementReady(a){return profileMetric(a.stat)>=a.target}
function achievementCountClaimable(){return ACHIEVEMENTS.filter(a=>achievementReady(a)&&!profile.claimedAchievements.includes(a.id)).length}
function dailyCountClaimable(){if(!ensureDailyRecord())return 0;return DAILY_CONTRACTS.filter(c=>profile.daily[c.id]>=c.target&&!profile.daily.claimed[c.id]).length}
function updateLegacyBadge(){const total=achievementCountClaimable()+dailyCountClaimable();if($('legacyBadge'))$('legacyBadge').textContent=String(total);if($('legacyMenuBtn'))$('legacyMenuBtn').setAttribute('aria-label',tr('Legacy and Daily Contracts')+', '+total+' '+tr('rewards ready'));if($('legacyWallet'))$('legacyWallet').textContent=String(walletShards)}
function commitProgressProfile(nextProfile){if(!writeStorageTransaction({[PROFILE_KEY]:JSON.stringify(nextProfile)})){storeNotice=tr('Storage is unavailable.');return false}profile=nextProfile;return true}
function recordDailyProgress(kind){if(!ensureDailyRecord()||!['kills','specials','bosses'].includes(kind))return false;const nextProfile={...profile,daily:{...profile.daily,[kind]:Math.min(999999,(Number(profile.daily[kind])||0)+1),claimed:{...profile.daily.claimed}}};if(!commitProgressProfile(nextProfile))return false;updateLegacyBadge();return true}
function recordEnemyDefeat(isBoss){if(!ensureDailyRecord())return false;const nextDaily={...profile.daily,kills:Math.min(999999,(Number(profile.daily.kills)||0)+1),claimed:{...profile.daily.claimed}};if(isBoss)nextDaily.bosses=Math.min(999999,(Number(profile.daily.bosses)||0)+1);const nextProfile={...profile,totalKills:Math.min(999999999,(Number(profile.totalKills)||0)+1),bossKills:Math.min(999999999,(Number(profile.bossKills)||0)+(isBoss?1:0)),daily:nextDaily,worldsUnlocked:Math.max(profile.worldsUnlocked||1,typeof unlockedWorlds==='number'?unlockedWorlds:1),bestWave:Math.max(profile.bestWave||0,best||0)};if(!commitProgressProfile(nextProfile))return false;updateLegacyBadge();return true}
function recordSpecialUse(){if(!ensureDailyRecord())return false;const nextProfile={...profile,specialsUsed:Math.min(999999999,(Number(profile.specialsUsed)||0)+1),daily:{...profile.daily,specials:Math.min(999999,(Number(profile.daily.specials)||0)+1),claimed:{...profile.daily.claimed}}};if(!commitProgressProfile(nextProfile))return false;updateLegacyBadge();return true}
function sigilIsOpen(s){return s.open()}
function renderLegacy(){if(!ensureDailyRecord()){storeNotice=tr('Storage is unavailable.');const notice=$('legacyNotice');if(notice)notice.textContent=tr('Storage is unavailable.');return}profile.worldsUnlocked=Math.max(profile.worldsUnlocked||1,unlockedWorlds);profile.bestWave=Math.max(profile.bestWave||0,best||0);saveProfile();$('legacyWallet').textContent=String(walletShards);$('legacyKills').textContent=String(profile.totalKills);$('legacyTitans').textContent=String(profile.bossKills);$('legacyRuns').textContent=String(profile.runs);$('legacyBestWave').textContent=String(Math.max(1,profileMetric('bestWave'))).padStart(2,'0');try{const d=new Date(profile.daily.date+'T12:00:00');$('dailyDateLabel').textContent=new Intl.DateTimeFormat(currentLanguage,{year:'numeric',month:'short',day:'numeric'}).format(d)}catch(e){$('dailyDateLabel').textContent=profile.daily.date}
 const dg=$('dailyGrid');dg.innerHTML='';for(const c of DAILY_CONTRACTS){const current=Math.min(c.target,profile.daily[c.id]||0),done=current>=c.target,claimed=!!profile.daily.claimed[c.id];const card=document.createElement('section');card.className='legacy-card'+(done?' done':'');card.innerHTML=`<div class="legacy-card-head"><span class="legacy-glyph">${c.icon}</span><div><div class="legacy-card-title">${tr(c.name)}</div><div class="legacy-card-tag">${tr('DAILY')} · +${c.reward} ${tr('SHARDS')}</div></div></div><p class="legacy-desc">${tr(c.desc)}</p><div class="legacy-meter"><span>${tr(c.unit)}</span><span>${current} / ${c.target}</span></div><div class="legacy-track"><span style="width:${Math.min(100,current/c.target*100)}%"></span></div><button class="legacy-action ${done&&!claimed?'claim':''}" data-daily-claim="${c.id}" ${!done||claimed?'disabled':''}>${claimed?tr('REWARD CLAIMED'):done?tr('CLAIM')+' +'+c.reward+' ◈':tr('IN PROGRESS')}</button>`;dg.appendChild(card)}
 const ag=$('achievementGrid');ag.innerHTML='';for(const a of ACHIEVEMENTS){const current=Math.min(a.target,profileMetric(a.stat)),done=current>=a.target,claimed=profile.claimedAchievements.includes(a.id);const card=document.createElement('section');card.className='legacy-card'+(done?' done':'');card.innerHTML=`<div class="legacy-card-head"><span class="legacy-glyph">${a.icon}</span><div><div class="legacy-card-title">${tr(a.name)}</div><div class="legacy-card-tag">${tr(a.tag)} · +${a.reward} ${tr('SHARDS')}</div></div></div><p class="legacy-desc">${tr(a.desc)}</p><div class="legacy-meter"><span>${tr('PROGRESS')}</span><span>${current} / ${a.target}</span></div><div class="legacy-track"><span style="width:${Math.min(100,current/a.target*100)}%"></span></div><button class="legacy-action ${done&&!claimed?'claim':''}" data-achievement-claim="${a.id}" ${!done||claimed?'disabled':''}>${claimed?tr('REWARD CLAIMED'):done?tr('CLAIM')+' +'+a.reward+' ◈':tr('LOCKED')}</button>`;ag.appendChild(card)}
 const sg=$('sigilGrid');sg.innerHTML='';for(const s of SIGILS){const open=sigilIsOpen(s),selected=open&&profile.selectedSigil===s.id;const b=document.createElement('button');b.type='button';b.className='sigil-choice'+(selected?' selected':'');b.style.setProperty('--sigil',s.color);b.disabled=!open;b.setAttribute('aria-pressed',selected?'true':'false');b.innerHTML=`<span class="sigil-icon">${open?s.icon:'🔒'}</span><span><b>${tr(s.name)}</b><small>${open?(selected?tr('EQUIPPED'):tr('UNLOCKED')):tr(s.unlock)}</small></span>`;b.addEventListener('click',()=>{if(!sigilIsOpen(s))return;profile.selectedSigil=s.id;saveProfile();renderLegacy();updateLegacyBadge()});sg.appendChild(b)}
 dg.querySelectorAll('[data-daily-claim]').forEach(b=>b.addEventListener('click',()=>claimDailyReward(b.dataset.dailyClaim)));ag.querySelectorAll('[data-achievement-claim]').forEach(b=>b.addEventListener('click',()=>claimAchievementReward(b.dataset.achievementClaim)));updateLegacyBadge()}
function openLegacy(){if(mode==='menu')$('startOverlay').style.display='none';if(!ensureDailyRecord()){storeNotice=tr('Storage is unavailable.');const notice=$('legacyNotice');if(notice)notice.textContent=tr('Storage is unavailable.');$('legacyOverlay').style.display='flex';return}renderLegacy();$('legacyOverlay').style.display='flex'}
function closeLegacy(){$('legacyOverlay').style.display='none';if(mode==='menu')$('startOverlay').style.display='flex'}
function claimDailyReward(id){const c=DAILY_CONTRACTS.find(x=>x.id===id);if(!c||!ensureDailyRecord())return;if((profile.daily[c.id]||0)<c.target||profile.daily.claimed[c.id])return;const nextWallet=Math.min(999999999,walletShards+c.reward),nextProfile={...profile,daily:{...profile.daily,claimed:{...profile.daily.claimed,[c.id]:true}}};if(!writeStorageTransaction({[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores),[PROFILE_KEY]:JSON.stringify(nextProfile)})){storeNotice=tr('Storage is unavailable.');renderLegacy();return}walletShards=nextWallet;profile=nextProfile;storeNotice=tr('Daily contract claimed:')+' '+tr(c.name)+'.';renderStore();renderLegacy();updateWalletUI();updateLegacyBadge();sound(730,.12,'triangle',.035)}
function claimAchievementReward(id){const a=ACHIEVEMENTS.find(x=>x.id===id);if(!a||!achievementReady(a)||profile.claimedAchievements.includes(id))return;const nextWallet=Math.min(999999999,walletShards+a.reward),nextProfile={...profile,claimedAchievements:[...profile.claimedAchievements,id]};if(!writeStorageTransaction({[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores),[PROFILE_KEY]:JSON.stringify(nextProfile)})){storeNotice=tr('Storage is unavailable.');renderLegacy();return}walletShards=nextWallet;profile=nextProfile;renderStore();renderLegacy();updateWalletUI();updateLegacyBadge();sound(760,.14,'triangle',.04)}
function syncProgressFromExisting(){profile.bestWave=Math.max(profile.bestWave||0,best||0);profile.worldsUnlocked=Math.max(profile.worldsUnlocked||1,unlockedWorlds||1);saveProfile()}
loadProfile();

let unlockedWorlds=1,selectedWorldIndex=0;
try{
 const savedWorlds=storedInt(localStorage.getItem(WORLD_UNLOCK_KEY),1,1,WORLDS.length);
 const profileWorlds=storedInt(profile.worldsUnlocked,1,1,WORLDS.length);
 unlockedWorlds=clamp(Math.max(savedWorlds,profileWorlds),1,WORLDS.length);
 selectedWorldIndex=storedInt(localStorage.getItem(WORLD_SELECT_KEY),0,0,WORLDS.length-1);
 if(selectedWorldIndex>=unlockedWorlds)selectedWorldIndex=0;
}catch(e){unlockedWorlds=storedInt(profile.worldsUnlocked,1,1,WORLDS.length);selectedWorldIndex=0}
profile.worldsUnlocked=Math.max(storedInt(profile.worldsUnlocked,1,1,WORLDS.length),unlockedWorlds);
const selectedSigilRecord=SIGILS.find(s=>s.id===profile.selectedSigil);
if(!selectedSigilRecord||!selectedSigilRecord.open())profile.selectedSigil='spark';
// Reconcile legacy/profile world progress and the selected realm in one rollback-safe write.
// If storage is unavailable, retain the safe in-memory values and retry on the next launch.
const worldStateReconciled=writeStorageTransaction({[WORLD_UNLOCK_KEY]:String(unlockedWorlds),[WORLD_SELECT_KEY]:String(selectedWorldIndex),[PROFILE_KEY]:JSON.stringify(profile)});
const worldIndexForWave=wave=>clamp(Math.floor((wave-1)/5),0,WORLDS.length-1);
function activeWorldIndex(){return player?worldIndexForWave(player.wave):selectedWorldIndex}
function activeWorld(){return WORLDS[activeWorldIndex()]||WORLDS[0]}
function saveWorldProgress(proposed=unlockedWorlds){const next=clamp(Math.max(unlockedWorlds,Number(proposed)||1),1,WORLDS.length);const nextProfile={...profile,worldsUnlocked:Math.max(profile.worldsUnlocked||1,next)};if(!writeStorageTransaction({[WORLD_UNLOCK_KEY]:String(next),[PROFILE_KEY]:JSON.stringify(nextProfile)})){announce('SAVE FAILED · REALM NOT UNSEALED');return false}unlockedWorlds=next;profile=nextProfile;updateLegacyBadge();buildWorldMenu();return true}
function updateWorldButton(){const w=WORLDS[selectedWorldIndex]||WORLDS[0];if($('worldSelectBtn'))$('worldSelectBtn').textContent=tr('CHOOSE REALM')+' · '+tr(w.title);if($('worldMenuSummary'))$('worldMenuSummary').textContent=tr('REALM')+' '+['I','II','III'][selectedWorldIndex]+' · '+tr('START AT WAVE')+' '+String(w.startWave).padStart(2,'0');if($('realmSelectedNote'))$('realmSelectedNote').textContent=tr('SELECTED')+' · '+tr(w.title)+' — '+tr(w.mechanic)}
function buildWorldMenu(){const grid=$('realmGrid');if(!grid)return;grid.innerHTML='';WORLDS.forEach((w,i)=>{const unlocked=i<unlockedWorlds;const b=document.createElement('button');b.type='button';b.className='realm-card'+(selectedWorldIndex===i?' selected':'');b.disabled=!unlocked;b.style.setProperty('--realm-glow',w.sigil);b.style.setProperty('--realm-line',w.border);b.style.setProperty('--realm-tint',w.bg[0]);b.setAttribute('aria-pressed',selectedWorldIndex===i?'true':'false');const gate=i===0?tr('OPEN · WAVE 01'):i===1?tr('DEFEAT THE RIFT TITAN · WAVE 05'):tr('DEFEAT THE THORN TITAN · WAVE 10');const gateText=unlocked?tr('UNSEALED · START AT WAVE')+' '+String(w.startWave).padStart(2,'0'):gate;b.innerHTML=`<span class="realm-symbol">${w.symbol}</span><span class="realm-name">${tr(w.title)}<br><span class="realm-status">${tr(w.short)}</span></span><span class="realm-lore">${tr(w.lore)}</span><span class="realm-mechanic">${tr(w.mechanic)}</span><span class="realm-gate">${gateText}</span>`;b.addEventListener('click',()=>{if(!unlocked)return;selectedWorldIndex=i;try{localStorage.setItem(WORLD_SELECT_KEY,String(i))}catch(e){}updateWorldButton();buildWorldMenu();sound(410,.08,'triangle',.025)});grid.appendChild(b)});updateWorldButton()}
function showWorldMenu(){if(mode==='menu')$('startOverlay').style.display='none';buildWorldMenu();$('worldOverlay').style.display='flex'}
function hideWorldMenu(){$('worldOverlay').style.display='none';if(mode==='menu')$('startOverlay').style.display='flex'}

let selectedWeapon='aetherblade';
try{const savedWeapon=localStorage.getItem(WEAPON_KEY);if(WEAPONS[savedWeapon])selectedWeapon=savedWeapon}catch(e){}
function updateBestUI(){const label=String(Math.max(1,best)).padStart(2,'0');if($('bestMenu'))$('bestMenu').textContent=tr('PERSONAL RECORD')+': '+tr('WAVE')+' '+label;if($('bestFinal'))$('bestFinal').textContent=tr('PERSONAL RECORD')+': '+tr('WAVE')+' '+label;const soundLabel=tr(audioOn?'SOUND: ON':'SOUND: OFF');if($('audioMenuBtn'))$('audioMenuBtn').textContent=soundLabel;if($('pauseAudioBtn'))$('pauseAudioBtn').textContent=soundLabel}
function updateWeaponMenu(){const kit=WEAPONS[selectedWeapon]||WEAPONS.aetherblade;document.querySelectorAll('.weapon-card').forEach(card=>{const selected=card.dataset.weapon===selectedWeapon;card.classList.toggle('selected',selected);card.setAttribute('aria-pressed',String(selected))});const summary=$('weaponSummary');if(summary)summary.textContent=tr('SELECTED')+' · '+tr(kit.name).toUpperCase()+' — '+tr(kit.desc)}
function selectWeapon(id){if(!WEAPONS[id])return;selectedWeapon=id;try{localStorage.setItem(WEAPON_KEY,id)}catch(e){}updateWeaponMenu()}
function saveBestWave(){
 if(!player)return false;
 const nextBest=Math.max(best||0,player.wave||1);
 const nextProfile={...profile,bestWave:Math.max(profile.bestWave||0,player.wave||1),worldsUnlocked:Math.max(profile.worldsUnlocked||1,unlockedWorlds||1)};
 const nextCampaign={...campaignData,highestWave:Math.max(campaignData.highestWave||1,player.wave||1)};
 // Commit the personal record, profile metric, and campaign record together.
 if(!writeStorageTransaction({[BEST_KEY]:String(nextBest),[PROFILE_KEY]:JSON.stringify(nextProfile),[CAMPAIGN_KEY]:JSON.stringify(nextCampaign)})){
  announce('SAVE FAILED · PERSONAL RECORD NOT SAVED');
  updateLegacyBadge();
  return false;
 }
 best=nextBest;profile=nextProfile;campaignData.highestWave=nextCampaign.highestWave;
 updateBestUI();updateLegacyBadge();
 return true;
}
function toggleAudio(){audioOn=!audioOn;try{localStorage.setItem('emberfall_audio',audioOn?'on':'off')}catch(e){}updateBestUI();if(audioOn)sound(520,.09,'triangle',.025);const b=$('settingsAudioToggle');if(b){b.textContent=tr(audioOn?'SOUND: ON':'SOUND: OFF');b.classList.toggle('off',!audioOn);b.setAttribute('aria-pressed',String(audioOn))}}
try{best=storedInt(localStorage.getItem(BEST_KEY),0,0,1000000)}catch(e){best=0}syncProgressFromExisting();updateBestUI();
// Fair, testable combat helpers: Fisher–Yates avoids biased random-sort drafts.
function shuffleInPlace(items, random=Math.random){for(let i=items.length-1;i>0;i--){const j=Math.floor(random()*(i+1));[items[i],items[j]]=[items[j],items[i]];}return items;}
function comboTierCrossings(previous,next,tierSize=5){if(!Number.isFinite(previous)||!Number.isFinite(next)||!Number.isFinite(tierSize)||tierSize<1||next<=previous)return 0;return Math.max(0,Math.floor(next/tierSize)-Math.floor(previous/tierSize));}
function comboDamageBonus(combo,doctrine){const tiers=Math.floor(Math.max(0,combo||0)/3);return doctrine==='duelist'?Math.min(.18,tiers*.018):Math.min(.10,Math.floor(Math.max(0,combo||0)/5)*.02);}
function distanceToSegment(px,py,x1,y1,x2,y2){const dx=x2-x1,dy=y2-y1,len2=dx*dx+dy*dy;if(len2<=1e-9)return Math.hypot(px-x1,py-y1);const t=clamp(((px-x1)*dx+(py-y1)*dy)/len2,0,1);return Math.hypot(px-(x1+t*dx),py-(y1+t*dy));}
function canDashStrike(lastDashSerial,currentDashSerial){return Number.isSafeInteger(currentDashSerial)&&currentDashSerial>0&&lastDashSerial!==currentDashSerial;}
function dashFrameActive(remaining){return Number.isFinite(remaining)&&remaining>0;}
function dashStrikeMultiplier(weapon){return weapon==='twinfangs'?.58:weapon==='duskcleaver'?.86:weapon==='riftlance'?.78:.72;}
function weaponDamageForHit(weapon,baseDamage,priorTargets){if(!Number.isFinite(baseDamage)||baseDamage<0)return 0;const index=Number.isFinite(priorTargets)?Math.max(0,Math.floor(priorTargets)):0;const multiplier=weapon==='riftlance'&&index>0?Math.max(.55,1-index*.16):weapon==='twinfangs'?.96:1;return baseDamage*multiplier;}
function bruteSlamCanStart(distance,attackCd,windup){return Number.isFinite(distance)&&distance>=0&&distance<110&&Number.isFinite(attackCd)&&attackCd<=0&&(!Number.isFinite(windup)||windup<=0);}
function bruteSlamHits(distance,radius=110){return Number.isFinite(distance)&&Number.isFinite(radius)&&distance>=0&&radius>=0&&distance<=radius;}
function bruteSlamCanBeCountered(windup,distance,dashing,dashSerial,lastDashSerial,range=64){return Number.isFinite(windup)&&windup>0&&Number.isFinite(distance)&&distance>=0&&Number.isFinite(dashing)&&dashing>0&&Number.isFinite(dashSerial)&&dashSerial>0&&dashSerial!==lastDashSerial&&Number.isFinite(range)&&range>=0&&distance<=range;}
function skirmisherChargeHitsPlayer(px,py,x1,y1,x2,y2,radius){return [px,py,x1,y1,x2,y2,radius].every(Number.isFinite)&&radius>=0&&distanceToSegment(px,py,x1,y1,x2,y2)<=radius;}
function bossPhaseForHp(hp,maxHp,currentPhase=1){if(!Number.isFinite(hp)||!Number.isFinite(maxHp)||maxHp<=0)return Math.max(1,Math.min(3,Number.isFinite(currentPhase)?Math.floor(currentPhase):1));if(hp<=maxHp*.31)return 3;if(hp<=maxHp*.66)return 2;return Math.max(1,Math.min(3,Number.isFinite(currentPhase)?Math.floor(currentPhase):1));}

const upgrades=[
 {id:'edge',icon:'⚔',name:'Razor Covenant',desc:'Blade damage +25%. Your strikes bite deeper.',apply:p=>p.damage*=1.25},
 {id:'swift',icon:'➤',name:'Ghoststep',desc:'Move 13% faster and dash returns sooner.',apply:p=>{p.speed*=1.13;p.dashMax=Math.max(.65,p.dashMax*.82)}},
 {id:'heart',icon:'♥',name:'Phoenix Core',desc:'Restore 35 vitality and raise max vitality by 15.',apply:p=>{p.maxHp+=15;p.hp=Math.min(p.maxHp,p.hp+35)}},
 {id:'arc',icon:'✦',name:'Rift Conduit',desc:'Rift Burst hits harder and recharges faster.',apply:p=>{p.specialPower*=1.35;p.specialMax=Math.max(4,p.specialMax*.82)}},
 {id:'reach',icon:'〰',name:'Long Eclipse',desc:'Strike range +20% and wider blade arcs.',apply:p=>{p.reach*=1.2;p.arc+=.12}},
 {id:'orbit',icon:'◉',name:'Aether Orbit',desc:'Gain a revolving ember that damages nearby foes.',canTake:p=>(p.orbitals||0)<4,apply:p=>{p.orbitals=Math.min(4,p.orbitals+1)}},
 {id:'vital',icon:'✚',name:'Blood of Dawn',desc:'Maximum vitality +30 and fully heal.',apply:p=>{p.maxHp+=30;p.hp=p.maxHp}},
 {id:'surge',icon:'ϟ',name:'Storm Muscle',desc:'Attack cooldown -15% and strike speed rises.',apply:p=>p.attackRate=Math.max(.18,p.attackRate*.85)}
];
const RELICS=[
 {id:'emberHeart',icon:'♥',name:'EMBER HEART',desc:'Raises maximum vitality by 28 and restores 50 vitality.',apply:p=>{p.maxHp+=28;p.hp=Math.min(p.maxHp,p.hp+50)}},
 {id:'tempestCore',icon:'ϟ',name:'TEMPEST CORE',desc:'Attack 12% faster and move 8% faster.',apply:p=>{p.attackRate=Math.max(.18,p.attackRate*.88);p.speed*=1.08}},
 {id:'orbitSeed',icon:'◉',name:'ORBIT SEED',desc:'Gain one additional orbiting ember that damages nearby enemies.',canTake:p=>p.orbitals<4,apply:p=>{p.orbitals=Math.min(4,p.orbitals+1)}},
 {id:'echoCapacitor',icon:'✦',name:'ECHO CAPACITOR',desc:'Rift Burst damage +28%; cooldown reduced by 14%.',apply:p=>{p.specialPower*=1.28;p.specialMax=Math.max(4,p.specialMax*.86)}},
 {id:'voidMagnet',icon:'◇',name:'VOID MAGNET',desc:'Collect essence from farther away and earn 20% more shards.',apply:p=>{p.magnetRange+=100;p.shardMultiplier=(p.shardMultiplier||1)*1.2}},
 {id:'phaseGuard',icon:'⛨',name:'PHASE GUARD',desc:'Dash cooldown reduced by 18%; gain extra invulnerability after dashing.',apply:p=>{p.dashMax=Math.max(.65,p.dashMax*.82);p.dashGuardBonus=(p.dashGuardBonus||0)+.22}},
 {id:'bloodPact',icon:'☄',name:'BLOOD PACT',desc:'Deal 10% more weapon damage and recover vitality with each defeat.',apply:p=>{p.damage*=1.1;p.lifeOnKill=(p.lifeOnKill||0)+1.8}}
];
function renderRelicDraft(){
 const root=$('relicGrid');if(!root||!player)return;root.innerHTML='';
 const available=shuffleInPlace(RELICS.filter(r=>!player.relics.includes(r.id)&&(!r.canTake||r.canTake(player)))).slice(0,3);
 if(!available.length){root.innerHTML=`<p class="subtitle">${tr('RELIC VAULT EMPTY')}</p>`;return}
 for(const relic of available){const b=document.createElement('button');b.type='button';b.className='relic-card';b.dataset.relic=relic.id;b.innerHTML=`<span class="glyph">${relic.icon}</span><span><b>${tr(relic.name)}</b><p>${tr(relic.desc)}</p><small>${tr('TITAN BLESSING')}</small></span>`;b.addEventListener('click',()=>claimRelic(relic.id));root.appendChild(b)}
}
function openRelicDraft(){
 if(!player)return;const available=RELICS.filter(r=>!player.relics.includes(r.id)&&(!r.canTake||r.canTake(player)));
 if(!available.length){if(player.relicFallbackRewarded){announce(tr('RELIC VAULT EMPTY'));return}const bonus=Math.max(1,Math.round(60*trialRules().reward)),previousWallet=walletShards,nextWallet=Math.min(999999999,walletShards+bonus);if(!writeStorageTransaction({[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores)})){storeNotice=tr('Storage is unavailable.');announce(storeNotice);return}walletShards=nextWallet;player.relicFallbackRewarded=true;stats.shardsEarned+=walletShards-previousWallet;updateWalletUI();announce(tr('RELIC VAULT EMPTY')+' · +'+(walletShards-previousWallet)+' ◈');return}
 mode='relic';clearHeldControls();$('relicOverlay').style.display='flex';renderRelicDraft();$('relicTitle').innerHTML=currentLanguage==='ar'?'اختر <em>أثرًا</em> من الشق':currentLanguage==='tr'?'Bir Yarık <em>Kalıntısı</em> Seç':'Claim a Rift <em>Relic</em>';updateHud();sound(310,.32,'triangle',.05);
}
function claimRelic(id){
 if(mode!=='relic'||!player)return;const relic=RELICS.find(r=>r.id===id);if(!relic||player.relics.includes(id)||(relic.canTake&&!relic.canTake(player)))return;
 relic.apply(player);player.relics.push(id);stats.relicsEarned=(stats.relicsEarned||0)+1;$('relicOverlay').style.display='none';mode='playing';last=performance.now();clearHeldControls();updateHud();announce(tr('RELIC ACQUIRED')+' · '+tr(relic.name));spawnParticles(player.x,player.y,'#ffd27c',28,1.3);sound(640,.22,'triangle',.05);if(player.xp>=player.nextXp)gainXp(0);
}

function resize(){updateRenderProfile();const dpr=Math.max(.65,Math.min(window.devicePixelRatio||1,renderProfile.dprCap||1.15,1.5));const rect=canvas.getBoundingClientRect();const cssW=Math.max(1,rect.width),cssH=Math.max(1,rect.height);let rw=Math.floor(cssW*dpr),rh=Math.floor(cssH*dpr);const maxPixels=1100000;if(rw*rh>maxPixels){const f=Math.sqrt(maxPixels/(rw*rh));rw=Math.max(1,Math.floor(rw*f));rh=Math.max(1,Math.floor(rh*f))}canvas.width=rw;canvas.height=rh;W=cssW;H=cssH;scale=rw/cssW;ctx.setTransform(scale,0,0,rh/cssH,0,0)}
window.addEventListener('resize',resize);resize();
function sound(freq=260,dur=.07,type='sine',vol=.035){if(!audioOn||settings.volume<=0)return;try{audio=audio||new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();let o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.setValueAtTime(freq,audio.currentTime);o.frequency.exponentialRampToValueAtTime(Math.max(45,freq*.45),audio.currentTime+dur);g.gain.setValueAtTime(vol*(settings.volume/100),audio.currentTime);g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+dur);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+dur)}catch(e){}}
function freshRun(){clearHeldControls();runId++;ensureDailyRecord();profile.runs++;if(!profile.weaponsUsed.includes(selectedWeapon))profile.weaponsUsed.push(selectedWeapon);profile.worldsUnlocked=Math.max(profile.worldsUnlocked||1,unlockedWorlds);saveProfile();updateLegacyBadge();const startingWorld=selectedWorldIndex,startingWave=WORLDS[startingWorld].startWave,kit=WEAPONS[selectedWeapon]||WEAPONS.aetherblade,ranks=storeRanks,doctrine=activeDoctrine(),startingHp=Math.max(1,Math.round((100+ranks.vitality*15+(doctrine.id==='warden'?22:0))*trialRules().startHp));player={x:W/2,y:H/2,r:13,vx:0,vy:0,stride:0,stepDistance:0,stepTimer:0,attackAnim:0,weaponRecoil:0,hurtFlash:0,hp:startingHp,maxHp:startingHp,weapon:selectedWeapon,weaponName:kit.name,weaponColor:kit.color,doctrine:doctrine.id,speed:kit.speed,damage:kit.damage*(1+ranks.blade*.08)*(doctrine.id==='duelist'?1.06:1),reach:kit.reach,arc:kit.arc,attackRate:kit.attackRate*(doctrine.id==='duelist'?.96:1),attackCd:0,face:0,dashCd:0,dashMax:Math.max(1.2,1.8*(1-ranks.dash*.08)*(doctrine.id==='warden'?.88:1)),dashing:0,dashX:0,dashY:0,dashTrailTimer:0,dashSerial:0,dashHitCount:0,specialCd:0,specialMax:10*(doctrine.id==='weaver'?.86:1),specialPower:70*(1+ranks.rift*.10)*(doctrine.id==='weaver'?1.24:1),damageReduction:doctrine.id==='warden'?.12:0,resonance:0,dashResonanceAwarded:false,magnetRange:165+ranks.magnet*35,invuln:0,slowUntil:0,xp:0,nextXp:30,level:1,shards:walletShards,orbitals:0,orbitT:0,kills:0,wave:startingWave,worldStart:startingWorld,relics:[],relicFallbackRewarded:false,shardMultiplier:1,dashGuardBonus:0,lifeOnKill:0,combo:0,comboTimer:0,comboBest:0,comboWindow:doctrine.id==='duelist'?3.35:2.35};enemies=[];particles=[];impactMarks=[];dashEchoes=[];slashes=[];orbs=[];rings=[];floaters=[];hazards=[];enemyBolts=[];boss=null;elapsed=0;waveElapsed=0;waveTimer=0;spawnTimer=3.8;worldEventTimer=startingWorld===0?999:5;stats={kills:0,eliteKills:0,shardsEarned:0,relicsEarned:0,bestCombo:0,comboKills:0};mode='playing';keys={};touchAttack=false;joystick.x=joystick.y=0;$('hud').style.display='flex';if($('campaignHud'))$('campaignHud').style.display='block';const startingChapter=campaignChapterIndex(startingWave);if(campaignData.chapterIndex!==startingChapter){campaignData.chapterKills=0;campaignData.chapterBoss=false;}campaignData.chapterIndex=startingChapter;saveCampaign();campaignUpdate(startingWave);['startOverlay','levelOverlay','relicOverlay','pauseOverlay','gameOverOverlay','worldOverlay','storeOverlay','legacyOverlay','settingsOverlay'].forEach(id=>$(id).style.display='none');shakeTime=shakePower=0;updateHud();$('objective').textContent=WORLDS[startingWorld].objective+' · '+activeTrial().title;spawnEnemy();announce(WORLDS[startingWorld].intro+' · '+activeTrial().title);sound(420,.17,'triangle',.045)}
function randEdge(){let pad=36,side=Math.floor(Math.random()*4);return side===0?{x:rand(pad,W-pad),y:pad}:side===1?{x:W-pad,y:rand(pad,H-pad)}:side===2?{x:rand(pad,W-pad),y:H-pad}:{x:pad,y:rand(pad,H-pad)}}
// Rift mutations rotate from wave 3 onward; the same wave always uses the same rule.
const RIFT_MUTATIONS=[
 {id:'bloodmoon',name:'BLOOD MOON',hp:1,speed:1.06,damage:1.28,spawn:1,color:'#ff557c',hint:'ENEMIES HIT HARDER'},
 {id:'ironhide',name:'IRON HIDE',hp:1.38,speed:.92,damage:1.05,spawn:1,color:'#ffd27c',hint:'ENEMIES HAVE MORE ARMOR'},
 {id:'huntpack',name:'HUNTING PACK',hp:1.08,speed:1.18,damage:1.12,spawn:1.24,color:'#a58bff',hint:'FASTER PACKS · MORE PRESSURE'},
 {id:'riftstorm',name:'RIFTSTORM',hp:1.12,speed:1.08,damage:1.08,spawn:1.16,color:'#72f6ff',hint:'RIFT PRESSURE INCREASED'}
];
function waveMutation(wave){if(!wave||wave<3)return null;return RIFT_MUTATIONS[(Math.floor((wave-3)/2))%RIFT_MUTATIONS.length]}
function announceWaveMutation(wave){const m=waveMutation(wave);if(!m)return;announce(tr('RIFT MUTATION')+' · '+tr(m.name)+' · '+tr(m.hint));rings.push({x:W/2,y:H/2,r:20,max:Math.min(W,H)*.32,life:.7,color:m.color})}
function endgameScale(wave){
 // Additional pressure begins after wave 15; Sovereign scales harder but remains capped for mobile performance.
 const late=Math.max(0,wave-15),sovereign=trialRules().id==='sovereign';
 return {hp:1+Math.min(sovereign?3.2:2.2,late*(sovereign?.12:.085)),damage:1+Math.min(sovereign?1.55:1.0,late*(sovereign?.052:.035)),speed:1+Math.min(sovereign?.48:.38,late*(sovereign?.016:.012)),elite:1+Math.min(sovereign?1.8:1.25,late*(sovereign?.06:.045))};
}
function spawnEnemy(forceBoss=false){
 if(!player)return;
 const p=randEdge();
 let type='stalker';
 if(!forceBoss){
  const r=Math.random(),wave=player.wave,opening=waveElapsed<12;
  // Opening pacing: begin with basic stalkers, then introduce enemy classes gradually.
  if(!opening){
   if(wave>=4&&waveElapsed>=21&&r<.12)type='skirmisher';
   else if(wave>=5&&waveElapsed>=24&&r<.20)type='wraith';
   else if(wave>=3&&waveElapsed>=16&&r<.38)type='spitter';
   else if(wave>=2&&waveElapsed>=12&&r<.62)type='brute';
  }
 }
 const specs={
  stalker:{r:12,hp:48,speed:79,damage:11,xp:6},
  brute:{r:19,hp:115,speed:47,damage:19,xp:11},
  spitter:{r:13,hp:42,speed:67,damage:9,xp:8},
  skirmisher:{r:11,hp:39,speed:105,damage:15,xp:9},
  wraith:{r:13,hp:58,speed:82,damage:14,xp:10}
 };
 const spec=specs[type],rules=trialRules(),mutation=waveMutation(player.wave),late=endgameScale(player.wave),scaleUp=1+(player.wave-1)*(.095+(['ascendant','void'].includes(rules.id)?.035:0));
 const hpScale=(mutation?mutation.hp:1)*late.hp,speedScale=(mutation?mutation.speed:1)*late.speed,damageScale=(mutation?mutation.damage:1)*late.damage;
 const e={x:p.x,y:p.y,type,r:spec.r,hp:spec.hp*scaleUp*rules.enemyHp*hpScale,maxHp:spec.hp*scaleUp*rules.enemyHp*hpScale,
  speed:spec.speed*(1+player.wave*.022)*rules.enemySpeed*speedScale,damage:spec.damage*rules.enemyDamage*damageScale,hitCd:rand(0,.5),spawnGrace:elapsed<1.0?3.25:0,
  attackCd:rand(1.1,2.1),flash:0,phase:rand(0,TAU),xp:Math.max(1,Math.round(spec.xp*rules.xp)),boss:false,
  dashCd:rand(1.2,2.7),windup:0,chargeTime:0,aimX:0,aimY:0,
  phaseCd:rand(2.2,4.1),invuln:0,elite:null};
 if(player.wave>=4&&waveElapsed>=21&&Math.random()<Math.min(.18,.045+(player.wave-4)*.009)*rules.eliteChance){
  const affixes=['feral','armored','volatile'];e.elite=affixes[Math.floor(Math.random()*affixes.length)];
  if(e.elite==='feral'){e.hp*=1.18;e.speed*=1.35;e.damage*=1.12;e.xp=Math.round(e.xp*1.45)}
  else if(e.elite==='armored'){e.hp*=1.9;e.speed*=.76;e.damage*=1.08;e.xp=Math.round(e.xp*1.55)}
  else{e.hp*=1.3;e.speed*=1.12;e.damage*=1.1;e.xp=Math.round(e.xp*1.7)}
  e.maxHp=e.hp;e.r*=e.elite==='armored'?1.12:1.06;
  spawnParticles(e.x,e.y,e.elite==='feral'?'#ff7698':e.elite==='armored'?'#ffd27c':'#b69aff',10,.9);
 }
 enemies.push(e);if(e.elite)announce(tr('ELITE DETECTED')+' · '+tr(({feral:'ELITE · FERAL',armored:'ELITE · ARMORED',volatile:'ELITE · VOLATILE'})[e.elite]));
}
function spawnBoss(){
 if(boss)return;
 const p=randEdge(),rules=trialRules(),late=endgameScale(player.wave),milestone=Math.max(0,Math.floor(player.wave/5)-1),kind=BOSS_ARCHETYPES[milestone%BOSS_ARCHETYPES.length],cycle=Math.floor(milestone/BOSS_ARCHETYPES.length),cycleScale=1+cycle*.34;
 const hp=850*(1+(player.wave-1)*(.105+(['ascendant','void'].includes(rules.id)?.045:0)))*rules.enemyHp*late.hp*cycleScale*(rules.id==='sovereign'?1.72:rules.id==='void'?1.48:rules.id==='ascendant'?1.22:1);
 const bossName=kind.name+(cycle===0?'':cycle===1?' · ASCENDANT':' · CATACLYSM '+(cycle+1));
 boss={x:p.x,y:p.y,type:'boss',bossKind:kind.id,r:kind.id==='behemoth'?40:kind.id==='matriarch'?36:kind.id==='sovereign'?38:34,hp,maxHp:hp,speed:(39+player.wave*1.25)*rules.enemySpeed*late.speed*(1+cycle*.08),
  damage:23*rules.enemyDamage*late.damage*cycleScale*(rules.id==='sovereign'?1.55:rules.id==='void'?1.35:rules.id==='ascendant'?1.12:1),hitCd:0,attackCd:0.9,flash:0,phase:0,xp:Math.round(100*rules.xp),boss:true,bossName,bossColor:kind.color,realmIndex:kind.realmIndex,ascensionCycle:cycle,
  pattern:0,attackPattern:0,windup:0,aimX:player.x,aimY:player.y,phaseTwo:false,phaseStage:1,exposedTime:0,staggerTime:0,fractureTime:0,echoBreaks:0};
 enemies.push(boss);
 rings.push({x:p.x,y:p.y,r:8,max:78,life:.8,color:kind.color});
 announce(bossName+' DETECTED · PHASE I');sound(90,.8,'sawtooth',.065);
}
function announce(text){const obj=$('objective'),runAt=runId,worldAt=activeWorldIndex();obj.textContent=tr(text);obj.style.color=activeWorld().sigil||'#ffd27c';setTimeout(()=>{if(!obj||runId!==runAt)return;obj.style.color='#b9c8ec';if(player&&mode!=='menu'&&activeWorldIndex()===worldAt)obj.textContent=tr(WORLDS[worldAt].objective)},1900)}
function nearestEnemy(){let bestE=null,bd=Infinity;for(const e of enemies){let d=(e.x-player.x)**2+(e.y-player.y)**2;if(d<bd){bestE=e;bd=d}}return bestE}
function spawnParticles(x,y,color,count=9,power=1){if(!settings.particles||renderProfile.maxParticles<=0)return;count=Math.min(Math.ceil(count*renderProfile.particleScale),renderProfile.maxParticles-particles.length);for(let i=0;i<count;i++){let a=rand(0,TAU),s=rand(35,210)*power,life=rand(.18,.6);particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life,max:life,r:rand(1.3,3.6)*power,color})}}
function spawnKineticSparks(x,y,color,count=8,power=1){
 if(!settings.particles||renderProfile.maxParticles<=0)return;
 const available=Math.max(0,renderProfile.maxParticles-particles.length);
 const n=Math.min(available,Math.ceil(count*renderProfile.particleScale),24);
 for(let i=0;i<n;i++){
  const a=rand(0,TAU),speed=rand(90,270)*power,life=rand(.16,.42);
  particles.push({x,y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed-rand(6,40),life,max:life,r:rand(.8,2.1)*power,color,gravity:420,drag:.34,streak:true});
 }
}
function spawnImpactMark(x,y,color,energy=1){
 if(!settings.particles)return;
 const maxMarks=settings.quality==='low'?4:settings.quality==='balanced'?8:14;
 impactMarks.push({x,y,r:2,maxR:16+energy*16,life:.34+Math.min(.18,energy*.08),maxLife:.34+Math.min(.18,energy*.08),color,seed:rand(0,TAU),spokes:energy>1.2?8:energy>.85?6:4});
 if(impactMarks.length>maxMarks)impactMarks.splice(0,impactMarks.length-maxMarks);
}
function drawImpactMark(m){
 const fade=clamp(m.life/m.maxLife,0,1),progress=1-fade,r=m.r+(m.maxR-m.r)*progress;
 ctx.save();ctx.globalAlpha=fade*.52;ctx.strokeStyle=m.color;ctx.lineWidth=.8+fade*.65;ctx.lineCap='round';
 ctx.beginPath();ctx.arc(m.x,m.y,r*.45,m.seed,m.seed+Math.PI*1.45);ctx.stroke();
 for(let i=0;i<m.spokes;i++){
  const a=m.seed+i*TAU/m.spokes,reach=r*(.67+((i*7)%4)*.075),start=r*.16;
  const mx=m.x+Math.cos(a+.08)*reach*.58,my=m.y+Math.sin(a+.08)*reach*.58;
  ctx.beginPath();ctx.moveTo(m.x+Math.cos(a)*start,m.y+Math.sin(a)*start);ctx.lineTo(mx,my);ctx.lineTo(m.x+Math.cos(a-.035)*reach,m.y+Math.sin(a-.035)*reach);ctx.stroke();
 }
 ctx.restore();
}
function addDashEcho(){
 if(!player||!settings.particles||renderProfile.maxParticles<=0)return;
 dashEchoes.push({x:player.x,y:player.y,face:player.face,color:(WEAPONS[player.weapon]||WEAPONS.aetherblade).color,life:.15,max:.15});
 const cap=settings.quality==='low'?3:settings.quality==='balanced'?5:8;if(dashEchoes.length>cap)dashEchoes.shift();
}
function drawDashEcho(d){
 const a=clamp(d.life/d.max,0,1);ctx.save();ctx.globalAlpha*a*.24;ctx.translate(d.x,d.y);ctx.rotate(d.face);ctx.fillStyle=d.color;ctx.strokeStyle=d.color;ctx.lineCap='round';
 ctx.beginPath();ctx.ellipse(0,0,8,10,0,0,TAU);ctx.fill();ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(-3,5);ctx.lineTo(-6,12);ctx.moveTo(4,5);ctx.lineTo(6,12);ctx.moveTo(5,3);ctx.lineTo(24,2);ctx.stroke();
 ctx.restore();
}
function floating(x,y,text,color='#fff0c9'){floaters.push({x,y,text,color,life:.8,max:.8})}
function updateComboHud(){const el=$("comboHud");if(!el)return;if(!player||player.combo<2){el.style.display="none";return}el.style.display="block";el.textContent=tr("RIFT CHAIN · ×1").replace("×1", "×"+player.combo)+" · "+tr("BEST RIFT CHAIN · ")+Math.max(player.comboBest||0,stats.bestCombo||0)}
function registerComboHit(kills){
 if(!player||kills<=0)return;
 const previous=player.combo||0;player.combo=Math.min(99,previous+kills);player.comboTimer=player.comboWindow||2.35;player.comboBest=Math.max(player.comboBest||0,player.combo);stats.bestCombo=Math.max(stats.bestCombo||0,player.combo);stats.comboKills=(stats.comboKills||0)+kills;updateComboHud();
 if(player.combo>=3)floating(player.x,player.y-36,tr('CHAIN')+' ×'+player.combo,"#ffd27c");
 const crossed=comboTierCrossings(previous,player.combo,5);
 if(crossed>0){
  const bonus=Math.min(20,crossed*2),nextWallet=Math.min(999999999,walletShards+bonus);
  if(writeStorageTransaction({[WALLET_KEY]:String(nextWallet),[STORE_KEY]:JSON.stringify(storeRanks),[CORE_KEY]:String(eclipseCores)})){
   const granted=nextWallet-walletShards;walletShards=nextWallet;player.shards=(player.shards||0)+granted;stats.shardsEarned=(stats.shardsEarned||0)+granted;
   player.resonance=Math.min(3,(player.resonance||0)+crossed);floating(player.x,player.y-48,tr('CHAIN BONUS +')+granted,"#ffd27c");
   announce(tr('RIFT CHAIN')+' ×'+player.combo+' · '+tr('MILESTONE REACHED'));
  }else{storeNotice=tr('Storage is unavailable.');announce('SAVE FAILED · CHAIN REWARD NOT APPLIED');}
 }
}
function slash(){
 if(mode!=='playing'||player.attackCd>0)return;
 const kit=WEAPONS[player.weapon]||WEAPONS.aetherblade;
 player.attackCd=player.attackRate;player.attackAnim=.26;player.weaponRecoil=player.weapon==='duskcleaver'?.72:.34;
 const t=nearestEnemy();if(t&&dist(player,t)<player.reach+60)player.face=angle(player,t);
 const a=player.face,arc=player.arc,reach=player.reach;
 slashes.push({x:player.x,y:player.y,a,arc,reach,life:player.weapon==='duskcleaver'?.27:.19,max:player.weapon==='duskcleaver'?.27:.19,weapon:player.weapon,color:kit.color});
 sound(player.weapon==='duskcleaver'?190:player.weapon==='twinfangs'?430:player.weapon==='riftlance'?270:340,.065,'triangle',.025);
 let hit=0;
 for(let e of [...enemies]){
  const d=dist(player,e),a2=angle(player,e),diff=Math.atan2(Math.sin(a2-a),Math.cos(a2-a));
  if(d<reach+e.r&&Math.abs(diff)<arc/2){
   const chainPower=comboDamageBonus(player.combo,player.doctrine);const amount=weaponDamageForHit(player.weapon,player.damage,hit)*(1+chainPower)*(1+Math.random()*.08);
   damageEnemy(e,amount,a);hit++;
   if(player.weapon==='duskcleaver'&&!e.boss&&enemies.includes(e)){e.x+=Math.cos(a)*21;e.y+=Math.sin(a)*21}
  }
 }
 if(hit){registerComboHit(hit);spawnParticles(player.x+Math.cos(a)*Math.min(46,reach*.62),player.y+Math.sin(a)*Math.min(46,reach*.62),kit.color,Math.min(18,hit*7),.8)}
}
function damageEnemy(e,amount,from){if(!enemies.includes(e))return;if(e.elite==='armored')amount*=.72;if(e.boss&&(e.fractureTime||0)>0)amount*=1.3;if(e.boss&&(e.exposedTime||0)>0){amount*=1.45;floating(e.x,e.y-e.r-25,'WEAKPOINT ×1.45','#ffd27c')}e.hp-=amount;e.flash=.15;const hitAngle=typeof from==='number'?from:(from&&Number.isFinite(from.x)?angle(from,e):angle(player,e));const impulse=e.boss?34:e.type==='brute'?92:124;e.kbX=(e.kbX||0)+Math.cos(hitAngle)*impulse;e.kbY=(e.kbY||0)+Math.sin(hitAngle)*impulse;e.hitStun=Math.max(e.hitStun||0,e.boss?.026:e.elite==='armored'?.045:.075);const impactColor=e.boss?(e.bossColor||'#ff9fbe'):e.elite==='armored'?'#ffd27c':e.elite==='volatile'?'#b69aff':'#d8edff';spawnParticles(e.x,e.y,impactColor,e.boss?7:5,e.boss?.48:.32);if(e.boss||e.elite||amount>=25)spawnKineticSparks(e.x,e.y,impactColor,e.boss?12:amount>=32?8:5,e.boss?1.15:amount>=32?.9:.62);if(e.boss||amount>=32)spawnImpactMark(e.x,e.y,impactColor,e.boss?1.35:1);triggerShake(e.boss?(amount>=25?1.55:.65):(amount>=30?.8:.22));hitStopTime=Math.max(hitStopTime,e.boss?.04:amount>=30?.028:.016);floating(e.x,e.y-e.r-7,Math.round(amount),'#c6fbff');if(e.hp<=0)killEnemy(e,from)}
function killEnemy(e,from){let idx=enemies.indexOf(e);if(idx<0)return;enemies.splice(idx,1);if(e.boss){boss=null;hazards=hazards.filter(h=>!h.bossOwned)}player.kills++;stats.kills++;campaignKill(e);if(e.elite)stats.eliteKills++;if(player.lifeOnKill>0)player.hp=Math.min(player.maxHp,player.hp+player.lifeOnKill);awardShards(e);spawnParticles(e.x,e.y,e.boss?(e.bossColor||'#ff74b2'):e.elite==='feral'?'#ff7698':e.elite==='armored'?'#ffd27c':e.elite==='volatile'?'#b69aff':e.type==='spitter'?'#a58bff':'#ff875f',e.elite?28:e.boss?42:13,e.elite?1.3:e.boss?1.6:1);sound(e.boss?75:140,.15,'sawtooth',e.boss?.055:.025);if(e.elite==='volatile'){rings.push({x:e.x,y:e.y,r:8,max:82,life:.38,color:'#b69aff'});for(const nearby of [...enemies])if(dist(e,nearby)<82)damageEnemy(nearby,34+player.wave*1.1,e)}let xp=e.xp;orbs.push({x:e.x,y:e.y,r:e.boss?9:e.elite?7:5,xp,life:15,color:e.boss?'#ffd27c':e.elite?'#b69aff':'#72f6ff'});if(e.boss){const realmAtDefeat=worldIndexForWave(player.wave);const proposedUnlock=Math.max(unlockedWorlds,Math.min(WORLDS.length,realmAtDefeat+2));if(saveWorldProgress(proposedUnlock))announce('TITAN VANQUISHED · REALM PATH OPEN');else announce('SAVE FAILED · REALM UNLOCK NOT SAVED');player.hp=Math.min(player.maxHp,player.hp+25);rings.push({x:e.x,y:e.y,r:10,max:240,life:.8,color:'#ffd27c'});awardEclipseCoreFromTitan(e)}recordEnemyDefeat(!!e.boss);if($('legacyOverlay').style.display==='flex')renderLegacy();if(e.boss)openRelicDraft()}
function voidRupture(){
 if(mode!=='playing'||!player)return;
 if(eclipseCores<1){announce('NO ECLIPSE CORE · BREAK A TITAN CAST AND DEFEAT IT');sound(150,.09,'square',.02);return}
 if(!boss||!enemies.includes(boss)){announce('VOID RUPTURE ONLY TARGETS A LIVING TITAN');sound(150,.09,'square',.02);return}
 const target=boss,cost=1,removed=Math.max(1,target.hp*.5);
 eclipseCores=Math.max(0,eclipseCores-cost);saveEconomy();updateWalletUI();
 target.hp=Math.max(1,target.hp-removed);target.flash=.32;target.fractureTime=Math.max(target.fractureTime||0,1.25);target.staggerTime=Math.max(target.staggerTime||0,.72);
 rings.push({x:target.x,y:target.y,r:8,max:Math.min(W,H)*.58,life:.8,color:'#d58aff'});rings.push({x:target.x,y:target.y,r:target.r+12,max:target.r+84,life:.52,color:'#f0c4ff'});
 spawnParticles(target.x,target.y,'#d58aff',58,1.7);floating(target.x,target.y-target.r-28,'VOID RUPTURE · −50% HP','#e4b2ff');triggerShake(5.6);recordSpecialUse();announce('VOID RUPTURE · HALF THE TITAN’S REMAINING VITALITY ERASED');sound(72,.6,'sawtooth',.065);updateHud();
}
function dash(){if(mode!=='playing'||player.dashCd>0)return;let vx=(keys.d||keys.arrowright?1:0)-(keys.a||keys.arrowleft?1:0)+joystick.x,vy=(keys.s||keys.arrowdown?1:0)-(keys.w||keys.arrowup?1:0)+joystick.y;let len=Math.hypot(vx,vy);if(len<.1){vx=Math.cos(player.face);vy=Math.sin(player.face)}else{vx/=len;vy/=len}player.dashX=vx;player.dashY=vy;player.dashing=.19;player.dashSerial=(player.dashSerial||0)+1;player.dashHitCount=0;player.dashResonanceAwarded=false;player.dashCd=player.dashMax;player.invuln=.3+(player.doctrine==='warden'?.16:0)+(player.dashGuardBonus||0);spawnParticles(player.x,player.y,'#72f6ff',12,1.1);sound(600,.11,'triangle',.035)}
function special(){
 if(mode!=='playing'||player.specialCd>0)return;
 const empowered=(player.resonance||0)>=3;
 if(empowered)player.resonance=0;
 triggerShake(empowered?4.2:2.6);player.specialCd=player.specialMax;recordSpecialUse();
 const rad=Math.min(W,H)*.46,color=empowered?'#72f6ff':'#a58bff';
 rings.push({x:player.x,y:player.y,r:12,max:rad,life:empowered?.68:.48,color});
 spawnParticles(player.x,player.y,empowered?'#72f6ff':'#ad91ff',empowered?64:40,empowered?1.9:1.6);
 let interruptedTitan=false,fracturedTitan=false;
 for(const e of [...enemies]){
  const d=dist(player,e);
  if(d>=rad)continue;
  damageEnemy(e,player.specialPower*(empowered?1.5:1)*(1-.4*d/rad),angle(player,e));
  if(empowered&&e.boss&&enemies.includes(e)){
   e.fractureTime=Math.max(e.fractureTime||0,3.2);
   if((e.windup||0)>0){
    e.windup=0;e.staggerTime=Math.max(e.staggerTime||0,1.25);e.attackCd=Math.max(e.attackCd,1.45);
    e.echoBreaks=(e.echoBreaks||0)+1;interruptedTitan=true;
    rings.push({x:e.x,y:e.y,r:e.r,max:e.r+68,life:.55,color:'#72f6ff'});
    spawnParticles(e.x,e.y,'#72f6ff',30,1.25);
   }else{fracturedTitan=true}
  }
  const a=angle(player,e);e.x+=Math.cos(a)*Math.min(empowered?76:58,rad*.2);e.y+=Math.sin(a)*Math.min(empowered?76:58,rad*.2);
 }
 if(empowered){
  enemyBolts=enemyBolts.filter(b=>dist(player,b)>rad);hazards=hazards.filter(h=>dist(player,h)>rad*.78);
  player.hp=Math.min(player.maxHp,player.hp+12+(player.doctrine==='weaver'?5:0));floating(player.x,player.y-30,tr('Rift Echo'),'#72f6ff');sound(125,.55,'sawtooth',.065);
  announce(tr(interruptedTitan?'ECHO BREAK · TITAN STAGGERED':fracturedTitan?'RIFT FRACTURE · TITAN EXPOSED':'RIFT ECHO RELEASED'));
 }else{player.hp=Math.min(player.maxHp,player.hp+6);sound(170,.42,'sawtooth',.055);announce(tr('RIFT BURST RELEASED'))}
 updateHud();
}

function gainResonance(){if(!player||player.resonance>=3||player.dashResonanceAwarded)return false;player.resonance=Math.min(3,player.resonance+1);player.dashResonanceAwarded=true;spawnParticles(player.x,player.y,'#72f6ff',18,1.12);spawnKineticSparks(player.x,player.y,'#72f6ff',8,.55);spawnImpactMark(player.x,player.y,'#72f6ff',1.15);rings.push({x:player.x,y:player.y,r:9,max:54,life:.36,color:'#72f6ff'});hitStopTime=Math.max(hitStopTime,.025);floating(player.x,player.y-34,tr('PERFECT DODGE'),'#72f6ff');sound(760,.08,'sine',.025);if(player.resonance>=3)announce('RIFT ECHO READY');else floating(player.x,player.y-18,'+1 '+tr('RESONANCE'),'#72f6ff');updateHud();return true}
function hurtPlayer(n,e){if(player.invuln>0||player.dashing>0||mode!=='playing')return;if(player.doctrine==='warden')n*=.88;triggerShake(5.2);hitStopTime=Math.max(hitStopTime,.045);player.hp-=n;player.invuln=.52;player.hurtFlash=.18;let a=angle(e,player);player.vx=(player.vx||0)+Math.cos(a)*165;player.vy=(player.vy||0)+Math.sin(a)*165;player.x+=Math.cos(a)*5;player.y+=Math.sin(a)*5;spawnParticles(player.x,player.y,'#ff5c97',12,1);sound(105,.13,'square',.04);floating(player.x,player.y-25,'-'+Math.round(n),'#ff829e');if(player.hp<=0){player.hp=0;gameOver()}}
function gainXp(value){player.xp+=value;while(player.xp>=player.nextXp){player.xp-=player.nextXp;player.level++;player.nextXp=Math.floor(player.nextXp*1.22+9);levelUp();break}}
function levelUp(){mode='level';$('levelOverlay').style.display='flex';let available=shuffleInPlace(upgrades.filter(u=>!u.canTake||u.canTake(player))).slice(0,3);let root=$('upgrades');root.innerHTML='';for(const u of available){let b=document.createElement('button');b.className='upgrade';b.innerHTML=`<span class="glyph">${u.icon}</span><b>${u.name}</b><p>${u.desc}</p>`;b.addEventListener('click',()=>{u.apply(player);$('levelOverlay').style.display='none';mode='playing';player.hp=Math.min(player.maxHp,player.hp+5);updateHud();sound(540,.15,'triangle',.045);if(player.xp>=player.nextXp)gainXp(0)});root.appendChild(b)}sound(500,.35,'sine',.04);updateHud()}
function updateHud(){if(!player)return;if($('weaponHud'))$('weaponHud').textContent=tr('STYLE')+' · '+tr(player.weaponName).toUpperCase();if($('doctrineHud'))$('doctrineHud').textContent=tr('PATH')+' · '+tr((DOCTRINES.find(d=>d.id===player.doctrine)||DOCTRINES[0]).name);if($('realmHud'))$('realmHud').textContent=tr('REALM')+' '+['I','II','III'][activeWorldIndex()]+' · '+tr(activeWorld().title);if($('trialHud'))$('trialHud').textContent=tr('TRIAL')+' · '+tr(activeTrial().title)+' · ×'+activeTrial().reward.toFixed(2).replace(/0$/,'');if($('relicHud'))$('relicHud').textContent=tr('RIFT RELICS')+' · '+(player.relics?player.relics.length:0)+' / '+RELICS.length;$('hpFill').style.width=clamp(player.hp/player.maxHp*100,0,100)+'%';$('hpText').textContent=Math.ceil(player.hp)+' / '+player.maxHp;$('xpFill').style.width=clamp(player.xp/player.nextXp*100,0,100)+'%';$('xpText').textContent=Math.floor(player.xp)+' / '+player.nextXp;$('waveText').textContent=String(player.wave).padStart(2,'0');$('levelText').textContent=String(player.level).padStart(2,'0');$('shardsText').textContent=String(walletShards);const resonance=clamp(player.resonance||0,0,3);$('resonanceFill').style.width=(resonance/3*100)+'%';$('resonanceText').textContent=resonance+' / 3';if($('coresText'))$('coresText').textContent=String(eclipseCores);if($('voidRuptureBtn')){$('voidRuptureBtn').classList.toggle('cool',!(boss&&eclipseCores>0));$('voidRuptureBtn').title=tr('VOID RUPTURE')+' · '+eclipseCores+' '+tr('ECLIPSE CORES')+' · '+tr('HALF TITAN HP')}$('dashBtn').classList.toggle('cool',player.dashCd>0);$('specialBtn').classList.toggle('cool',player.specialCd>0);$('specialBtn').classList.toggle('resonance-ready',resonance>=3);$('specialBtn').title=tr(resonance>=3?'RIFT ECHO READY':'RIFT BURST');$('specialBtn').setAttribute('aria-label',tr(resonance>=3?'RIFT ECHO READY':'RIFT BURST'))}
function gameOver(){mode='over';saveBestWave();$('finalCombo').textContent=tr('BEST RIFT CHAIN · ')+(stats.bestCombo||0);$('gameOverOverlay').style.display='flex';$('finalWave').textContent=String(player.wave).padStart(2,'0');$('finalKills').textContent=player.kills;$('finalLevel').textContent=String(player.level).padStart(2,'0');$('finalElites').textContent=String(stats.eliteKills||0);$('trialFinalLabel').textContent=tr('TRIAL')+' · '+tr(activeTrial().title)+' · '+tr('SHARD MULTIPLIER')+' ×'+activeTrial().reward.toFixed(2).replace(/0$/,'');$('rewardFinalLabel').textContent=tr('SHARDS EARNED')+' · '+String(stats.shardsEarned||0)+' ◈';if($('finalRelics'))$('finalRelics').textContent=tr('RELICS CLAIMED')+' · '+String(stats.relicsEarned||0);if($('finalDoctrine'))$('finalDoctrine').textContent=tr('COMBAT PATH')+' · '+tr((DOCTRINES.find(d=>d.id===(player&&player.doctrine))||activeDoctrine()).name);updateBestUI();sound(75,.75,'sawtooth',.05)}
function togglePause(){if(mode==='playing'){clearHeldControls();mode='paused';$('pauseOverlay').style.display='flex';last=performance.now()}else if(mode==='paused'){clearHeldControls();mode='playing';$('pauseOverlay').style.display='none';last=performance.now()}}
function hazardColor(type){return ({frost:'#92deff',ember:'#ff713e',umbra:'#dc73ff',void:'#b69aff',root:'#8bf49a'})[type]||'#8bf49a'}
function markBossZone(e,x,y,type,radius,damage){
 const px=clamp(x,42,W-42),py=clamp(y,42,H-42),color=hazardColor(type);
 if(hazards.length>22)hazards.shift();
 hazards.push({x:px,y:py,r:radius,warning:e.windup,active:.58,damage,type,hit:false,released:false,bossOwned:true});
 rings.push({x:px,y:py,r:4,max:radius,life:e.windup,color,warning:true});
}
function bossBoltFan(e,count,spread,speed,damage,color,r=6){
 const center=Math.atan2(e.aimY-e.y,e.aimX-e.x);
 for(let i=0;i<count;i++){
  const t=count===1?.5:i/(count-1),a=center-spread+(2*spread*t);
  enemyBolts.push({x:e.x,y:e.y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,r,life:3.1,damage,color});
 }
}
function bossRadialBolts(e,count,speed,damage,color,r=6,offset=0){
 for(let i=0;i<count;i++){
  const a=i*TAU/count+offset;
  enemyBolts.push({x:e.x,y:e.y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,r,life:3.15,damage,color});
 }
}
function beginBossAttack(e){
 const d=dist(e,player);
 if(d>560){e.attackCd=.4;return}
 const stage=e.phaseStage||1,patternCount=stage>=3?4:3;
 e.attackPattern=e.pattern%patternCount;e.pattern++;
 e.aimX=player.x;e.aimY=player.y;
 e.windup=stage>=3?.52:e.phaseTwo?.61:.86;
 const center=Math.atan2(e.aimY-e.y,e.aimX-e.x),px=-Math.sin(center),py=Math.cos(center),intensity=stage>=3?1.28:stage===2?1.12:1;
 if(e.bossKind==='devourer'){
  if(e.attackPattern===0){markBossZone(e,e.aimX,e.aimY,'ember',52+stage*5,22*intensity);announce('ASHEN DEVOURER · CINDER MAW')}
  else if(e.attackPattern===1){rings.push({x:e.x,y:e.y,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.aimX,y:e.aimY},warning:true});announce('ASHEN DEVOURER · MOLTEN CHARGE')}
  else if(e.attackPattern===2){for(let i=-2;i<=2;i++)markBossZone(e,e.aimX+px*i*40,e.aimY+py*i*40,'ember',27,15*intensity);announce('ASHEN DEVOURER · CINDER TRACK')}
  else{for(let i=0;i<8;i++){const a=i*TAU/8;markBossZone(e,e.aimX+Math.cos(a)*74,e.aimY+Math.sin(a)*74,'ember',25,17*intensity)}announce('ASHEN DEVOURER · SUNFALL')}
  return;
 }
 if(e.bossKind==='matriarch'){
  if(e.attackPattern===0){for(const [ox,oy] of [[-58,-35],[58,-35],[-58,35],[58,35]])markBossZone(e,e.aimX+ox,e.aimY+oy,'umbra',30,17*intensity);announce('GLOAM MATRIARCH · WEB OF DUSK')}
  else if(e.attackPattern===1){rings.push({x:e.x,y:e.y,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.aimX,y:e.aimY},warning:true});announce('GLOAM MATRIARCH · SILK PIERCER')}
  else if(e.attackPattern===2){for(let i=0;i<6;i++){const a=i*TAU/6;markBossZone(e,e.x+Math.cos(a)*66,e.y+Math.sin(a)*66,'umbra',25,16*intensity)}announce('GLOAM MATRIARCH · WIDOW RING')}
  else{for(let i=0;i<9;i++){const a=i*TAU/9;markBossZone(e,e.aimX+Math.cos(a)*86,e.aimY+Math.sin(a)*86,'umbra',22,16*intensity)}announce('GLOAM MATRIARCH · NIGHT BLOOM')}
  return;
 }
 if(e.bossKind==='behemoth'){
  if(e.attackPattern===0){for(const [ox,oy] of [[0,0],[-55,-32],[55,-32],[-45,49],[45,49]])markBossZone(e,e.aimX+ox,e.aimY+oy,'frost',31,20*intensity);announce('GLACIAL BEHEMOTH · GLACIER BREAK')}
  else if(e.attackPattern===1){const length=Math.hypot(W,H),dx=Math.cos(center),dy=Math.sin(center);for(const off of [-46,0,46])rings.push({x:e.x+px*off-dx*length,y:e.y+py*off-dy*length,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.x+px*off+dx*length,y:e.y+py*off+dy*length},warning:true});announce('GLACIAL BEHEMOTH · THREEFOLD LANCE')}
  else if(e.attackPattern===2){for(let i=0;i<5;i++){const a=i*TAU/5;markBossZone(e,e.aimX+Math.cos(a)*56,e.aimY+Math.sin(a)*56,'frost',29,18*intensity)}announce('GLACIAL BEHEMOTH · ICE CROWN')}
  else{for(let i=0;i<10;i++){const a=i*TAU/10;markBossZone(e,e.aimX+Math.cos(a)*94,e.aimY+Math.sin(a)*94,'frost',22,17*intensity)}announce('GLACIAL BEHEMOTH · WHITEOUT BURST')}
  return;
 }
 if(e.bossKind==='archon'){
  if(e.attackPattern===0){const length=Math.hypot(W,H);rings.push({x:e.x-Math.cos(center)*length,y:e.y-Math.sin(center)*length,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.x+Math.cos(center)*length,y:e.y+Math.sin(center)*length},warning:true});rings.push({x:e.x-px*length,y:e.y-py*length,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.x+px*length,y:e.y+py*length},warning:true});announce('VOID ARCHON · NULL CROSS')}
  else if(e.attackPattern===1){for(let i=0;i<6;i++){const a=i*TAU/6;markBossZone(e,e.aimX+Math.cos(a)*62,e.aimY+Math.sin(a)*62,'void',27,17*intensity)}announce('VOID ARCHON · SINGULARITY MARKS')}
  else if(e.attackPattern===2){markBossZone(e,e.aimX,e.aimY,'void',46,21*intensity);rings.push({x:e.x,y:e.y,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.aimX,y:e.aimY},warning:true});announce('VOID ARCHON · GRAVITY WELL')}
  else{for(let i=0;i<12;i++){const a=i*TAU/12;markBossZone(e,e.aimX+Math.cos(a)*100,e.aimY+Math.sin(a)*100,'void',21,16*intensity)}announce('VOID ARCHON · EVENT HORIZON')}
  return;
 }
 if(e.bossKind==='sovereign'){
  if(e.attackPattern===0){for(let i=0;i<7;i++){const a=i*TAU/7;markBossZone(e,e.aimX+Math.cos(a)*66,e.aimY+Math.sin(a)*66,'void',25,18*intensity)}announce('RIFT SOVEREIGN · CROWN OF RUIN')}
  else if(e.attackPattern===1){const length=Math.hypot(W,H);rings.push({x:e.x-length,y:e.aimY,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.x+length,y:e.aimY},warning:true});rings.push({x:e.aimX,y:e.y-length,r:0,max:0,life:e.windup,color:e.bossColor,lineTo:{x:e.aimX,y:e.y+length},warning:true});announce('RIFT SOVEREIGN · WORLD SPLITTER')}
  else if(e.attackPattern===2){markBossZone(e,e.aimX,e.aimY,'void',54,23*intensity);for(let i=0;i<4;i++){const a=i*TAU/4;markBossZone(e,e.x+Math.cos(a)*76,e.y+Math.sin(a)*76,'void',24,15*intensity)}announce('RIFT SOVEREIGN · COLLAPSE')}
  else{for(let i=0;i<12;i++){const a=i*TAU/12;markBossZone(e,e.aimX+Math.cos(a)*102,e.aimY+Math.sin(a)*102,'void',22,17*intensity)}announce('RIFT SOVEREIGN · LAST ORBIT')}
  return;
 }
 if(e.realmIndex===1){
  const intensity=stage>=3?1.2:stage===2?1.08:1;
  if(e.attackPattern===0){
   for(const offset of [-58,0,58])markBossZone(e,e.aimX+px*offset,e.aimY+py*offset,'root',35,17*intensity);
   announce('THORN TITAN · ROOT SNARE');
  }else if(e.attackPattern===1){
   rings.push({x:e.x,y:e.y,r:0,max:0,life:e.windup,color:e.bossColor||'#8bf49a',lineTo:{x:e.aimX,y:e.aimY},warning:true});
   announce('THORN TITAN · VINE LASH');
  }else if(e.attackPattern===2){
   for(const [ox,oy] of [[-48,-42],[48,-42],[-48,42],[48,42]])markBossZone(e,e.aimX+ox,e.aimY+oy,'root',30,15*intensity);
   announce('THORN TITAN · BRAMBLE BURST');
  }else{
   for(let i=0;i<6;i++){const a=i*TAU/6;markBossZone(e,e.aimX+Math.cos(a)*63,e.aimY+Math.sin(a)*63,'root',29,16*intensity)}
   announce('THORN TITAN · OVERGROWTH');
  }
  return;
 }
 if(e.realmIndex===2){
  const intensity=stage>=3?1.22:stage===2?1.1:1;
  if(e.attackPattern===0){
   for(const [ox,oy] of [[0,0],[-62,-30],[62,-30],[-42,54],[42,54]])markBossZone(e,e.aimX+ox,e.aimY+oy,'frost',32,18*intensity);
   announce('FROST TITAN · FROSTFALL');
  }else if(e.attackPattern===1){
   const length=Math.hypot(W,H),dx=Math.cos(center),dy=Math.sin(center);
   rings.push({x:e.x-dx*length,y:e.y-dy*length,r:0,max:0,life:e.windup,color:e.bossColor||'#92deff',lineTo:{x:e.x+dx*length,y:e.y+dy*length},warning:true});
   announce('FROST TITAN · GLACIAL LANCE');
  }else if(e.attackPattern===2){
   for(let i=0;i<4;i++){const a=i*TAU/4+Math.PI/4;markBossZone(e,e.aimX+Math.cos(a)*52,e.aimY+Math.sin(a)*52,'frost',35,18*intensity)}
   announce('FROST TITAN · WHITEOUT');
  }else{
   for(let i=0;i<7;i++){const a=i*TAU/7;markBossZone(e,e.aimX+Math.cos(a)*76,e.aimY+Math.sin(a)*76,'frost',27,20*intensity)}
   announce('FROST TITAN · AVALANCHE');
  }
  return;
 }
 if(e.attackPattern===0){
  rings.push({x:e.x,y:e.y,r:18,max:150,life:e.windup,color:'#ff5c97',warning:true});
  announce('TITAN · RIFT NOVA');
 }else if(e.attackPattern===1){
  rings.push({x:e.x,y:e.y,r:0,max:0,life:e.windup,color:'#ffb16c',lineTo:{x:e.aimX,y:e.aimY},warning:true});
  announce('TITAN · AIMED VOLLEY');
 }else if(e.attackPattern===2){
  rings.push({x:e.x,y:e.y,r:18,max:148,life:e.windup,color:'#ff875f',warning:true});
  announce('TITAN · SHATTER SLAM');
 }else{
  const length=Math.hypot(W,H),dx=Math.cos(center),dy=Math.sin(center);
  rings.push({x:e.x-dx*length,y:e.y-dy*length,r:0,max:0,life:e.windup,color:'#c2a0ff',lineTo:{x:e.x+dx*length,y:e.y+dy*length},warning:true});
  rings.push({x:e.x+dy*length,y:e.y-dx*length,r:0,max:0,life:e.windup,color:'#c2a0ff',lineTo:{x:e.x-dy*length,y:e.y+dx*length},warning:true});
  announce('TITAN · CROSS-LATTICE · MOVE!');
 }
}
function releaseBossAttack(e){
 const stage=e.phaseStage||1,speed=stage>=3?180:e.phaseTwo?152:124,damage=stage>=3?17:e.phaseTwo?14:12,c=e.bossColor||'#b69aff';
 if(['devourer','matriarch','behemoth','archon','sovereign'].includes(e.bossKind)){
  const count=stage>=3?22:e.phaseTwo?16:12,scale=stage>=3?1.25:stage===2?1.1:1;
  if(e.bossKind==='devourer'){
   if(e.attackPattern===0){bossRadialBolts(e,count,speed*.8,damage*scale,c,6,elapsed*.17);rings.push({x:e.aimX,y:e.aimY,r:8,max:130,life:.5,color:c})}
   else if(e.attackPattern===1){bossBoltFan(e,stage>=3?11:8,.48,speed+45,damage*scale,c,7);e.x=clamp(e.x+Math.cos(Math.atan2(e.aimY-e.y,e.aimX-e.x))*42,30,W-30);e.y=clamp(e.y+Math.sin(Math.atan2(e.aimY-e.y,e.aimX-e.x))*42,30,H-30)}
   else if(e.attackPattern===2){bossBoltFan(e,stage>=3?13:9,.88,speed+18,damage*.85*scale,c,6)}
   else{bossRadialBolts(e,stage>=3?28:20,speed*.92,damage*scale,c,7,elapsed*.21)}
  }else if(e.bossKind==='matriarch'){
   if(e.attackPattern===0){bossBoltFan(e,stage>=3?11:8,.72,speed+12,damage*scale,c,6)}
   else if(e.attackPattern===1){bossBoltFan(e,stage>=3?13:9,.34,speed+58,damage*scale,c,7);bossBoltFan(e,stage>=3?7:5,.16,speed+28,damage*.8*scale,c,5)}
   else if(e.attackPattern===2){bossRadialBolts(e,stage>=3?26:18,speed*.78,damage*.92*scale,c,6,elapsed*.13)}
   else{bossRadialBolts(e,stage>=3?30:22,speed*.86,damage*scale,c,6,elapsed*.19)}
  }else if(e.bossKind==='behemoth'){
   if(e.attackPattern===0){bossRadialBolts(e,stage>=3?20:14,speed*.7,damage*1.15*scale,c,7,elapsed*.05)}
   else if(e.attackPattern===1){bossBoltFan(e,stage>=3?13:9,.2,speed+75,damage*1.1*scale,c,7)}
   else if(e.attackPattern===2){bossRadialBolts(e,stage>=3?24:17,speed*.82,damage*scale,c,6,elapsed*.12)}
   else{bossRadialBolts(e,stage>=3?34:24,speed*.92,damage*scale,c,6,elapsed*.08)}
  }else if(e.bossKind==='archon'){
   if(e.attackPattern===0){bossBoltFan(e,stage>=3?11:8,.28,speed+50,damage*scale,c,6);bossRadialBolts(e,stage>=3?16:10,speed*.63,damage*.8*scale,c,5,elapsed*.1)}
   else if(e.attackPattern===1){bossRadialBolts(e,stage>=3?26:18,speed*.75,damage*scale,c,6,elapsed*.18)}
   else if(e.attackPattern===2){bossBoltFan(e,stage>=3?15:10,.55,speed+24,damage*scale,c,7)}
   else{bossRadialBolts(e,stage>=3?36:26,speed*.89,damage*.95*scale,c,6,elapsed*.23)}
  }else{
   if(e.attackPattern===0){bossRadialBolts(e,stage>=3?28:20,speed*.88,damage*scale,c,6,elapsed*.2)}
   else if(e.attackPattern===1){bossBoltFan(e,stage>=3?15:11,.7,speed+45,damage*scale,c,7);bossBoltFan(e,stage>=3?11:7,.18,speed+15,damage*.8*scale,c,5)}
   else if(e.attackPattern===2){bossRadialBolts(e,stage>=3?32:22,speed*.85,damage*scale,c,6,elapsed*.15);bossBoltFan(e,stage>=3?9:6,.3,speed+70,damage*scale,c,7)}
   else{bossRadialBolts(e,stage>=3?40:30,speed*.95,damage*scale,c,7,elapsed*.25)}
  }
  spawnParticles(e.aimX,e.aimY,c,stage>=3?34:22,1.2);rings.push({x:e.aimX,y:e.aimY,r:8,max:stage>=3?158:122,life:.5,color:c});
  e.attackCd=stage>=3?1.08:e.phaseTwo?1.38:2.05;sound(e.attackPattern===2?85:135,.22,'sawtooth',.04);return;
 }
 if(e.realmIndex===1){
  const c=e.bossColor||'#8bf49a';
  if(e.attackPattern===1){bossBoltFan(e,stage>=3?9:7,stage>=3?.42:.28,speed+15,stage>=3?13:10,c,6)}
  else if(e.attackPattern===2){bossRadialBolts(e,stage>=3?18:12,speed*.78,stage>=3?12:9,c,5,elapsed*.12)}
  else if(e.attackPattern===3){bossRadialBolts(e,stage>=3?20:16,speed*.88,stage>=3?13:10,c,6,elapsed*.08)}
  for(const p of [{x:e.aimX,y:e.aimY}]){spawnParticles(p.x,p.y,c,stage>=3?24:15,1)}
  rings.push({x:e.aimX,y:e.aimY,r:9,max:stage>=3?126:96,life:.48,color:c});
 }else if(e.realmIndex===2){
  const c=e.bossColor||'#92deff';
  if(e.attackPattern===1){bossBoltFan(e,stage>=3?9:7,stage>=3?.18:.1,speed+62,stage>=3?16:13,c,6)}
  else if(e.attackPattern===2){bossRadialBolts(e,stage>=3?20:14,speed*.76,stage>=3?13:10,c,6,elapsed*.09)}
  else if(e.attackPattern===3){bossRadialBolts(e,stage>=3?24:18,speed*.92,stage>=3?15:12,c,7,elapsed*.06)}
  spawnParticles(e.aimX,e.aimY,c,stage>=3?28:18,1);
  rings.push({x:e.aimX,y:e.aimY,r:7,max:stage>=3?140:104,life:.52,color:c});
 }else if(e.attackPattern===0){
  const count=stage>=3?22:e.phaseTwo?16:12;
  for(let i=0;i<count;i++){
   const a=i*TAU/count+(elapsed*.22);
   enemyBolts.push({x:e.x,y:e.y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,r:stage>=3?7:e.phaseTwo?7:6,life:3.2,damage,color:e.bossColor||'#ff5c97'});
  }
  rings.push({x:e.x,y:e.y,r:15,max:stage>=3?205:178,life:.65,color:e.bossColor||'#ff5c97'});
 }else if(e.attackPattern===1){
  const center=Math.atan2(e.aimY-e.y,e.aimX-e.x),spread=stage>=3?1.0:e.phaseTwo?.72:.52,count=stage>=3?9:e.phaseTwo?7:5;
  for(let i=0;i<count;i++){
   const a=center-spread+(2*spread)*(i/Math.max(1,count-1));
   enemyBolts.push({x:e.x,y:e.y,vx:Math.cos(a)*(speed+25),vy:Math.sin(a)*(speed+25),r:6,life:3,damage,color:'#ffb16c'});
  }
 }else if(e.attackPattern===2){
  const d=dist(e,player),slamRadius=stage>=3?218:e.phaseTwo?178:148;
  rings.push({x:e.x,y:e.y,r:18,max:slamRadius+48,life:.72,color:'#ff875f'});
  spawnParticles(e.x,e.y,'#ff875f',stage>=3?36:24,1.1);
  if(d<slamRadius)hurtPlayer(stage>=3?38:e.phaseTwo?34:26,e);
  e.exposedTime=Math.max(e.exposedTime||0,stage>=3?2.8:2.25);
  announce('TITAN EXPOSED · STRIKE NOW');
 }else{
  const center=Math.atan2(e.aimY-e.y,e.aimX-e.x);
  for(const base of [center,center+Math.PI/2])for(let i=-2;i<=2;i++){
   const a=base+i*.16;
   enemyBolts.push({x:e.x,y:e.y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,r:7,life:3.1,damage,color:'#c2a0ff'});
  }
  rings.push({x:e.x,y:e.y,r:10,max:185,life:.55,color:'#c2a0ff'});
 }
 e.attackCd=stage>=3?1.08:e.phaseTwo?1.38:2.05;
 sound(e.attackPattern===2?85:135,.22,'sawtooth',.04);
}

function updateEnemy(e,dt){
 e.flash=Math.max(0,e.flash-dt);e.hitCd=Math.max(0,e.hitCd-dt);e.attackCd-=dt;
 e.hitStun=Math.max(0,(e.hitStun||0)-dt);e.x+=(e.kbX||0)*dt;e.y+=(e.kbY||0)*dt;e.kbX=(e.kbX||0)*Math.pow(.028,dt);e.kbY=(e.kbY||0)*Math.pow(.028,dt);
 e.invuln=Math.max(0,(e.invuln||0)-dt);
 const d=dist(e,player),a=angle(e,player);
 e.phase+=dt*2;
 if((e.spawnGrace||0)>0){e.spawnGrace=Math.max(0,e.spawnGrace-dt);e.x=clamp(e.x,24,W-24);e.y=clamp(e.y,24,H-24);return}
 if(e.hitStun>0){e.x=clamp(e.x,24,W-24);e.y=clamp(e.y,24,H-24);return}
 if(e.boss){
  e.staggerTime=Math.max(0,(e.staggerTime||0)-dt);
  e.fractureTime=Math.max(0,(e.fractureTime||0)-dt);
  e.exposedTime=Math.max(0,(e.exposedTime||0)-dt);
  const previousPhase=e.phaseStage||1,targetPhase=bossPhaseForHp(e.hp,e.maxHp,previousPhase);
  if(targetPhase>previousPhase){
   e.phaseStage=targetPhase;e.phaseTwo=true;
   // If one hit crosses both thresholds, enter Phase III once instead of replaying both transitions.
   if(targetPhase===2){
    e.speed*=1.18;e.attackCd=.25;
    announce('TITAN ASCENSION · PHASE II');
    rings.push({x:e.x,y:e.y,r:28,max:188,life:.9,color:'#ffb16c'});
    spawnParticles(e.x,e.y,'#ff6e9a',38,1.4);triggerShake(3.2);
   }else{
    e.speed*=1.18*1.16;e.damage*=1.12;e.attackCd=.3;
    announce('RIFT CATACLYSM · PHASE III');
    rings.push({x:e.x,y:e.y,r:40,max:Math.min(W,H)*.72,life:1.05,color:'#c2a0ff'});
    spawnParticles(e.x,e.y,'#c2a0ff',56,1.7);triggerShake(5.2);
    enemyBolts=enemyBolts.filter(b=>dist(e,b)>120);
   }
  }
  if(e.staggerTime>0){e.windup=0;}
  else if(e.windup>0){e.windup-=dt;if(e.windup<=0)releaseBossAttack(e)}
  else if(e.attackCd<=0)beginBossAttack(e);
  const speed=e.speed*(e.staggerTime>0?.12:e.windup>0?.24:1);
  if(d>e.r+player.r+26){e.x+=Math.cos(a)*speed*dt;e.y+=Math.sin(a)*speed*dt}
 }else if(e.type==='brute'){
  if(bruteSlamCanBeCountered(e.windup,d,dashActiveThisFrame?1:0,player.dashSerial,e.counteredDashSerial,e.r+player.r+26)){
   e.counteredDashSerial=player.dashSerial;e.windup=0;e.staggerTime=.72;e.attackCd=2.45;
   floating(e.x,e.y-e.r-22,'PERFECT COUNTER','#72f6ff');
   rings.push({x:e.x,y:e.y,r:14,max:78,life:.42,color:'#72f6ff'});
   spawnKineticSparks(e.x,e.y,'#72f6ff',14,.9);triggerShake(.72);hitStopTime=Math.max(hitStopTime,.045);
  }else if(e.windup>0){
   e.windup=Math.max(0,e.windup-dt);
   if(e.windup<=0){
    const slamDistance=dist(e,player);
    if(bruteSlamHits(slamDistance,112)&&e.hitCd<=0){e.hitCd=.92;hurtPlayer(e.damage*1.28,e);spawnKineticSparks(player.x,player.y,'#ffd27c',10,.7);triggerShake(1.25)}
    rings.push({x:e.x,y:e.y,r:18,max:112,life:.38,color:'#ffd27c'});spawnParticles(e.x,e.y,'#ffd27c',12,.8);e.attackCd=2.45;
   }
  }else{
   if(d>e.r+player.r+12){e.x+=Math.cos(a)*e.speed*dt;e.y+=Math.sin(a)*e.speed*dt}
   if(bruteSlamCanStart(d,e.attackCd,e.windup)){
    e.windup=.62;rings.push({x:e.x,y:e.y,r:10,max:112,life:.62,warning:true,color:'#ffd27c'});
   }
  }
 }else if(e.type==='spitter'){
  if(d>255){e.x+=Math.cos(a)*e.speed*dt;e.y+=Math.sin(a)*e.speed*dt}
  else if(d<175){e.x-=Math.cos(a)*e.speed*.78*dt;e.y-=Math.sin(a)*e.speed*.78*dt}
  if(e.attackCd<=0&&d<430){
   e.attackCd=1.85;
   rings.push({x:e.x,y:e.y,r:3,max:d,life:.42,color:'#a58bff',lineTo:{x:player.x,y:player.y}});
   const aim=angle(e,player),sp=210;
   enemyBolts.push({x:e.x,y:e.y,vx:Math.cos(aim)*sp,vy:Math.sin(aim)*sp,r:5,life:2.3,damage:e.damage,color:'#ab92ff'});
  }
 }else if(e.type==='skirmisher'){
  e.dashCd-=dt;
  if(e.chargeTime>0){
   e.chargeTime-=dt;const chargeStartX=e.x,chargeStartY=e.y;e.x+=e.aimX*e.speed*3.05*dt;e.y+=e.aimY*e.speed*3.05*dt;
   // Sweep the full movement segment so a fast skirmisher cannot tunnel through the player between frames.
   if(e.hitCd<=0&&skirmisherChargeHitsPlayer(player.x,player.y,chargeStartX,chargeStartY,e.x,e.y,e.r+player.r+1)){
    e.hitCd=.75;hurtPlayer(e.damage*1.12,e);spawnKineticSparks(player.x,player.y,'#ffd27c',9,.65);triggerShake(.85);hitStopTime=Math.max(hitStopTime,.024);
   }
   if(Math.random()<dt*20)spawnParticles(e.x,e.y,'#ffd27c',2,.45);
  }else if(e.windup>0){
   e.windup-=dt;
   if(e.windup<=0){e.chargeTime=.31;rings.push({x:e.x,y:e.y,r:8,max:32,life:.3,color:'#ffd27c'});sound(450,.08,'triangle',.018)}
  }else{
   if(d>e.r+player.r+10){e.x+=Math.cos(a)*e.speed*dt;e.y+=Math.sin(a)*e.speed*dt}
   if(d<285&&e.dashCd<=0){e.aimX=Math.cos(a);e.aimY=Math.sin(a);e.windup=.56;e.dashCd=3.35;
    rings.push({x:e.x,y:e.y,r:0,max:0,life:.56,color:'#ffd27c',lineTo:{x:player.x,y:player.y},warning:true});
   }
  }
 }else if(e.type==='wraith'){
  e.phaseCd-=dt;
  if(e.phaseCd<=0&&d<380){
   const oldX=e.x,oldY=e.y,side=a+Math.PI+rand(-.9,.9),radius=rand(105,155);
   e.x=clamp(player.x+Math.cos(side)*radius,35,W-35);e.y=clamp(player.y+Math.sin(side)*radius,35,H-35);
   e.phaseCd=rand(3.3,4.3);e.invuln=.24;
   rings.push({x:oldX,y:oldY,r:5,max:40,life:.35,color:'#7df5ff'});
   rings.push({x:e.x,y:e.y,r:5,max:45,life:.42,color:'#7df5ff'});
   spawnParticles(oldX,oldY,'#7df5ff',8,.7);spawnParticles(e.x,e.y,'#7df5ff',8,.7);
  }
  if(d>e.r+player.r+5){e.x+=Math.cos(a)*e.speed*dt;e.y+=Math.sin(a)*e.speed*dt}
 }else{
  e.x+=Math.cos(a)*e.speed*dt;e.y+=Math.sin(a)*e.speed*dt;
 }
 e.x=clamp(e.x,24,W-24);e.y=clamp(e.y,24,H-24);
 const contactDistance=dist(e,player);
 if(contactDistance<e.r+player.r+2&&e.hitCd<=0&&!(e.boss&&(e.staggerTime||0)>0)&&!(e.type==='brute'&&(e.windup||0)>0)){e.hitCd=e.boss?.72:e.type==='skirmisher'?.75:.9;hurtPlayer(e.damage,e)}
}
function createWorldHazard(x,y,type){const r=type==='frost'?42:39;hazards.push({x:clamp(x,45,W-45),y:clamp(y,45,H-45),r,warning:type==='frost'?1.05:.88,active:.48,damage:type==='frost'?21:15,type,hit:false,released:false})}
function spawnWorldEvent(){const wi=activeWorldIndex();if(wi===1){announce('GLOAMWOOD · BRAMBLE BLOOM');for(let i=0;i<3;i++)createWorldHazard(player.x+rand(-128,128),player.y+rand(-105,105),'root');worldEventTimer=10.8}else if(wi===2){announce('FROSTVEIN · FROSTFALL');for(let i=0;i<3;i++)createWorldHazard(player.x+rand(-155,155),player.y+rand(-120,120),'frost');worldEventTimer=9.2}}
function updateWorldHazards(dt){for(const h of hazards){if(h.warning>0&&player.dashing>0&&!player.dashResonanceAwarded&&dist(player,h)<h.r+player.r+32)gainResonance();if(h.warning>0){h.warning-=dt;if(h.warning<=0&&!h.released){h.released=true;spawnParticles(h.x,h.y,hazardColor(h.type),14,.75);rings.push({x:h.x,y:h.y,r:5,max:h.r*1.55,life:.35,color:hazardColor(h.type)})}}else{h.active-=dt;if(!h.hit&&dist(player,h)<h.r+player.r){hurtPlayer(h.damage,h);h.hit=true;if(h.type==='frost')player.slowUntil=elapsed+1.45;spawnParticles(h.x,h.y,hazardColor(h.type),10,.8)}}}hazards=hazards.filter(h=>h.warning>0||h.active>0)}
function drawHazard(h){const warning=h.warning>0,col=hazardColor(h.type);ctx.save();ctx.globalAlpha=warning?.78:.42;ctx.strokeStyle=col;ctx.fillStyle=col;ctx.shadowColor=col;ctx.shadowBlur=(warning?12:22)*renderProfile.glow;ctx.lineWidth=warning?2:1.5;ctx.setLineDash(warning?[7,5]:[]);ctx.beginPath();ctx.arc(h.x,h.y,h.r*(warning?1+.045*Math.sin(elapsed*16):1),0,TAU);ctx.stroke();ctx.setLineDash([]);ctx.globalAlpha=warning?.10:.16;ctx.beginPath();ctx.arc(h.x,h.y,h.r,0,TAU);ctx.fill();ctx.globalAlpha=warning?.85:.75;if(h.type==='frost'){for(let i=0;i<4;i++){const a=i*Math.PI/2+Math.PI/4;ctx.beginPath();ctx.moveTo(h.x+Math.cos(a)*h.r*.24,h.y+Math.sin(a)*h.r*.24);ctx.lineTo(h.x+Math.cos(a)*h.r*.8,h.y+Math.sin(a)*h.r*.8);ctx.stroke()}ctx.font='bold 9px system-ui';ctx.textAlign='center';ctx.fillText(tr(warning?'DODGE':'FROST'),h.x,h.y+3)}else{for(let i=0;i<8;i++){const a=i*TAU/8+elapsed*.15;ctx.beginPath();ctx.moveTo(h.x+Math.cos(a)*h.r*.62,h.y+Math.sin(a)*h.r*.62);ctx.lineTo(h.x+Math.cos(a)*h.r*.92,h.y+Math.sin(a)*h.r*.92);ctx.stroke()}ctx.font='bold 9px system-ui';ctx.textAlign='center';const hazardLabel=h.type==='ember'?(warning?'CINDER':'BURN'):h.type==='umbra'?(warning?'WEB':'DUSK'):h.type==='void'?(warning?'RIFT':'VOID'):(warning?'ROOT WARNING':'BRAMBLE');ctx.fillText(tr(hazardLabel),h.x,h.y+3)}ctx.restore()}
function update(dt){
 if(!Number.isFinite(dt)||dt<0)dt=0;dt=Math.min(dt,.05);
 if(player&&mode==='playing'&&player.comboTimer>0){player.comboTimer-=dt;if(player.comboTimer<=0){player.combo=0;updateComboHud()}}
 if(shakeTime>0)shakeTime=Math.max(0,shakeTime-dt);if(shakeTime<=0)shakePower=0;
 if(mode!=='playing')return;
 elapsed+=dt;waveElapsed+=dt;
 player.attackCd=Math.max(0,player.attackCd-dt);player.dashCd=Math.max(0,player.dashCd-dt);
 player.specialCd=Math.max(0,player.specialCd-dt);player.invuln=Math.max(0,player.invuln-dt);const dashActiveThisFrame=dashFrameActive(player.dashing);player.dashing=Math.max(0,player.dashing-dt);
 let vx=(keys.d||keys.arrowright?1:0)-(keys.a||keys.arrowleft?1:0)+joystick.x;
 let vy=(keys.s||keys.arrowdown?1:0)-(keys.w||keys.arrowup?1:0)+joystick.y,len=Math.hypot(vx,vy);
 if(len>1){vx/=len;vy/=len}const inputMagnitude=Math.hypot(vx,vy);if(inputMagnitude>.1)player.face=Math.atan2(vy,vx);const movementSpeed=elapsed<player.slowUntil?player.speed*.64:player.speed;const previousX=player.x,previousY=player.y;
 player.attackAnim=Math.max(0,(player.attackAnim||0)-dt);player.weaponRecoil=(player.weaponRecoil||0)*Math.pow(.025,dt);player.hurtFlash=Math.max(0,(player.hurtFlash||0)-dt);
 if(dashActiveThisFrame){player.vx=player.dashX*movementSpeed*3.3;player.vy=player.dashY*movementSpeed*3.3;player.stepDistance=0}
 else{const targetVX=vx*movementSpeed,targetVY=vy*movementSpeed;const response=1-Math.exp(-dt*(inputMagnitude>.08?13:10));player.vx+=(targetVX-(player.vx||0))*response;player.vy+=(targetVY-(player.vy||0))*response}
 player.x+=(player.vx||0)*dt;player.y+=(player.vy||0)*dt;
 const speedNow=Math.hypot(player.vx||0,player.vy||0);player.stride=(player.stride||0)+speedNow*dt;player.stepTimer=Math.max(0,(player.stepTimer||0)-dt);if(dashActiveThisFrame){player.dashTrailTimer=(player.dashTrailTimer||0)-dt;if(player.dashTrailTimer<=0){player.dashTrailTimer=.045;addDashEcho();if(settings.particles&&renderProfile.maxParticles>particles.length+2)spawnKineticSparks(player.x-player.dashX*10,player.y-player.dashY*10,(WEAPONS[player.weapon]||WEAPONS.aetherblade).color,2,.35)}}
 if(speedNow>34&&player.dashing<=0){player.stepDistance=(player.stepDistance||0)+speedNow*dt;if(player.stepDistance>31&&player.stepTimer<=0){player.stepDistance=0;player.stepTimer=.19;const wi=activeWorldIndex(),stepColor=wi===2?'#8acfe0':wi===1?'#6d9d7e':'#b7a18a';spawnParticles(player.x-Math.cos(player.face)*7,player.y-Math.sin(player.face)*7,stepColor,3,.22)}}
 if(player.x<30){player.x=30;player.vx=Math.max(0,player.vx)}else if(player.x>W-30){player.x=W-30;player.vx=Math.min(0,player.vx)}if(player.y<30){player.y=30;player.vy=Math.max(0,player.vy)}else if(player.y>H-30){player.y=H-30;player.vy=Math.min(0,player.vy)}
 if(dashActiveThisFrame&&player.dashSerial>0){for(const e of [...enemies]){if(!canDashStrike(e.lastDashSerial,player.dashSerial))continue;const contact=e.r+player.r+5;if(distanceToSegment(e.x,e.y,previousX,previousY,player.x,player.y)<=contact){e.lastDashSerial=player.dashSerial;const dashDamage=player.damage*dashStrikeMultiplier(player.weapon);damageEnemy(e,dashDamage,Math.atan2(player.dashY,player.dashX));player.dashHitCount=(player.dashHitCount||0)+1;const impactColor=(WEAPONS[player.weapon]||WEAPONS.aetherblade).color;spawnKineticSparks(e.x,e.y,impactColor,7,.58);spawnImpactMark(e.x,e.y,impactColor,1.25);if(player.dashHitCount===1){floating(e.x,e.y-e.r-12,tr('RIFT DASH HIT'),'#72f6ff');shakeTime=Math.max(shakeTime,.075);shakePower=Math.max(shakePower,2.1);}}}}
 if(keys.j||keys[' ']||touchAttack)slash();
